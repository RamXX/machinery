    {
      "id": "fv:deal-win",
      "kind": "fv",
      "source": "design/risk.yaml",
      "title": "Formal model of deal-win: winning a deal is final and audited exactly once, even when callers act at the same time"
    },
    {
      "id": "fv:record-ownership",
      "kind": "fv",
      "source": "design/risk.yaml",
      "title": "Formal model of record-ownership: who may write which record must hold for every shape of data"
    },
    {
      "id": "inv:audit-append-only",
      "kind": "inv",
      "source": "design/model/crm.modelith.yaml",
      "title": "An AuditEntry is never updated or deleted."
    },
    {
      "id": "inv:deal-owner-or-admin-writes",
      "kind": "inv",
      "source": "design/model/crm.modelith.yaml",
      "title": "Only the Owner of a Deal or an Admin changes it."
    },
    {
      "id": "inv:deal-reopen-admin-only",
      "kind": "inv",
      "source": "design/model/crm.modelith.yaml",
      "title": "Only an Admin reopens a lost Deal."
    },
    {
      "id": "inv:deal-won-is-final",
      "kind": "inv",
      "source": "design/model/crm.modelith.yaml",
      "title": "A won Deal never changes stage again."
    },
    {
      "id": "inv:deal-won-needs-amount",
      "kind": "inv",
      "source": "design/model/crm.modelith.yaml",
      "title": "A Deal is won only when its amount is greater than zero."
    },
    {
      "id": "inv:every-change-audited",
      "kind": "inv",
      "source": "design/model/crm.modelith.yaml",
      "title": "Every stage change of a Deal and every status change of a Task writes exactly one AuditEntry in the same transaction."
    },
    {
      "id": "inv:lifecycle-single-writer",
      "kind": "inv",
      "source": "design/model/crm.modelith.yaml",
      "title": "The stage of a Deal and the status of a Task change only along a transition of their machine, and only through the service's transition path."
    },
    {
      "id": "inv:refusals-are-audited",
      "kind": "inv",
      "source": "design/model/crm.modelith.yaml",
      "title": "Every refused action on a Deal or Task writes one AuditEntry with a refused outcome."
    },
    {
      "id": "inv:task-assignee-or-admin-writes",
