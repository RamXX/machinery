---- MODULE Deal ----
\* Generated by machinery formal gen from design/machines/Deal.machine.json. Do not edit.
\* Properties live in a separate module that EXTENDS this one.
\*
\* Built-in assumptions of the skeleton:
\*   G1  Engine-driven steps (timers, actor results, eventless transitions) are atomic.
\*   G2  Guards are not modeled: any branch of a handler may fire.
\*   G3  A transition whose source is a compound state applies in each of its leaves.
EXTENDS Naturals, FiniteSets

CONSTANTS Instances, Callers, Atomic

VARIABLES st, fx, pend, last

vars == <<st, fx, pend, last>>

States == {"Lead", "Qualified", "closing", "Won", "Lost"}
Effects == {"auditCloseFailure", "auditCloseTimeout", "auditDealDenied", "auditLose", "auditQualify", "auditReopen", "auditWin", "stampWinAttempt"}
Final == {"Won"}
Resting == {"Lead", "Qualified", "Lost"}
InitialState == "Lead"
CallerCases == {"tc:DEAL-4a25db", "tc:DEAL-fdd582", "tc:DEAL-776ffd", "tc:DEAL-fdf795", "tc:DEAL-d09c4d", "tc:DEAL-81d0ab", "tc:DEAL-a627f4", "tc:DEAL-9f48af", "tc:DEAL-fe513e", "tc:DEAL-7bb594"}

Bump(f, E) == [e \in Effects |-> IF e \in E THEN (IF f[e] < 2 THEN f[e] + 1 ELSE 2) ELSE f[e]]
StepOf(id, i, c, s) == [id |-> id, i |-> i, c |-> c, step |-> s]
Pending(c, i, id) == [c |-> c, i |-> i, id |-> id]
InFlight(c) == \E p \in pend : p.c = c

TypeOK ==
    /\ st \in [Instances -> States]
    /\ fx \in [Instances -> [Effects -> 0..2]]
    /\ pend \subseteq [c : Callers, i : Instances, id : CallerCases]

Init ==
    /\ st = [i \in Instances |-> InitialState]
    /\ fx = [i \in Instances |-> [e \in Effects |-> 0]]
    /\ pend = {}
    /\ last = StepOf("init", "none", "none", "init")

\* tc:DEAL-4a25db  Lead on:qualify [canWriteDeal] -> Qualified
Apply_DEAL_4a25db(i) ==
    /\ st' = [st EXCEPT ![i] = "Qualified"]
    /\ fx' = [fx EXCEPT ![i] = Bump(@, {"auditQualify"})]
Do_DEAL_4a25db(i, c) ==
    /\ Atomic
    /\ st[i] \in {"Lead"}
    /\ Apply_DEAL_4a25db(i)
    /\ UNCHANGED pend
    /\ last' = StepOf("tc:DEAL-4a25db", i, c, "do")
Begin_DEAL_4a25db(i, c) ==
    /\ ~Atomic
    /\ st[i] \in {"Lead"}
    /\ ~InFlight(c)
    /\ pend' = pend \cup {Pending(c, i, "tc:DEAL-4a25db")}
    /\ UNCHANGED <<st, fx>>
    /\ last' = StepOf("tc:DEAL-4a25db", i, c, "begin")
Commit_DEAL_4a25db(i, c) ==
    /\ Pending(c, i, "tc:DEAL-4a25db") \in pend
    /\ Apply_DEAL_4a25db(i)
    /\ pend' = pend \ {Pending(c, i, "tc:DEAL-4a25db")}
    /\ last' = StepOf("tc:DEAL-4a25db", i, c, "commit")

