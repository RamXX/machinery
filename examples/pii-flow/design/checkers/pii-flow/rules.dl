// pii-flow: a sink leaks when sensitive data reaches it without redaction.
//
// Evaluated by Souffle 2.5 inside the digest-pinned checker image. adapter.py
// writes the five input relations as .facts files and reads the two output
// relations back; it computes nothing itself. Symbols are the projection's
// stable ids (entity:X, attr:X.a), so an output tuple names a design element
// directly.
//
// Taint does not propagate INTO a redacted node, so everything downstream of a
// redactor is clean. The negation is stratified: redacted is an input, never
// derived.

.decl attr_of(e:symbol, a:symbol)   // entity e declares attribute a
.decl flows(x:symbol, y:symbol)     // a model relationship x -> y
.decl sensitive(a:symbol)           // manifest config.sensitive
.decl sink(e:symbol)                // manifest config.sinks
.decl redacted(e:symbol)            // manifest config.redacted
.input attr_of
.input flows
.input sensitive
.input sink
.input redacted

.decl holds_sensitive(e:symbol)
holds_sensitive(E) :- attr_of(E, A), sensitive(A).

.decl tainted(e:symbol)
.output tainted
tainted(E) :- holds_sensitive(E).
tainted(F) :- tainted(E), flows(E, F), !redacted(F).

.decl leak(e:symbol)
.output leak
leak(E) :- tainted(E), sink(E).
