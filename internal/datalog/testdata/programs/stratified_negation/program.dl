// "X exists and no owner Y for X", plus a second stratum over the first.
.decl entity(x:symbol)
.input entity
.decl owner(x:symbol, y:symbol)
.input owner
.decl owned(x:symbol)
owned(X) :- owner(X, _).
.decl finding_unowned(x:symbol)
.output finding_unowned
finding_unowned(X) :- entity(X), !owned(X).
.decl finding_orphan_owner(x:symbol, y:symbol)
.output finding_orphan_owner
finding_orphan_owner(X, Y) :- owner(X, Y), !entity(X).
.decl all_clear(x:symbol)
.output all_clear
all_clear(X) :- entity(X), !finding_unowned(X).
