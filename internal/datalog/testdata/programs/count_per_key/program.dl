// count per key, including empty groups (count 0), a two-atom body, a
// negation inside the body, and a count with no grouping variable.
.decl key(k:symbol)
.input key
.decl r(k:symbol, v:symbol)
.input r
.decl s(v:symbol)
.input s
.decl per_key(k:symbol, n:number)
.output per_key
per_key(K, N) :- key(K), N = count : { r(K, _) }.
.decl joined(k:symbol, n:number)
.output joined
joined(K, N) :- key(K), N = count : { r(K, V), s(V) }.
.decl unjoined(k:symbol, n:number)
.output unjoined
unjoined(K, N) :- key(K), N = count : { r(K, V), !s(V) }.
.decl total(n:number)
.output total
total(N) :- N = count : { r(_, _) }.
.decl same(k:symbol, j:symbol)
.output same
same(K, J) :- per_key(K, N), per_key(J, N), K != J.
