// The payload-twin shape: two statements of an event payload must agree,
// checked in both directions.
.decl unit_payload(u:symbol, e:symbol, f:symbol)
.input unit_payload
.decl event_payload_field(e:symbol, f:symbol)
.input event_payload_field
.decl finding_payload_twin(u:symbol, e:symbol, f:symbol)
.output finding_payload_twin
finding_payload_twin(U, E, F) :- unit_payload(U, E, F), !event_payload_field(E, F).
finding_payload_twin(U, E, F) :- unit_payload(U, E, _), event_payload_field(E, F), !unit_payload(U, E, F).
