// Rules appear in the reverse of their dependency order; results must not
// depend on it.
.decl finding_late(x:symbol)
.output finding_late
finding_late(X) :- mid(X), !excluded(X).
.decl excluded(x:symbol)
excluded(X) :- base(X), bad(X).
.decl mid(x:symbol)
mid(X) :- reach(X).
.decl reach(x:symbol)
reach(Y) :- reach(X), link(X, Y).
reach(X) :- base(X).
.decl link(a:symbol, b:symbol)
.input link
.decl base(x:symbol)
.input base
.decl bad(x:symbol)
.input bad
