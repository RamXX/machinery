// min over number attributes (Souffle rejects min over symbols). The group
// of key "z" is empty, so min yields no tuple for it.
.decl key(k:symbol)
.input key
.decl r(k:symbol, v:symbol, w:symbol)
.input r
.decl c(k:symbol, v:symbol, n:number)
c(K, V, N) :- r(K, V, _), N = count : { r(K, V, _) }.
.decl least(k:symbol, n:number)
.output least
least(K, M) :- key(K), M = min X : { c(K, _, X) }.
.decl least_but_skip(k:symbol, n:number)
.output least_but_skip
least_but_skip(K, M) :- key(K), M = min X : { c(K, V, X), V != "skip" }.
.decl smallest(n:number)
.output smallest
smallest(M) :- M = min X : { c(_, _, X) }.
.decl at_least(k:symbol, v:symbol)
.output at_least
at_least(K, V) :- c(K, V, N), least(K, N).
