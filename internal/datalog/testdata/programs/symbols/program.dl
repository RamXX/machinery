// Symbols with spaces, quotes, backslash sequences, empty fields, non-ASCII
// text and a long value, plus constants with spaces in the program. A tab is
// always a column separator in a fact file; the two-character sequence
// backslash-t is two ordinary characters in both engines.
.decl name(id:symbol, label:symbol)
.input name
.decl copy(id:symbol, label:symbol)
.output copy
copy(I, L) :- name(I, L).
.decl spaced(id:symbol)
.output spaced
spaced(I) :- name(I, "two words").
.decl tagged(id:symbol, tag:symbol)
.output tagged
tagged(I, "has a tag") :- name(I, _), I != "".
// Constants that a C preprocessor might misread outside a string.
.decl literal(id:symbol, text:symbol)
.output literal
literal(I, "// not a comment") :- name(I, "value").
literal(I, "/* nor this */") :- name(I, "value").
literal(I, "it's #1 ??= ok") :- name(I, "value").
literal(I, "  padded  ") :- name(I, "value").
