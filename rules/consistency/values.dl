// Closed vocabularies (proposal section 4, rule C; NEXT.md entry 36).
//
// A VALUES group whose name equals a Modelith enum's name must spell exactly
// that enum's members, in both directions: a member the enum lacks, and an
// enum member the group omits, are each one finding. The group name is the
// explicit VALUES name{...} or, for VALUES{...}, the unit name. Names are
// compared exactly, with no case folding: VALUES{...} on unit orderState binds
// no enum OrderState (Gl-ledger warns on that near miss and asks for
// VALUES OrderState{...}). An enum no attribute uses is not projected and so
// binds no group.

.decl enum_member(id:symbol, enum:symbol, value:symbol)
.input enum_member
.decl unit_values(unit:symbol, group:symbol, member:symbol)
.input unit_values

.decl enum_value(enum:symbol, value:symbol)
enum_value(G, V) :- enum_member(_, G, V).

.decl enum_exists(enum:symbol)
enum_exists(G) :- enum_value(G, _).

.decl unit_group(unit:symbol, group:symbol)
unit_group(U, G) :- unit_values(U, G, _).

.decl finding_values_disagree(unit:symbol, group:symbol, member:symbol)
.output finding_values_disagree
finding_values_disagree(U, G, V) :- unit_values(U, G, V), enum_exists(G), !enum_value(G, V).
finding_values_disagree(U, G, V) :- unit_group(U, G), enum_value(G, V), !unit_values(U, G, V).
