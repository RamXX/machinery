// Effect carriers (proposal section 4, rule E; NEXT.md entry 20).
//
// finding_effect_uncarried: a unit whose effect names no CARRIES{}. An action
// unit owes a carrier when it declares a non-empty WRITES{}; an actor unit
// owes one unless it is declared read-only by WRITES{} (an actor's effect is
// its invocation, so it owes a carrier whether or not it lists WRITES). A
// WRITES{} (declared read-only) action writes nothing and owes no carrier.
//
// finding_carrier_misplaced: a CARRIES{} group on a unit that is neither an
// action nor an actor (a guard, an invariant, ...). Carriers belong to the
// units that have effects.

.decl unit(id:symbol, machine:symbol, name:symbol, kind:symbol)
.input unit
.decl unit_writes(unit:symbol, fact:symbol)
.input unit_writes
.decl unit_carries(unit:symbol, kind:symbol, target:symbol)
.input unit_carries
.decl unit_declares(unit:symbol, group:symbol)
.input unit_declares

.decl carried(unit:symbol)
carried(U) :- unit_carries(U, _, _).

.decl writes_something(unit:symbol)
writes_something(U) :- unit_writes(U, _).

.decl declared_read_only(unit:symbol)
declared_read_only(U) :- unit_declares(U, "WRITES"), !writes_something(U).

.decl finding_effect_uncarried(unit:symbol)
.output finding_effect_uncarried
finding_effect_uncarried(U) :- unit(U, _, _, "action"), writes_something(U), !carried(U).
finding_effect_uncarried(U) :- unit(U, _, _, "actor"), !carried(U), !declared_read_only(U).

.decl finding_carrier_misplaced(unit:symbol, kind:symbol)
.output finding_carrier_misplaced
finding_carrier_misplaced(U, K) :- carried(U), unit(U, _, _, K), K != "action", K != "actor".
