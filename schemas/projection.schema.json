{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RamXX/machinery/schemas/projection.schema.json",
  "title": "Machinery design projection (machinery -> checker)",
  "description": "The exact v1.0 projection contract implemented by machinery. Only model, invariants, and relationships are supported. The generated object and machinery_version are excluded from the evidence input hash; all other fields bind the verdict.",
  "type": "object",
  "required": ["projection_schema", "machinery_version", "design_id", "checker_id", "manifest_hash", "include", "model"],
  "additionalProperties": false,
  "properties": {
    "projection_schema": { "const": "1.0" },
    "machinery_version": { "type": "string", "minLength": 1 },
    "design_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "checker_id": { "type": "string", "minLength": 1 },
    "manifest_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "include": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["model", "invariants", "relationships"] }
    },
    "model": {
      "type": "object",
      "required": ["entities"],
      "additionalProperties": false,
      "properties": {
        "entities": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
        "invariants": { "type": "array", "items": { "$ref": "#/$defs/invariant" } },
        "relationships": { "type": "array", "items": { "$ref": "#/$defs/relationship" } }
      }
    },
    "generated": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "stableId": { "type": "string", "minLength": 1 },
    "entity": {
      "type": "object",
      "required": ["stable_id", "name"],
      "additionalProperties": false,
      "properties": {
        "stable_id": { "$ref": "#/$defs/stableId" },
        "name": { "type": "string", "minLength": 1 },
        "status_enum": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "attributes": { "type": "array", "items": { "$ref": "#/$defs/attribute" } }
      }
    },
    "attribute": {
      "type": "object",
      "required": ["stable_id", "name", "type"],
      "additionalProperties": false,
      "properties": {
        "stable_id": { "$ref": "#/$defs/stableId" },
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 }
      }
    },
    "invariant": {
      "type": "object",
      "required": ["stable_id", "id", "text", "owner"],
      "additionalProperties": false,
      "properties": {
        "stable_id": { "$ref": "#/$defs/stableId" },
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "owner": {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["entity", "top"] },
            "entity": { "$ref": "#/$defs/stableId" }
          }
        }
      }
    },
    "relationship": {
      "type": "object",
      "required": ["stable_id", "from", "to", "cardinality"],
      "additionalProperties": false,
      "properties": {
        "stable_id": { "$ref": "#/$defs/stableId" },
        "from": { "$ref": "#/$defs/stableId" },
        "to": { "$ref": "#/$defs/stableId" },
        "cardinality": { "enum": ["1:1", "1:n", "n:1", "n:m"] },
        "name": { "type": "string" }
      }
    }
  }
}
