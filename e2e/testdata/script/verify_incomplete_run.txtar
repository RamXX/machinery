# a run machinery run did not finish is an incomplete run; a non-zero exit is a warning (sections 10.2, 12)
fixture shop
exec machinery gen
gitinit

# machinery run is killed before the command ends: an ERROR, and the receipts are not used
! exec machinery run -- sh -c 'cat fail.jsonl >> "$MACHINERY_RECEIPTS"; kill -9 $PPID'
exec sh -c 'grep -c "\"type\":\"end\"" .machinery/receipts/*.jsonl || true'
stdout '^0$'
exec mrun 1 verify
stdout '^  ERROR  incomplete run: \.machinery/receipts/[0-9]{8}T[0-9]{6}\.[0-9]{3}Z-[0-9a-f]{7}\.jsonl$'
! stdout 'checked:'
! stdout 'failed: tc:ORDE-2e883d'
stdout '^failed: 1 finding\(s\)$'

# a complete run beside it is used; the incomplete one still blocks
exec machinery run -- sh e2e/orders.sh
exec mrun 1 verify
stdout '^checked: 16 obligations, 14 proven, 1 partial, 2 owed, 15 receipts$'
stdout 'ERROR  incomplete run: \.machinery/receipts/[^ ]+\.jsonl'
! stdout 'ERROR  failed:'
stdout '^failed: 1 finding\(s\)$'

# an end line typed under the unfinished run does not finish it: the file changed after the run
rm .machinery/receipts
! exec machinery run -- sh -c 'sh e2e/orders.sh; kill -9 $PPID'
exec sh -c 'printf "{\"v\":1,\"type\":\"end\",\"exit\":0,\"finished\":\"2026-01-02T03:04:09Z\"}\n" >> "$(ls .machinery/receipts/*.jsonl)"'
exec mrun 1 verify
stdout '^  ERROR  receipts: \.machinery/receipts/[^ ]+\.jsonl: changed after the run; delete the file and run the tests again through machinery run$'
! stdout 'checked:'
stdout '^failed: 1 finding\(s\)$'

# a file typed by hand without an end line was not produced by machinery run
rm .machinery/receipts
mkdir .machinery/receipts
exec sh -c 'printf "{\"v\":1,\"type\":\"run\",\"commit\":\"%s\",\"dirty\":false,\"command\":[\"sh\"],\"stack\":\"\",\"started\":\"2026-01-02T03:04:05Z\"}\n" "$(git rev-parse HEAD)" > .machinery/receipts/20260102T030405.000Z-cut.jsonl'
exec mrun 1 verify
stdout '^  ERROR  receipts: \.machinery/receipts/20260102T030405\.000Z-cut\.jsonl: not produced by machinery run; delete the file and run the tests through machinery run$'
! stdout 'incomplete run'
stdout '^failed: 1 finding\(s\)$'

# a run that exits non-zero is complete: a warning, and its receipts count
rm .machinery/receipts
exec mrun 3 run -- sh -c 'sh e2e/orders.sh; exit 3'
exec machinery verify
stdout '^  warn   run exited 3: \.machinery/receipts/[0-9]{8}T[0-9]{6}\.[0-9]{3}Z-[0-9a-f]{7}\.jsonl$'
stdout '^checked: 16 obligations, 14 proven, 1 partial, 2 owed, 15 receipts$'
stdout '^passed$'

-- fail.jsonl --
{"v":1,"type":"receipt","id":"tc:ORDE-2e883d","outcome":"fail","test":"TestPay","observed":"stayed Pending"}
