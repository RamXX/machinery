# a machine with _guards yields one clause case per clause of each guarded transition
fixture shop
cp guarded.json design/machines/Order.machine.json
exec machinery gen
stdout 'gen: wrote 4 file\(s\)'

# the obligations: title form of docs/formats.md section 7.2, no effects
grep '"id": "tc:ORDE-1457d2"' design/gen/obligations.json
grep '"title": "Pending on:pay \[hasPaymentMethod!cardOnFile\] -> \(branch does not fire\)"' design/gen/obligations.json
grep '"id": "tc:ORDE-e85f15"' design/gen/obligations.json
grep '"title": "Pending on:pay \[hasPaymentMethod!cardNotExpired\] -> \(branch does not fire\)"' design/gen/obligations.json
grep -count=18 '"kind": "'  design/gen/obligations.json

# the transition case keeps its id and title
grep '"id": "tc:ORDE-2e883d"' design/gen/obligations.json
grep '"title": "Pending on:pay \[hasPaymentMethod\] -> paying"' design/gen/obligations.json

# the runtime table lists the clauses, linked to their transition
grep '"transition": "tc:ORDE-2e883d"' design/gen/tables/order.table.json
grep '"guard": "hasPaymentMethod"' design/gen/tables/order.table.json
grep '"clause": "cardOnFile"' design/gen/tables/order.table.json
grep '"clause": "cardNotExpired"' design/gen/tables/order.table.json
grep '## Guard clauses' design/gen/tables/order.table.md
grep 'tc:ORDE-1457d2 \| tc:ORDE-2e883d \| hasPaymentMethod \| cardOnFile' design/gen/tables/order.table.md

# generation is stable and drift-free
exec machinery gen --check
stdout '^passed$'

# without _guards there are no clause cases
cp $WORK/plain.json design/machines/Order.machine.json
exec machinery gen
! grep 'branch does not fire' design/gen/obligations.json
grep '"clauses": \[\]' design/gen/tables/order.table.json

-- guarded.json --
{
  "_comment": "Order lifecycle. Domain states mirror the OrderStatus enum; `paying` is the transient overlay around the payment call.",
  "_delays": {
    "payTimeout": "5000 ms - upper bound on the payment provider call"
  },
  "id": "order",
  "initial": "Pending",
  "context": {
    "orderId": null,
    "lastError": null
  },
  "states": {
    "Pending": {
      "on": {
        "pay": [
          {
            "target": "paying",
            "guard": "hasPaymentMethod",
            "actions": "stampAttempt"
          },
          {
            "actions": "recordPayRefused"
          }
        ],
        "cancel": {
          "target": "Cancelled",
          "actions": "recordCancellation"
        }
      },
      "_ignores": {
        "ship": "an unpaid order cannot ship; the API refuses with ORDER_NOT_PAID"
      }
    },
    "paying": {
      "invoke": {
        "src": "chargePayment",
        "onDone": {
          "target": "Paid",
          "actions": "recordCharge"
        },
        "onError": {
          "target": "Pending",
          "actions": "recordPaymentFailure"
        }
      },
      "after": {
        "payTimeout": {
          "target": "Pending",
          "actions": "recordPaymentTimeout"
        }
      }
    },
    "Paid": {
      "on": {
        "ship": {
          "target": "Shipped",
          "actions": "recordShipment"
        },
        "cancel": {
          "target": "Cancelled",
          "actions": [
            "refundPayment",
            "recordCancellation"
          ]
        }
      },
      "_ignores": {
        "pay": "already paid; a repeated pay is refused with ORDER_ALREADY_PAID"
      }
    },
    "Shipped": {
      "type": "final",
      "entry": "notifyCustomer"
    },
    "Cancelled": {
      "type": "final"
    }
  },
  "_guards": {
    "hasPaymentMethod": [
      "cardOnFile",
      "cardNotExpired"
    ]
  }
}
-- plain.json --
