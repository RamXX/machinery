-- narrow-rewritten.yaml --
version: 2
design:
  models:
    - design/model/shop.modelith.yaml
  machines: design/machines
  failure_modes: design/failure-modes.yaml
contracts:
  - kind: openapi
    path: contracts/openapi.yaml
trace:
  code: ["internal/**/*.go"]
  tests: ["e2e/**"]
evidence:
  adapter:
    allow: [inv, inv]
    tiers: [routine]
    min_granularity: {inv: function, sc: file}
constraints:
