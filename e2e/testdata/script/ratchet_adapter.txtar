# ratchet: a policy that lets adapter evidence prove more than at the base is named, and one that
# lets it prove ids of a critical or vital area it could not prove before is an error. Policies
# are compared by what they admit, not by how they are written (sections 10.3 and 11.3)
fixture shop
exec machinery gen
gitinit
exec git tag defaults

# the defaults written out, and a narrower policy: nothing to report
cp explicit.yaml machinery.yaml
exec machinery check --stage ratchet --base defaults
! stdout 'adapter widened'
stdout '^passed$'
cp narrow.yaml machinery.yaml
exec machinery check --stage ratchet --base defaults
! stdout 'adapter widened'
stdout '^passed$'
gitcommit 'a narrow adapter policy'
exec git tag narrow

# the verifier's case: the same policy written another way raises nothing. allow lists only inv,
# so {default: function, fm: function} asks what function asks, and so does {inv: function}
cp narrow-scalar.yaml machinery.yaml
exec machinery check --stage ratchet --base narrow
! stdout 'adapter widened'
stdout '^passed$'
cp narrow-rewritten.yaml machinery.yaml
exec machinery check --stage ratchet --base narrow
! stdout 'adapter widened'
stdout '^passed$'

# every widening against the narrow base is a warn that names the ids it admits
cp wide.yaml machinery.yaml
exec machinery check --stage ratchet --base narrow
stdout '^  warn   ratchet: adapter widened: routine sc ids: never -> file$'
stdout '^  warn   ratchet: adapter widened: routine inv ids: function -> file$'
stdout '^  warn   ratchet: adapter widened: consequential inv, sc ids: never -> file$'
stdout '^  warn   ratchet: adapter widened: evidence\.adapter\.sources: example\.test/shop/staged/\*\* <- e2e/suite/\*_test\.go added$'
stdout -count=4 'adapter widened'
stdout '^passed$'
# the same policy against the defaults widens nothing but the map
exec machinery check --stage ratchet --base defaults
stdout -count=1 'adapter widened'
stdout 'evidence\.adapter\.sources: .* added$'
# the entry of the map written twice and allow reordered: the same pairs, the same kinds
gitcommit 'a wide policy'
cp wide-split.yaml machinery.yaml
exec machinery check --stage ratchet --base HEAD
! stdout 'adapter widened'

# critical or vital ids admitted is an error, one per tier
cp critical.yaml machinery.yaml
exec mrun 1 check --stage ratchet --base defaults
stdout '^  ERROR  ratchet: adapter widened: critical inv, sc, fm, ck ids: never -> file; an id of a critical or vital area needs a receipt its test emits after its own assertions$'
stdout '^  ERROR  ratchet: adapter widened: vital inv, sc, fm, ck ids: never -> file; an id of a critical or vital area needs a receipt its test emits after its own assertions$'
stdout '^failed: 2 finding\(s\)$'
# a base that already admitted them established it: nothing new
gitcommit 'critical and vital by adapter'
exec machinery check --stage ratchet --base HEAD
! stdout 'adapter widened'
-- explicit.yaml --
version: 2
design:
  models:
    - design/model/shop.modelith.yaml
  machines: design/machines
  failure_modes: design/failure-modes.yaml
contracts:
  - kind: openapi
    path: contracts/openapi.yaml
trace:
  code: ["internal/**/*.go"]
  tests: ["e2e/**"]
evidence:
  adapter:
    allow: [inv, sc, fm, ck]
    tiers: [routine, consequential]
    min_granularity: file
constraints:
  layers:
    - {name: domain, paths: ["internal/domain/**"]}
    - {name: api, paths: ["internal/api/**"]}
  size:
    max_file_lines: 200
    max_func_lines: 40
waivers:
  - {rule: action-event, id: "act:Order.place", reason: "creation enters the initial state Pending"}
-- narrow.yaml --
version: 2
design:
  models:
    - design/model/shop.modelith.yaml
  machines: design/machines
  failure_modes: design/failure-modes.yaml
contracts:
  - kind: openapi
    path: contracts/openapi.yaml
trace:
  code: ["internal/**/*.go"]
  tests: ["e2e/**"]
evidence:
  adapter:
    allow: [inv]
    tiers: [routine]
    min_granularity: {default: function, fm: function}
constraints:
  layers:
    - {name: domain, paths: ["internal/domain/**"]}
    - {name: api, paths: ["internal/api/**"]}
  size:
    max_file_lines: 200
    max_func_lines: 40
waivers:
  - {rule: action-event, id: "act:Order.place", reason: "creation enters the initial state Pending"}
