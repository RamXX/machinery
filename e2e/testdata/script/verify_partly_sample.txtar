# verify names, without --partly, up to three claimants without a pass for each of the first ten
# partly run ids, and then how many more there are, after them; --partly names every one
# (section 12)
fixture shop
fixture shop-gotests
cp shop.modelith.yaml design/model/shop.modelith.yaml
exec machinery gen
gitinit

# eleven ids with one claimant that runs and four that do not
exec machinery run --adapter go-test-json -- go test -count=1 ./e2e/wide
stderr '^machinery run: adapter: partly run: 11 id\(s\): 11 of 55 claimants passed in this run$'
exec mrun 1 verify
stdout -count=11 '^  ERROR  partly run: inv:rule-[0-9]+: 1 of 5 claimants passed: '
stdout -count=30 '^  warn   partly run: inv:rule-[0-9]+: no verdict: '
stdout -count=3 '^  warn   partly run: inv:rule-01: no verdict: '
stdout '^  warn   partly run: inv:rule-01: no verdict: e2e/many/many_test\.go::TestR01a$'
stdout '^  warn   partly run: inv:rule-01: no verdict: e2e/many/many_test\.go::TestR01c$'
! stdout 'TestR01d'
stdout -count=3 '^  warn   partly run: inv:rule-10: no verdict: '
! stdout 'no verdict: [^\n]*TestR11'
# the count of the others prints after the lines it follows, and nothing of them after it
stdout '^  warn   partly run: 14 more claimant\(s\) without a pass: machinery verify --partly lists every one$'
stdout 'no verdict: e2e/many/many_test\.go::TestR10c\n  warn   partly run: 14 more claimant'
! stdout 'more claimant[^\n]*\n  warn   partly run: '

exec mrun 1 verify --partly
stdout -count=44 '^  warn   partly run: inv:rule-[0-9]+: no verdict: '
stdout '^  warn   partly run: inv:rule-11: no verdict: e2e/many/many_test\.go::TestR11d$'
! stdout 'more claimant'

-- shop.modelith.yaml --
kind: DomainModel
version: v1
title: Shop
description: >
  A minimal order desk used as the shared test fixture. A Customer places an
  Order, pays for it, and a Clerk ships it. An Order can be cancelled until it
  ships.

glossary:
  Clerk: "A staff member who ships a paid `Order`."

enums:
  OrderStatus:
    values:
      - {name: Pending, definition: "Placed, not yet paid."}
      - {name: Paid, definition: "Payment captured."}
      - {name: Shipped, definition: "Handed to the carrier; terminal."}
      - {name: Cancelled, definition: "Abandoned before shipping; terminal."}

entities:
  Customer:
    definition: >
      A person who places and pays for an `Order`.
    attributes:
      - {name: email, type: string}
    relationships:
      - {entity: Order, cardinality: "1:n", ownership: owned}
    invariants:
      - {id: customer-email-unique, statement: "No two `Customer` records share an email."}
  Order:
    definition: >
      A request by one `Customer` to buy goods. Its status follows the order
      lifecycle from pending to shipped or cancelled.
    attributes:
      - {name: status, type: OrderStatus}
      - {name: totalCents, type: integer}
    relationships:
      - {entity: Customer, cardinality: "n:1", ownership: referenced}
    actions:
      - {name: place, actor: Customer, description: "Create the `Order` in the pending status."}
      - {name: pay, actor: Customer, preserves: [paid-before-shipped]}
      - {name: ship, actor: Clerk, preserves: [paid-before-shipped]}
      - {name: cancel, actor: Customer, preserves: [terminal-is-final]}
    invariants:
      - {id: paid-before-shipped, statement: "An `Order` reaches the shipped status only from the paid status."}

invariants:
  - {id: terminal-is-final, statement: "A shipped or cancelled `Order` never changes status again."}
  - {id: rule-01, statement: "Shop rule 1 holds for every `Order`."}
  - {id: rule-02, statement: "Shop rule 2 holds for every `Order`."}
  - {id: rule-03, statement: "Shop rule 3 holds for every `Order`."}
  - {id: rule-04, statement: "Shop rule 4 holds for every `Order`."}
  - {id: rule-05, statement: "Shop rule 5 holds for every `Order`."}
  - {id: rule-06, statement: "Shop rule 6 holds for every `Order`."}
  - {id: rule-07, statement: "Shop rule 7 holds for every `Order`."}
  - {id: rule-08, statement: "Shop rule 8 holds for every `Order`."}
  - {id: rule-09, statement: "Shop rule 9 holds for every `Order`."}
  - {id: rule-10, statement: "Shop rule 10 holds for every `Order`."}
  - {id: rule-11, statement: "Shop rule 11 holds for every `Order`."}

scenarios:
  - name: Customer pays and the order ships
    actors: [Customer, Clerk]
    steps:
      - "Customer places an `Order`; it is pending."
      - "Customer pays; the `Order` becomes paid."
      - "Clerk ships; the `Order` becomes shipped."
    invariants_touched: [paid-before-shipped]
  - name: Cancelled order refuses payment
    actors: [Customer]
    steps:
      - "Customer places an `Order` and cancels it."
      - "Customer tries to pay; the request is refused and the `Order` stays cancelled."
    invariants_touched: [terminal-is-final]
-- e2e/wide/wide_test.go --
