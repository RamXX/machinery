# adapter evidence proves an id only when every claimant of it under trace.tests has a pass at
# the commit. A claimant without one leaves the id partly run: not proven and not failed
# (sections 10.3, 11.2, 12, 13, 14 and 15.6)
fixture shop
fixture shop-gotests
cp all.yaml machinery.yaml
exec machinery gen
gitinit
exec bd init --stealth --non-interactive -p shop
exec bd create --id shop-c1 --title 'Prove paid before shipped' --body-file c1.txt --silent

# the suite runs, the second package does not: two ids have a claimant without a verdict
exec machinery run --adapter go-test-json -- go test -count=1 ./e2e/suite
stderr '^machinery run: adapter: receipts written: 5 pass, 0 fail, 0 skip$'
stderr '^machinery run: adapter: partly run: 2 id\(s\): 2 of 4 claimants passed in this run$'

exec mrun 1 verify
stdout '^checked: 16 obligations, 3 proven, 2 by adapter at function granularity, 1 by adapter at file granularity, 0 partial, 2 partly run, 2 owed, 5 receipts$'
stdout '^  ERROR  partly run: inv:paid-before-shipped: 1 of 2 claimants passed: run the claimants without a pass at this commit, or excuse those that cannot run here in evidence\.adapter\.excused$'
stdout '^  ERROR  partly run: sc:customer-pays-and-the-order-ships: 1 of 2 claimants passed: run the claimants without a pass at this commit, or excuse those that cannot run here in evidence\.adapter\.excused$'
stdout '^  warn   partly run: inv:paid-before-shipped: no verdict: e2e/extra/extra_test\.go::TestShipAgain$'
stdout '^  warn   partly run: sc:customer-pays-and-the-order-ships: no verdict: e2e/extra/file_test\.go$'
! stdout 'unproven: inv:paid-before-shipped'
! stdout 'unproven: sc:customer-pays-and-the-order-ships'
! stdout 'inv:customer-email-unique'
! stdout 'inv:terminal-is-final'
! stdout 'more claimant'

exec machinery status --no-backlog
stdout '^proven: 3 \(2 by adapter at function granularity, 1 by adapter at file granularity\)  partial: 0  failed: 0  owed: 2  unproven and not owed: 11$'
stdout '^partly run: 2 \(sc 1, inv 1\): 2 of 4 claimants passed$'

exec mrun 1 proof --ids inv:paid-before-shipped
stdout '^  inv:paid-before-shipped -> e2e/suite/order_test\.go::TestShipNeedsPayment -> pass: go test: TestShipNeedsPayment passed$'
stdout '^not proven:\n  inv:paid-before-shipped \(partly run: 1 of 2 claimants passed\)$'
! stdout '^adapter:'

# the story gate treats it as not proven
exec mrun 1 story shop-c1
stdout '^  ERROR  partly run: inv:paid-before-shipped: 1 of 2 claimants passed: run the claimants without a pass at this commit, or excuse those that cannot run here in evidence\.adapter\.excused$'
! stdout 'unproven: inv:paid-before-shipped'
exec mrun 1 verify --story shop-c1
stdout '^  ERROR  partly run: inv:paid-before-shipped: 1 of 2 claimants passed: run the claimants without a pass at this commit, or excuse those that cannot run here in evidence\.adapter\.excused$'
stdout '^  warn   partly run: inv:paid-before-shipped: no verdict: e2e/extra/extra_test\.go::TestShipAgain$'
! stdout 'sc:customer-pays-and-the-order-ships'

# owed sync does not prune a partly run id; owed, it is a warning
cp owed-paid.yaml design/owed.yaml
gitcommit 'paid before shipped is owed'
exec machinery owed sync --prune-only
stdout '^owed: 3 kept, 0 added, 0 removed$'
exec mrun 1 verify
stdout '^  warn   partly run: inv:paid-before-shipped: 1 of 2 claimants passed: run the claimants without a pass at this commit, or excuse those that cannot run here in evidence\.adapter\.excused$'
! stdout 'ERROR  partly run: inv:paid-before-shipped'
exec mrun 1 proof --ids inv:paid-before-shipped
stdout '^  inv:paid-before-shipped \(partly run: 1 of 2 claimants passed, owed\)$'

# the second package runs at the same commit: every claimant passed, the id is proven and pruned
exec machinery run --adapter go-test-json -- go test -count=1 ./e2e/extra
stderr '^machinery run: adapter: receipts written: 2 pass, 0 fail, 0 skip$'
# the summary speaks of this run alone: here the suite did not run
stderr '^machinery run: adapter: partly run: 2 id\(s\): 2 of 4 claimants passed in this run$'
exec machinery owed sync --prune-only
stdout '^owed: 2 kept, 0 added, 1 removed$'
exec mrun 1 verify
! stdout 'partly run'
stdout '^checked: 16 obligations, 5 proven, 3 by adapter at function granularity, 2 by adapter at file granularity, 0 partial, 2 owed, 7 receipts$'
exec machinery status --no-backlog
! stdout '^partly run'

# a claiming file that cannot be read as Go, in a package the command does not name, is a
# claimant the adapter cannot judge: the line scan still finds its marker, the id is partly run
# in verify, status, proof and the story gate, and verify names the file with the parse error
mkdir e2e/broken
cp broken_test.go.txt e2e/broken/broken_test.go
gitcommit 'a claimant in a file that does not parse'
exec machinery run --adapter go-test-json -- go test -count=1 ./e2e/suite ./e2e/extra
stderr '^machinery run: adapter: e2e/broken/broken_test\.go: cannot be read as Go \(10:3: expected ''\}'', found ''EOF''\): its claims count as not passed; fix the file or remove its markers$'
stderr '^machinery run: adapter: partly run: 1 id\(s\): 2 of 3 claimants passed in this run$'
exec mrun 1 verify
stdout '^checked: 16 obligations, 4 proven, 2 by adapter at function granularity, 2 by adapter at file granularity, 0 partial, 1 partly run, 2 owed, 7 receipts$'
stdout '^  ERROR  partly run: inv:paid-before-shipped: 2 of 3 claimants passed: run the claimants without a pass at this commit, or excuse those that cannot run here in evidence\.adapter\.excused$'
stdout '^  warn   partly run: inv:paid-before-shipped: e2e/broken/broken_test\.go: cannot be judged by the adapter \(cannot be read as Go: 10:3: expected ''\}'', found ''EOF''\); it needs a receipt its own test emits, a sources entry if it is a staged Go source, or an excused entry with a reason$'
! stdout 'no verdict: e2e/broken'
! stdout 'unproven: inv:paid-before-shipped'
exec machinery status --no-backlog
stdout '^partly run: 1 \(inv 1\): 2 of 3 claimants passed$'
exec mrun 1 proof --ids inv:paid-before-shipped
stdout '^not proven:\n  inv:paid-before-shipped \(partly run: 2 of 3 claimants passed\)$'
exec mrun 1 story shop-c1
stdout '^  ERROR  partly run: inv:paid-before-shipped: 2 of 3 claimants passed: run the claimants without a pass at this commit, or excuse those that cannot run here in evidence\.adapter\.excused$'
# it is a file claimant like any other: an entry of evidence.adapter.excused without functions
# covers it, with a reason
cp broken-excused.yaml machinery.yaml
exec mrun 1 verify --allow-dirty
stdout '^  warn   adapter excused: entry 1 \(tests e2e/broken/\*_test\.go\): 1 claimant\(s\) of 1 id\(s\): the broken package runs elsewhere$'
stdout '^  warn   excused: inv:paid-before-shipped: proven \(1 claimant\(s\) excused\)$'
! stdout 'partly run: inv:paid-before-shipped'
exec git checkout -q machinery.yaml
# a file under trace.tests that cannot be read at all hides its markers: the commands that read
# them fail, and nothing is judged without it
chmod 000 e2e/broken/broken_test.go
exec mrun 1 verify
stdout '^  ERROR  e2e/broken/broken_test\.go: cannot be read \(permission denied\): its markers cannot be seen; make the file readable$'
! stdout '^passed$'
exec mrun 1 status --no-backlog
stderr '^machinery: e2e/broken/broken_test\.go: cannot be read \(permission denied\): its markers cannot be seen; make the file readable$'
chmod 644 e2e/broken/broken_test.go
rm e2e/broken
gitcommit 'the file that does not parse is gone'

# a claimant with a fail fails the id, whatever the others passed
env SHOP_AGAIN=fail
exec mrun 1 run --adapter go-test-json -- go test -count=1 ./e2e/extra
env SHOP_AGAIN=
exec mrun 1 verify
stdout '^  ERROR  failed: inv:paid-before-shipped \(e2e/extra/extra_test\.go::TestShipAgain\)$'
! stdout 'partly run: inv:paid-before-shipped'

# a claimant whose receipt is a skip is named as skipped
rm .machinery/receipts
exec machinery run --adapter go-test-json -- go test -count=1 ./e2e/suite
env SHOP_AGAIN=skip
exec machinery run --adapter go-test-json -- go test -count=1 ./e2e/extra
env SHOP_AGAIN=
exec mrun 1 verify
stdout '^  ERROR  partly run: inv:paid-before-shipped: 1 of 2 claimants passed: run the claimants without a pass at this commit, or excuse those that cannot run here in evidence\.adapter\.excused$'
stdout '^  warn   partly run: inv:paid-before-shipped: skipped: e2e/extra/extra_test\.go::TestShipAgain$'
! stdout 'no verdict: e2e/extra/extra_test\.go::TestShipAgain'

# past ten missing claimants verify names the first ten; --partly names every one
rm .machinery/receipts
exec git tag before-many
mkdir e2e/many
cp many_test.go.txt e2e/many/many_test.go
gitcommit 'twelve more claimants of the email invariant'
exec machinery run --adapter go-test-json -- go test -count=1 ./e2e/suite
stderr '^machinery run: adapter: partly run: 3 id\(s\): 3 of 17 claimants passed in this run$'
exec mrun 1 verify
stdout '^  ERROR  partly run: inv:customer-email-unique: 1 of 13 claimants passed: run the claimants without a pass at this commit, or excuse those that cannot run here in evidence\.adapter\.excused$'
stdout -count=10 '^  warn   partly run: [a-z:-]+: no verdict: '
stdout '^  warn   partly run: inv:customer-email-unique: no verdict: e2e/many/many_test\.go::TestM01$'
stdout '^  warn   partly run: 4 more claimant\(s\) without a pass: machinery verify --partly lists every one$'
! stdout 'TestShipAgain'
exec mrun 1 verify --partly
stdout -count=14 '^  warn   partly run: [a-z:-]+: no verdict: '
stdout '^  warn   partly run: inv:paid-before-shipped: no verdict: e2e/extra/extra_test\.go::TestShipAgain$'
! stdout 'more claimant'
# a targeted verify keeps the partly run ERROR of an id the change touches, names its claimants
# only, and drops the partly run ERRORs of the others
exec mrun 1 verify --affected --base before-many
stdout '^  ERROR  partly run: inv:customer-email-unique: 1 of 13 claimants passed: run the claimants without a pass at this commit, or excuse those that cannot run here in evidence\.adapter\.excused$'
stdout -count=10 '^  warn   partly run: inv:customer-email-unique: no verdict: '
stdout '^  warn   partly run: 2 more claimant\(s\) without a pass: machinery verify --partly lists every one$'
! stdout 'partly run: inv:paid-before-shipped'
! stdout 'partly run: sc:customer-pays-and-the-order-ships'

# a pass the policy does not count still satisfies its claimant: with min_granularity function
# the file-level claimant's pass proves nothing, and the id is proven by its other claimant
rm .machinery/receipts
cp function.yaml machinery.yaml
mkdir e2e/gran
cp gran_test.go.txt e2e/gran/gran_test.go
gitcommit 'a file-level claimant of the final-state invariant; function granularity'
exec machinery run --adapter go-test-json -- go test -count=1 ./e2e/suite ./e2e/gran
stderr '^machinery run: adapter: receipts written: 6 pass, 0 fail, 0 skip$'
exec mrun 1 verify
! stdout 'partly run: inv:terminal-is-final'
! stdout 'inv:terminal-is-final not counted'
exec machinery proof --ids inv:terminal-is-final
stdout '^  inv:terminal-is-final -> e2e/suite/order_test\.go::TestCancelIsFinal -> pass: go test: TestCancelIsFinal passed \(subtests: 2\) \(by adapter at function granularity\)$'

# claims: any is the rule of one claimant: any pass proves the id
cp any.yaml machinery.yaml
gitcommit 'adapter: any claimant'
exec machinery run --adapter go-test-json -- go test -count=1 ./e2e/suite
! stderr 'partly run'
exec mrun 1 verify
! stdout 'partly run'
stdout '^checked: 16 obligations, 5 proven, 3 by adapter at function granularity, 2 by adapter at file granularity, 0 partial, 2 owed, 5 receipts$'

# claims takes all or any
cp bad-claims.yaml machinery.yaml
exec mrun 2 config
stderr '^config: evidence\.adapter\.claims must be all or any, got "some"$'

-- c1.txt --
machinery:ids inv:paid-before-shipped
machinery:scope internal/domain/**
-- owed-paid.yaml --
version: 1
owed:
  - id: fm:payment-provider-down
    reason: "no test induces a provider outage yet"
  - id: inv:paid-before-shipped
    reason: "the second claimant runs in another job"
  - id: tc:ORDE-8bd6e7
    reason: "effect recordCharge is a noop in the skeleton"
-- e2e/extra/extra_test.go --
package extra

import (
	"os"
	"testing"
)

// TestShipAgain is a second claimant of the invariant, in a package of its own. SHOP_AGAIN=fail
// fails it and SHOP_AGAIN=skip skips it.
//
// machinery:verifies inv:paid-before-shipped
func TestShipAgain(t *testing.T) {
	switch os.Getenv("SHOP_AGAIN") {
	case "fail":
		t.Fatal("an unpaid order shipped")
	case "skip":
		t.Skip("no second shop in this run")
	}
}
-- e2e/extra/file_test.go --
package extra

// The marker of this file stands above no function: the file is a claimant of the scenario.
//
// machinery:verifies sc:customer-pays-and-the-order-ships

import "testing"

func TestPayAgain(t *testing.T) {}
-- broken_test.go.txt --
