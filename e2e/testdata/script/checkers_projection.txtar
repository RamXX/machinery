# gen writes projection.json when checkers or facts are configured: every list, sorted, deterministic
fixture shop
cp machinery.ck.yaml machinery.yaml
cp facts.yaml design/facts.yaml
exec machinery gen
stdout 'gen: wrote 5 file\(s\)'
stdout 'design/gen/projection.json'

# the entities, with attributes, relationships and actions that name what they preserve
grep '"version": 1' design/gen/projection.json
grep '"id": "entity:Customer"' design/gen/projection.json
grep '"id": "entity:Order"' design/gen/projection.json
grep '"cardinality": "n:1"' design/gen/projection.json
grep '"ownership": "owned"' design/gen/projection.json
grep '"id": "act:Order.pay"' design/gen/projection.json
grep '"actor": "Clerk"' design/gen/projection.json
grep '"inv:paid-before-shipped"' design/gen/projection.json
grep '"type": "OrderStatus"' design/gen/projection.json
# enums, invariants (entity-level and top-level), scenarios
grep '"name": "OrderStatus"' design/gen/projection.json
grep '"id": "inv:customer-email-unique"' design/gen/projection.json
grep '"entity": "Customer"' design/gen/projection.json
grep '"statement": "An Order reaches the shipped status only from the paid status."' design/gen/projection.json
grep '"id": "sc:customer-pays-and-the-order-ships"' design/gen/projection.json
grep '"actors": \[' design/gen/projection.json
# the machine: states, transitions, ignores, invokes
grep '"role": "lifecycle"' design/gen/projection.json
grep '"lifecycle_of": "Order"' design/gen/projection.json
grep '"tag": "ORDE"' design/gen/projection.json
grep '"path": "Pending"' design/gen/projection.json
grep '"id": "tc:ORDE-2e883d"' design/gen/projection.json
grep '"guard": "hasPaymentMethod"' design/gen/projection.json
grep '"id": "tc:ORDE-2fa2af"' design/gen/projection.json
grep '"src": "chargePayment"' design/gen/projection.json
# operations, failure modes, dependencies, facts
grep '"id": "payOrder"' design/gen/projection.json
grep '"id": "fm:payment-provider-down"' design/gen/projection.json
grep '"dependencies": \[\]' design/gen/projection.json
grep '"predicate": "handles-payment-data"' design/gen/projection.json
grep '"value": 90' design/gen/projection.json
grep '"value": false' design/gen/projection.json
# it never holds a checker obligation
! grep '"ck:' design/gen/projection.json

# every list is sorted by id or name
exec sh -c 'grep "\"id\": \"act:" design/gen/projection.json | sort -c'
exec sh -c 'grep "\"id\": \"inv:" design/gen/projection.json | sort -c'
exec sh -c 'grep "\"id\": \"sc:" design/gen/projection.json | sort -c'
exec sh -c 'grep "\"predicate\"" design/gen/projection.json | head -1 | grep handles-payment-data'

# deterministic, and gen-drift covers it
cp design/gen/projection.json first.json
exec machinery gen
stdout 'gen: wrote 0 file\(s\)'
cmp design/gen/projection.json first.json
exec mrun 0 gen --check
stdout 'checked: 4 generated files'
stdout '^passed$'

# a changed fact makes it stale; a removed file is missing
exec sed -i.bak 's/value: 90/value: 30/' design/facts.yaml
exec mrun 1 gen --check
stdout 'DRIFT  design/gen/projection.json: stale'
exec machinery gen
stdout 'design/gen/projection.json'
grep '"value": 30' design/gen/projection.json
rm design/gen/projection.json
exec mrun 1 gen --check
stdout 'DRIFT  design/gen/projection.json: missing'

# checkers without a facts file: facts is an empty list
cp machinery.nofacts.yaml machinery.yaml
exec machinery gen
grep '"facts": \[\]' design/gen/projection.json

# facts without checkers: the projection is still written
cp machinery.factsonly.yaml machinery.yaml
exec machinery gen
grep '"predicate": "handles-payment-data"' design/gen/projection.json

-- machinery.ck.yaml --
version: 2
design:
  models:
    - design/model/shop.modelith.yaml
  machines: design/machines
  failure_modes: design/failure-modes.yaml
  facts: design/facts.yaml
contracts:
  - kind: openapi
    path: contracts/openapi.yaml
checkers:
  - id: rules
    covers: ["act:*", "inv:*"]
trace:
  code: ["internal/**/*.go"]
  tests: ["e2e/**"]
constraints:
  layers:
    - {name: domain, paths: ["internal/domain/**"]}
    - {name: api, paths: ["internal/api/**"]}
  size:
    max_file_lines: 200
    max_func_lines: 40
waivers:
  - {rule: action-event, id: "act:Order.place", reason: "creation enters the initial state Pending"}
-- facts.yaml --
version: 1
facts:
  - subject: system
    predicate: automated-decisions
    value: false
  - subject: "act:Order.pay"
    predicate: handles-payment-data
    value: true
  - subject: "act:Order.pay"
    predicate: retention-days
    value: 90
-- machinery.nofacts.yaml --
version: 2
design:
  models:
    - design/model/shop.modelith.yaml
  machines: design/machines
  failure_modes: design/failure-modes.yaml
contracts:
  - kind: openapi
    path: contracts/openapi.yaml
checkers:
  - id: rules
    covers: ["act:*", "inv:*"]
trace:
  code: ["internal/**/*.go"]
  tests: ["e2e/**"]
constraints:
  layers:
    - {name: domain, paths: ["internal/domain/**"]}
    - {name: api, paths: ["internal/api/**"]}
  size:
    max_file_lines: 200
    max_func_lines: 40
waivers:
  - {rule: action-event, id: "act:Order.place", reason: "creation enters the initial state Pending"}
-- machinery.factsonly.yaml --
version: 2
design:
  models:
    - design/model/shop.modelith.yaml
  machines: design/machines
  failure_modes: design/failure-modes.yaml
  facts: design/facts.yaml
contracts:
  - kind: openapi
    path: contracts/openapi.yaml
trace:
  code: ["internal/**/*.go"]
  tests: ["e2e/**"]
constraints:
  layers:
    - {name: domain, paths: ["internal/domain/**"]}
    - {name: api, paths: ["internal/api/**"]}
  size:
    max_file_lines: 200
    max_func_lines: 40
waivers:
  - {rule: action-event, id: "act:Order.place", reason: "creation enters the initial state Pending"}
