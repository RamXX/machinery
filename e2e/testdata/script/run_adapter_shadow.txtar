-- scenario_testfoo_test.go --
package suite

// The markers of this file stand above no function: they belong to every test function in it.
//
// machinery:verifies sc:customer-pays-and-the-order-ships sc:cancelled-order-refuses-payment

import (
	"os"
	"testing"

	"example.test/shop/internal/api"
)

// TestdataPath is a helper: go test does not run it, its parameter is no *testing.T.
func TestdataPath(name string) string { return "testdata/" + name }

func TestPayThenShip(t *testing.T) {
	for _, event := range []string{"pay", "ship"} {
		if got := api.Handle(event); got != event {
			t.Fatalf("Handle(%s) = %q", event, got)
		}
	}
}

// TestMain is not a test function: it has no verdict of its own, and the markers of the file
// do not wait for one.
func TestMain(m *testing.M) {
	os.Exit(m.Run())
}

func TestCancelledRefusesPay(t *testing.T) {
	if os.Getenv("SHOP_SCENARIO") == "fail" {
		t.Fatal("pay accepted on a cancelled order")
	}
	if os.Getenv("SHOP_SCENARIO") == "skip" {
		t.Skip("no cancelled order in this run")
	}
	if got := api.Handle("pay"); got != "pay" {
		t.Fatalf("Handle(pay) = %q", got)
	}
}
-- scenario_helpers_test.go --
package suite

// The markers of this file stand above no function: they belong to every test function in it.
//
// machinery:verifies sc:customer-pays-and-the-order-ships sc:cancelled-order-refuses-payment

import (
	"path"
	"testing"

	"example.test/shop/internal/api"
)

// TestdataDir and TestdataJoin are helpers that begin with Test: no parameter, and two.
func TestdataDir() string { return "testdata" }

func TestdataJoin(dir, name string) string { return path.Join(dir, name) }

func TestPayThenShip(t *testing.T) {
	for _, event := range []string{"pay", "ship"} {
		if got := api.Handle(event); got != event {
			t.Fatalf("Handle(%s) = %q", event, got)
		}
	}
}

func TestCancelledRefusesPay(t *testing.T) {
	if got := api.Handle("pay"); got != "pay" {
		t.Fatalf("Handle(pay) = %q", got)
	}
}
-- testmain_t_test.go --
package suite

import "testing"

// TestMain takes a *testing.T here: go test runs it as a test, and it is no test main.
//
// machinery:verifies inv:terminal-is-final
func TestMain(t *testing.T) {
	if TestdataJoin(TestdataDir(), "x") != "testdata/x" {
		t.Fatal("helpers broken")
	}
}
-- named.yaml --
version: 2
design:
  models:
    - design/model/shop.modelith.yaml
  machines: design/machines
  failure_modes: design/failure-modes.yaml
contracts:
  - kind: openapi
    path: contracts/openapi.yaml
trace:
  code: ["internal/**/*.go"]
  tests: ["e2e/suite/order_test.go", "e2e/suite/email_test.go", "e2e/suite/scenario_test.go", "e2e/suite/outage_test.go"]
constraints:
  layers:
    - {name: domain, paths: ["internal/domain/**"]}
    - {name: api, paths: ["internal/api/**"]}
  size:
    max_file_lines: 200
    max_func_lines: 40
waivers:
  - {rule: action-event, id: "act:Order.place", reason: "creation enters the initial state Pending"}
-- globbed.yaml --
version: 2
design:
  models:
    - design/model/shop.modelith.yaml
  machines: design/machines
  failure_modes: design/failure-modes.yaml
contracts:
  - kind: openapi
    path: contracts/openapi.yaml
trace:
  code: ["internal/**/*.go"]
  tests: ["e2e/**"]
constraints:
  layers:
    - {name: domain, paths: ["internal/domain/**"]}
    - {name: api, paths: ["internal/api/**"]}
  size:
    max_file_lines: 200
    max_func_lines: 40
waivers:
  - {rule: action-event, id: "act:Order.place", reason: "creation enters the initial state Pending"}
