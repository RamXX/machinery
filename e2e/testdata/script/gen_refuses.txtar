# gen refuses to write when the machines stage has an error
fixture shop
cp broken.json design/machines/Order.machine.json
exec mrun 1 gen
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order.machine.json: dangling target ''Canceled'' \(no sibling of Paid is named ''Canceled''\) from Paid \(on:cancel\)$'
stdout '^failed: 1 finding\(s\)$'
stdout '^gen: refused: the design has errors; nothing was written$'
! exists design/gen
! exists design/model/shop.modelith.md

# the same design, repaired, generates
cp $WORK/shop.json design/machines/Order.machine.json
exec machinery gen
stdout 'gen: wrote 4 file\(s\)'
exists design/gen/obligations.json

# a repaired design that breaks again leaves the committed files untouched
cp broken.json design/machines/Order.machine.json
exec mrun 1 gen
stdout 'gen: refused'
grep '"id": "tc:ORDE-507e4f"' design/gen/obligations.json

-- broken.json --
{
  "_comment": "Order lifecycle. Domain states mirror the OrderStatus enum; `paying` is the transient overlay around the payment call.",
  "_delays": {
    "payTimeout": "5000 ms - upper bound on the payment provider call"
  },
  "id": "order",
  "initial": "Pending",
  "context": {
    "orderId": null,
    "lastError": null
  },
  "states": {
    "Pending": {
      "on": {
        "pay": [
          {
            "target": "paying",
            "guard": "hasPaymentMethod",
            "actions": "stampAttempt"
          },
          {
            "actions": "recordPayRefused"
          }
        ],
        "cancel": {
          "target": "Cancelled",
          "actions": "recordCancellation"
        }
      },
      "_ignores": {
        "ship": "an unpaid order cannot ship; the API refuses with ORDER_NOT_PAID"
      }
    },
    "paying": {
      "invoke": {
        "src": "chargePayment",
        "onDone": {
          "target": "Paid",
          "actions": "recordCharge"
        },
        "onError": {
          "target": "Pending",
          "actions": "recordPaymentFailure"
        }
      },
      "after": {
        "payTimeout": {
          "target": "Pending",
          "actions": "recordPaymentTimeout"
        }
      }
    },
    "Paid": {
      "on": {
        "ship": {
          "target": "Shipped",
          "actions": "recordShipment"
        },
        "cancel": {
          "target": "Canceled",
          "actions": [
            "refundPayment",
            "recordCancellation"
          ]
        }
      },
      "_ignores": {
        "pay": "already paid; a repeated pay is refused with ORDER_ALREADY_PAID"
      }
    },
    "Shipped": {
      "type": "final",
      "entry": "notifyCustomer"
    },
    "Cancelled": {
      "type": "final"
    }
  }
}
