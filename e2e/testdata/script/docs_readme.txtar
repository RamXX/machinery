# Every command of the ten-minute block of the README runs, in order, in an empty directory.
env MACHINERY_REPO=$REPO
mkdir proj
cd proj
exec rundoc $REPO/README.md
stdout 'init: created 5 path\(s\)'
stdout 'gen: wrote 4 file\(s\)'
stdout 'machinery check: [0-9]+ passed, 0 failed, 0 not demonstrated, [0-9]+ not applicable'
stdout 'tickets: all checks passed'
stdout 'checked: 6 obligations, 6 proven, 0 partial, 0 owed, 6 receipts'
stdout 'machinery verify: 1 passed, 0 failed, 0 not demonstrated, 0 not applicable'
stdout 'obligations: 6 \(tc 4, sc 1, inv 1\)'
