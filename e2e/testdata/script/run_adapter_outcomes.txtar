# what the adapter writes for a function that failed, was skipped or did not run, and for a
# package that did not end ok (section 10.3)
fixture shop
fixture shop-gotests
exec machinery gen
gitinit

# a failed function: a fail receipt for the id above it. The package did not end with pass, so
# no pass is written from it, and the passes of its other functions count for nothing. A
# function of the package with no verdict fails with it: the file behind the tag faults was not
# built, and its claim fails, a false fail rather than a lost one
env SHOP_EMAIL=fail
exec mrun 1 run --adapter go-test-json -- go test -count=1 ./e2e/suite
stderr 'with a verdict: 5 passed, 1 failed, 0 skipped$'
stderr '^machinery run: adapter: receipts written: 0 pass, 2 fail, 0 skip$'
stderr '^machinery run: adapter: claimed, not run: 0 id\(s\)$'
stderr '^machinery run: adapter: claimed, verdict not counted: 4 id\(s\)$'
stderr '^machinery run: adapter: package example\.test/shop/e2e/suite: did not end with pass; no pass is written from it$'
stderr '^machinery run: adapter: package example\.test/shop/e2e/suite: 1 test function\(s\) without a verdict, read as failed: TestProviderDown$'
exec sh -c 'grep "\"type\":\"receipt\"" .machinery/receipts/*.jsonl'
cmp stdout want-fail.jsonl
exec mrun 1 verify
stdout '^  ERROR  failed: inv:customer-email-unique \(e2e/suite/email_test\.go::TestEmailUnique\)$'
stdout '^  ERROR  failed: fm:payment-provider-down \(e2e/suite/outage_test\.go\)$'
exec machinery status
stdout '^proven: 0  partial: 0  failed: 2  owed: 2  unproven and not owed: 13$'

# a skipped function: a skip receipt, which never counts
rm .machinery/receipts
env SHOP_EMAIL=skip
exec machinery run --adapter go-test-json -- go test -count=1 ./e2e/suite
stderr 'with a verdict: 5 passed, 0 failed, 1 skipped$'
stderr '^machinery run: adapter: receipts written: 4 pass, 0 fail, 1 skip$'
exec sh -c 'grep -h inv:customer-email-unique .machinery/receipts/*.jsonl'
stdout '"outcome":"skip","test":"e2e/suite/email_test.go::TestEmailUnique","observed":"go test: TestEmailUnique skipped","source":"adapter","granularity":"function"'
exec mrun 1 verify
stdout '^checked: 16 obligations, 4 proven, 2 by adapter at function granularity, 2 by adapter at file granularity, 0 partial, 2 owed, 5 receipts$'
stdout '^  ERROR  unproven: inv:customer-email-unique$'
env SHOP_EMAIL=

# at file granularity one failed function fails every id of the file, and one skipped function
# skips them
rm .machinery/receipts
env SHOP_SCENARIO=fail
exec mrun 1 run --adapter go-test-json -- go test -count=1 ./e2e/suite
stderr '^machinery run: adapter: receipts written: 0 pass, 3 fail, 0 skip$'
exec sh -c 'grep "\"type\":\"receipt\"" .machinery/receipts/*.jsonl'
cmp stdout want-file-fail.jsonl
rm .machinery/receipts
env SHOP_SCENARIO=skip
exec machinery run --adapter go-test-json -- go test -count=1 ./e2e/suite
stderr '^machinery run: adapter: receipts written: 3 pass, 0 fail, 2 skip$'
exec sh -c 'grep -h sc:customer-pays .machinery/receipts/*.jsonl'
stdout '"outcome":"skip","test":"e2e/suite/scenario_test.go","observed":"go test: TestCancelledRefusesPay skipped","source":"adapter","granularity":"file"'
env SHOP_SCENARIO=

# a failed subtest fails its parent
rm .machinery/receipts
env SHOP_FAIL_SUBTEST=cancelled
exec mrun 1 run --adapter go-test-json -- go test -count=1 ./e2e/suite
stderr 'with a verdict: 5 passed, 1 failed, 0 skipped$'
exec sh -c 'grep "\"type\":\"receipt\"" .machinery/receipts/*.jsonl'
stdout -count=2 receipt
stdout '"id":"inv:terminal-is-final","outcome":"fail","test":"e2e/suite/order_test.go::TestCancelIsFinal","observed":"go test: TestCancelIsFinal failed"'
env SHOP_FAIL_SUBTEST=

# a skipped subtest skips its parent, though go passes the parent: nothing of it was checked
rm .machinery/receipts
env SHOP_SKIP_SUBTEST=shipped
exec machinery run --adapter go-test-json -- go test -count=1 ./e2e/suite
stderr 'with a verdict: 5 passed, 0 failed, 1 skipped$'
stderr '^machinery run: adapter: receipts written: 4 pass, 0 fail, 1 skip$'
exec sh -c 'grep -h inv:terminal-is-final .machinery/receipts/*.jsonl'
stdout '"outcome":"skip","test":"e2e/suite/order_test.go::TestCancelIsFinal","observed":"go test: TestCancelIsFinal skipped"'
exec mrun 1 verify
stdout '^  ERROR  unproven: inv:terminal-is-final$'
env SHOP_SKIP_SUBTEST=

# a function that claims nothing fails: the package did not end ok, no pass of it counts, and
# the claim of the function without a verdict fails
rm .machinery/receipts
env SHOP_ROUTING=fail
exec mrun 1 run --adapter go-test-json -- go test -count=1 ./e2e/suite
stderr '^machinery run: adapter: receipts written: 0 pass, 1 fail, 0 skip$'
stderr '^machinery run: adapter: claimed, verdict not counted: 5 id\(s\)$'
stderr 'package example\.test/shop/e2e/suite: did not end with pass; no pass is written from it$'
exec sh -c 'grep -h "\"type\":\"receipt\"" .machinery/receipts/*.jsonl'
stdout -count=1 receipt
stdout '"id":"fm:payment-provider-down","outcome":"fail"'
exec mrun 1 verify
stdout '^checked: 16 obligations, 0 proven, 0 partial, 2 owed, 1 receipts$'
stdout '^  warn   run exited 1: '
env SHOP_ROUTING=

# a test that hangs past -timeout, calls os.Exit or panics in a goroutine has a run event and no
# verdict, and its package fails: the test failed ("no verdict; the package failed"), and so did
# every test function of the package without a verdict, here every other one, since the binary
# stopped before they started
rm .machinery/receipts
env SHOP_EMAIL=hang
exec mrun 1 run --adapter go-test-json -- go test -timeout 3s ./e2e/suite
env SHOP_EMAIL=
stderr 'with a verdict: 0 passed, 1 failed, 0 skipped$'
stderr '^machinery run: adapter: receipts written: 0 pass, 6 fail, 0 skip$'
stderr '^machinery run: adapter: package example\.test/shop/e2e/suite: 7 test function\(s\) without a verdict, read as failed: TestCancelIsFinal, TestCancelledRefusesPay, TestEmailUnique, TestPayThenShip, TestProviderDown and 2 more$'
exec sh -c 'grep -h inv:customer-email-unique .machinery/receipts/*.jsonl'
stdout '"outcome":"fail","test":"e2e/suite/email_test.go::TestEmailUnique","observed":"go test: TestEmailUnique: no verdict; the package failed"'
exec sh -c 'grep -h sc:customer-pays-and-the-order-ships .machinery/receipts/*.jsonl'
stdout '"outcome":"fail","test":"e2e/suite/scenario_test.go","observed":"go test: TestCancelledRefusesPay, TestPayThenShip: no verdict; the package failed"'
rm .machinery/receipts
env SHOP_EMAIL=panic
exec mrun 1 run --adapter go-test-json -- go test ./e2e/suite
env SHOP_EMAIL=
stderr '^machinery run: adapter: receipts written: 0 pass, 6 fail, 0 skip$'

# an earlier pass at the same commit does not stand against a later run that failed this way:
# the later fail receipt fails the id
rm .machinery/receipts
exec machinery run --adapter go-test-json -- go test ./e2e/suite
stderr '^machinery run: adapter: receipts written: 5 pass, 0 fail, 0 skip$'
env SHOP_EMAIL=exit
exec mrun 1 run --adapter go-test-json -- go test ./e2e/suite
env SHOP_EMAIL=
stderr '^machinery run: adapter: receipts written: 0 pass, 6 fail, 0 skip$'
exec mrun 1 verify
stdout '^  ERROR  failed: inv:customer-email-unique \(e2e/suite/email_test\.go::TestEmailUnique\)$'
stdout '^  ERROR  failed: inv:paid-before-shipped \(e2e/suite/order_test\.go::TestShipNeedsPayment\)$'
exec machinery status
stdout '^proven: 0  partial: 0  failed: 6  '

# a stream in which a package has no end event, here because the test killed the go command, is
# no complete run: no receipt, no end line, and verify reports it
rm .machinery/receipts
env SHOP_EMAIL=kill
exec mrun 137 run --adapter go-test-json -- go test ./e2e/suite
env SHOP_EMAIL=
stderr '^machinery: run: go test -json: package example\.test/shop/e2e/suite has no end event; the run is left incomplete: find what stopped go test, delete the receipts file and run again$'
! stderr 'receipts written'
exec sh -c '! grep -q "\"type\":\"end\"" .machinery/receipts/*.jsonl'
exec mrun 1 verify
stdout '^  ERROR  incomplete run: \.machinery/receipts/'

# a function that did not run writes nothing: the id stays without evidence and is counted
rm .machinery/receipts
exec machinery run --adapter go-test-json -- go test -count=1 -run TestShipNeedsPayment ./e2e/suite
stderr 'adapter go-test-json: 1 package\(s\), 1 test function\(s\) with a verdict: 1 passed, 0 failed, 0 skipped$'
stderr '^machinery run: adapter: receipts written: 1 pass, 0 fail, 0 skip$'
stderr '^machinery run: adapter: claimed, not run: 5 id\(s\)$'
# at file granularity every function of the file must have run
rm .machinery/receipts
exec machinery run --adapter go-test-json -- go test -count=1 -run TestPayThenShip ./e2e/suite
stderr '^machinery run: adapter: receipts written: 0 pass, 0 fail, 0 skip$'
stderr '^machinery run: adapter: claimed, not run: 6 id\(s\)$'
exec mrun 1 verify
stdout '^  ERROR  unproven: sc:customer-pays-and-the-order-ships$'

-- want-fail.jsonl --
{"v":1,"type":"receipt","id":"fm:payment-provider-down","outcome":"fail","test":"e2e/suite/outage_test.go","observed":"go test: TestProviderDown: no verdict; the package failed","source":"adapter","granularity":"file","tags":[]}
{"v":1,"type":"receipt","id":"inv:customer-email-unique","outcome":"fail","test":"e2e/suite/email_test.go::TestEmailUnique","observed":"go test: TestEmailUnique failed","source":"adapter","granularity":"function","tags":[]}
-- want-file-fail.jsonl --
{"v":1,"type":"receipt","id":"fm:payment-provider-down","outcome":"fail","test":"e2e/suite/outage_test.go","observed":"go test: TestProviderDown: no verdict; the package failed","source":"adapter","granularity":"file","tags":[]}
{"v":1,"type":"receipt","id":"sc:cancelled-order-refuses-payment","outcome":"fail","test":"e2e/suite/scenario_test.go","observed":"go test: TestCancelledRefusesPay failed","source":"adapter","granularity":"file","tags":[]}
{"v":1,"type":"receipt","id":"sc:customer-pays-and-the-order-ships","outcome":"fail","test":"e2e/suite/scenario_test.go","observed":"go test: TestCancelledRefusesPay failed","source":"adapter","granularity":"file","tags":[]}
