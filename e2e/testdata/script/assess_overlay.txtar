-- links.orig --
version: 1
links:
  - {id: RISK-1, kind: abuse, subject: "act:Loan.lend", required: refuse}
  - {id: RISK-2, subject: "invoke:hold_queue.sendNotice", required: retry-bounded}
  - {id: RISK-3, subject: "state:loan.Lost", required: surface}
-- ov/design/risk-links.yaml --
version: 1
links:
  - {id: RISK-1, kind: abuse, subject: "act:Loan.lend", required: refuse}
  - {id: RISK-2, subject: "invoke:hold_queue.sendNotice", required: retry-bounded}
  - {id: RISK-3, subject: "state:loan.Lost", required: surface}
-- ov/design/status.yaml --
version: 1
-- ov-links/design/risk-links.yaml --
version: 1
links: []
-- ov-status/design/status.yaml --
version: 1
-- ov-garbage/design/risk-links.yaml --
version: 1
links:
  - {ids: [RISK-1..RISK-4]}
-- ov-cfg/machinery.yaml --
