# assess --overlay <dir>: the files of <dir> are laid over the snapshot, same relative paths,
# before anything runs. An overlay holds only the links, status and risk files the config of the
# run names, never the config; the report lists each with its role and sha256 and says the
# result is not the result of HEAD (docs/formats.md sections 18.1, 18.2 and 18.9)
fixture library proj
cd proj
symlink alias -> design
gitinit
cd $WORK
exec sh -c 'cd proj && find . -type f | LC_ALL=C sort | xargs cksum > ../before.txt'

# refusals, exit 2, nothing written
exec mrun 2 -C proj assess --overlay nowhere --out out
stderr '^usage: --overlay nowhere is not a directory$'
mkdir hollow/design
exec mrun 2 -C proj assess --overlay hollow --out out
stderr '^usage: --overlay hollow holds no file$'
# never the config: the run has one config, the project's or the one --config names
exec mrun 2 -C proj assess --overlay ov-cfg --out out
stderr '^usage: --overlay ov-cfg: machinery.yaml: an overlay never holds the config; the config of the run is the machinery.yaml of the project or --config$'
# a file the config does not name as its links, status or risk file: a test, code, a note, the
# owed list, a model
exec mrun 2 -C proj assess --overlay ov-test --out out
stderr '^usage: --overlay ov-test: e2e/loans.sh is not the links file \(import.failure_modes.links\), the status file \(design.status\) or the risk file \(design.risk\) of machinery.yaml; an overlay holds nothing else$'
exec mrun 2 -C proj assess --overlay ov-code --out out
stderr '^usage: --overlay ov-code: internal/desk/extra.go is not the links file '
exec mrun 2 -C proj assess --overlay ov-extra --out out
stderr '^usage: --overlay ov-extra: design/notes/why.md is not the links file '
exec mrun 2 -C proj assess --overlay ov-owed --out out
stderr '^usage: --overlay ov-owed: design/owed.yaml is not the links file '
exec mrun 2 -C proj assess --overlay ov-model --out out
stderr '^usage: --overlay ov-model: design/model/library.modelith.yaml is not the links file '
# a config that points the owed list, or the failure-mode file, at the status path: the file
# would be read as two things, or as something an overlay never holds
exec mrun 2 -C proj assess --config owed-too.yaml --overlay ov-status --out out
stderr '^usage: --overlay ov-status: design/status.yaml is design.status and also design.owed in --config owed-too.yaml; an overlaid file has exactly one role$'
exec mrun 2 -C proj assess --config owed-only.yaml --overlay ov-status --out out
stderr '^usage: --overlay ov-status: design/status.yaml is not the links file \(import.failure_modes.links\), the status file \(design.status\) or the risk file \(design.risk\) of --config owed-only.yaml; an overlay holds nothing else$'
exec mrun 2 -C proj assess --config modes-too.yaml --overlay ov-status --out out
stderr '^usage: --overlay ov-status: design/status.yaml is design.status and also design.failure_modes in --config modes-too.yaml; an overlaid file has exactly one role$'
exec mrun 2 -C proj assess --config risk-too.yaml --overlay ov-status --out out
stderr '^usage: --overlay ov-status: design/status.yaml is design.risk and also design.status in --config risk-too.yaml; an overlaid file has exactly one role$'
exec mrun 2 -C proj assess --config catalog-too.yaml --overlay ov-links --out out
stderr '^usage: --overlay ov-links: design/risk-links.yaml is import.failure_modes.links and also import.failure_modes.file in --config catalog-too.yaml; an overlaid file has exactly one role$'
# or a glob of trace, tests or constraints matches it
exec mrun 2 -C proj assess --config test-glob.yaml --overlay ov-links --out out
stderr '^usage: --overlay ov-links: design/risk-links.yaml is import.failure_modes.links and also trace.tests in --config test-glob.yaml; an overlaid file has exactly one role$'
exec mrun 2 -C proj assess --config size-glob.yaml --overlay ov-status --out out
stderr '^usage: --overlay ov-status: design/status.yaml is design.status and also constraints.size.paths in --config size-glob.yaml; an overlaid file has exactly one role$'
exec mrun 2 -C proj assess --config machines-dir.yaml --overlay ov-status --out out
stderr '^usage: --overlay ov-status: design/status.yaml is design.status and also import.machines.files in --config machines-dir.yaml; an overlaid file has exactly one role$'
# another spelling of a path of HEAD, a path that is not ASCII
exec mrun 2 -C proj assess --overlay ov-upper --out out
stderr '^usage: --overlay ov-upper: E2E/loans.sh differs from e2e of HEAD only by case; an overlay path is written as HEAD has it$'
exec mrun 2 -C proj assess --overlay ov-case --out out
stderr '^usage: --overlay ov-case: design/Risk-Links.yaml differs from design/risk-links.yaml of HEAD only by case; an overlay path is written as HEAD has it$'
exec mrun 2 -C proj assess --overlay ov-newcase --out out
stderr '^usage: --overlay ov-newcase: DESIGN/status.yaml differs from design of HEAD only by case; an overlay path is written as HEAD has it$'
mkdir ov-uni/design
exec sh -c 'f=$(printf "ov-uni/design/st\303\244tus.yaml"); printf "version: 1\n" > "$f"'
exec mrun 2 -C proj assess --overlay ov-uni --out out
stderr '^usage: --overlay ov-uni: design/st.*tus.yaml is not written in ASCII; an overlay path holds ASCII characters only$'
# .git, links of HEAD, links in the overlay
exec mrun 2 -C proj assess --overlay ov-git --out out
stderr '^usage: --overlay ov-git: .git/config: an overlay never writes under .git$'
exec mrun 2 -C proj assess --overlay ov-through --out out
stderr '^usage: --overlay ov-through: alias/risk-links.yaml: alias is a symbolic link at HEAD; an overlay never writes through or over a link$'
exec mrun 2 -C proj assess --overlay ov-over --out out
stderr '^usage: --overlay ov-over: alias: alias is a symbolic link at HEAD; an overlay never writes through or over a link$'
mkdir ov-link/design
symlink ov-link/design/risk-links.yaml -> ../../ov/design/risk-links.yaml
exec mrun 2 -C proj assess --overlay ov-link --out out
stderr '^usage: --overlay ov-link: design/risk-links.yaml is a symbolic link; an overlay holds regular files only$'
mkdir ov-dirlink
symlink ov-dirlink/design -> ../ov/design
exec mrun 2 -C proj assess --overlay ov-dirlink --out out
stderr '^usage: --overlay ov-dirlink: design is a symbolic link; an overlay holds regular files only$'
! exists out

# the overlay: a links file that leaves one row unlinked, and a status file HEAD does not have
exec machinery -C proj assess --overlay ov --out out
stdout '^project: proj at [0-9a-f]{7}$'
stdout '^overlay: 2 file\(s\) laid over the snapshot; this is not the result of HEAD: design/risk-links.yaml \(import.failure_modes.links\), design/status.yaml \(design.status\)$'
cmp out/snapshot/design/risk-links.yaml ov/design/risk-links.yaml
cmp out/snapshot/design/status.yaml ov/design/status.yaml
cmp out/snapshot/machinery.yaml proj/machinery.yaml

# the run is the run of the overlaid design: the fourth row is unlinked there, not at HEAD
grep '^checked: 4 failure modes, 3 linked, 1 unlinked, ' out/stages/xref-failure.txt
grep '^not demonstrated: 1 of 4 failure modes name no subject; ' out/stages/xref-failure.txt

# the report lists every overlaid file with the role the run reads it as and its sha256
grep '^- config: machinery.yaml$' out/report.md
grep '^- overlay: 2 file\(s\) laid over the snapshot; this is not the result of HEAD$' out/report.md
exec sh -c 'grep -x "  - \`design/risk-links.yaml\` (import.failure_modes.links) sha256 $(shasum -a 256 ov/design/risk-links.yaml | cut -c1-64)" out/report.md'
exec sh -c 'grep -x "  - \`design/status.yaml\` (design.status) sha256 $(shasum -a 256 ov/design/status.yaml | cut -c1-64)" out/report.md'
grep '^  "overlay": \[$' out/report.json
grep '^      "path": "design/risk-links.yaml",$' out/report.json
grep '^      "role": "import.failure_modes.links",$' out/report.json
grep '^      "role": "design.status",$' out/report.json
exec sh -c 'grep -x "      \"sha256\": \"$(shasum -a 256 ov/design/risk-links.yaml | cut -c1-64)\"" out/report.json'
! grep $WORK out/report.json
! grep $WORK out/report.md

# an overlaid links file that names no subject links nothing: the assessment shows every row
# unlinked, never a passed stage
exec machinery -C proj assess --overlay ov-garbage --out out-garbage
grep '^checked: 4 failure modes, 0 linked, 4 unlinked, ' out-garbage/stages/xref-failure.txt
! grep '^passed$' out-garbage/stages/xref-failure.txt
grep '^\| xref-failure \| failed \| 4 failure modes, 0 linked, 4 unlinked, ' out-garbage/report.md

# nothing in the project changed, and the overlay was only read
exec sh -c 'cd proj && find . -type f | LC_ALL=C sort | xargs cksum > ../after.txt'
cmp before.txt after.txt
exec git -C proj status --porcelain
! stdout .
cmp ov/design/risk-links.yaml links.orig

-- owed-too.yaml --
version: 2
scope: ["internal/**"]
design:
  models:
    - design/model/library.modelith.yaml
  owed: design/status.yaml
import:
  machines:
    files: ["machines/*.json"]
    states: capitalize
    rename:
      root: {notes: _comment, entity: _lifecycle_of, startable: _entries, from_outside: _external_events}
      state: {skip: _ignores}
      transition: {allowed: _requires, denied: _refusal}
    bind:
      hold_queue: {serves: ["entity:Loan"]}
  failure_modes:
    file: docs/risks.md
    id: "^RISK-[0-9]+$"
    columns:
      failure: ["Failure", "What goes wrong"]
      behavior: ["Required behavior", "Expected"]
    links: design/risk-links.yaml
trace:
  code: ["internal/**/*.go"]
  tests: ["e2e/**"]
  markers:
    serves: ["Implements:"]
    verifies: ["Checks:", "Proves:"]
    scenarios: ["Scenario:"]
