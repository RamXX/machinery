# assess --overlay <dir>: the files of <dir> are laid over the snapshot, same relative paths,
# before anything runs; the report lists each with its sha256 and says the result is not the
# result of HEAD (docs/formats.md sections 18.1, 18.2 and 18.9)
fixture library proj
cd proj
symlink alias -> design
gitinit
cd $WORK
exec sh -c 'cd proj && find . -type f | LC_ALL=C sort | xargs cksum > ../before.txt'

# refusals, exit 2, nothing written
exec mrun 2 -C proj assess --overlay nowhere --out out
stderr '^usage: --overlay nowhere is not a directory$'
mkdir hollow/design
exec mrun 2 -C proj assess --overlay hollow --out out
stderr '^usage: --overlay hollow holds no file$'
exec mrun 2 -C proj assess --overlay ov --config other.yaml --out out
stderr '^usage: --overlay ov holds machinery.yaml and --config is given; keep one$'
# only the config and the design sources the config of HEAD names: a test, code, a file of
# another spelling, any other file
exec mrun 2 -C proj assess --overlay ov-test --out out
stderr '^usage: --overlay ov-test: e2e/loans.sh is not a design source of machinery.yaml at HEAD: an overlay holds only the config and the design sources it names \(design.risk, design.status, import.failure_modes.links\)$'
exec mrun 2 -C proj assess --overlay ov-code --out out
stderr '^usage: --overlay ov-code: internal/desk/extra.go is not a design source of machinery.yaml at HEAD: '
exec mrun 2 -C proj assess --overlay ov-extra --out out
stderr '^usage: --overlay ov-extra: design/notes/why.md is not a design source of machinery.yaml at HEAD: '
exec mrun 2 -C proj assess --overlay ov-upper --out out
stderr '^usage: --overlay ov-upper: E2E/loans.sh differs from e2e of HEAD only by case; an overlay path is written as HEAD has it$'
exec mrun 2 -C proj assess --overlay ov-case --out out
stderr '^usage: --overlay ov-case: design/Risk-Links.yaml differs from design/risk-links.yaml of HEAD only by case; an overlay path is written as HEAD has it$'
exec mrun 2 -C proj assess --overlay ov-newcase --out out
stderr '^usage: --overlay ov-newcase: DESIGN/status.yaml differs from design of HEAD only by case; an overlay path is written as HEAD has it$'
mkdir ov-uni/design
exec sh -c 'f=$(printf "ov-uni/design/st\303\244tus.yaml"); printf "version: 1\n" > "$f"'
exec mrun 2 -C proj assess --overlay ov-uni --out out
stderr '^usage: --overlay ov-uni: design/st.*tus.yaml is not written in ASCII; an overlay path holds ASCII characters only$'
# the owed list, the native failure modes, a model: not overlay sources, whatever names them
exec mrun 2 -C proj assess --overlay ov-owed --out out
stderr '^usage: --overlay ov-owed: design/owed.yaml is not a design source of machinery.yaml at HEAD: '
exec mrun 2 -C proj assess --overlay ov-model --out out
stderr '^usage: --overlay ov-model: design/model/library.modelith.yaml is not a design source of machinery.yaml at HEAD: '
# a design source that a code or test glob of the config of the run matches: HEAD judges it a
# links file, and the overlaid config would have it read as a test
exec mrun 2 -C proj assess --overlay ov-run --out out
stderr '^usage: --overlay ov-run: design/risk-links.yaml is under trace.tests of --overlay machinery.yaml; an overlay never replaces what is read as code or tests$'
# and one that only a glob of the judge matches, which the overlaid config drops
mkdir proj2
cp head2.yaml proj2/machinery.yaml
cd proj2
gitinit
cd $WORK
exec mrun 2 -C proj2 assess --overlay ov-judge --out out
stderr '^usage: --overlay ov-judge: design/status.yaml is under constraints.size.paths of machinery.yaml at HEAD; an overlay never replaces what is read as code or tests$'
# a waiver is no overlay source either: an overlaid config carries none that HEAD lacks
exec mrun 2 -C proj assess --overlay ov-waiver --out out
stderr '^usage: --overlay ov-waiver: machinery.yaml carries the waiver \{rule: invoke-failure-mode, id: "invoke:hold_queue.sendNotice"\} that HEAD does not have; an overlay never adds a waiver \(commit it, or pass the config with --config\)$'
# a machinery.yaml at HEAD that cannot judge
mkdir proj3
cp bad-head.yaml proj3/machinery.yaml
cd proj3
gitinit
cd $WORK
exec mrun 2 -C proj3 assess --config other.yaml --overlay ov-status --out out
stderr '^config: machinery.yaml at HEAD, which judges the overlay: machinery.yaml: version must be 2$'
# the config of HEAD judges, never the one in the overlay: an overlaid config that names a
# test as a design source and drops the trace block admits nothing
exec mrun 2 -C proj assess --overlay ov-cfg --out out
stderr '^usage: --overlay ov-cfg: e2e/loans.sh is not a design source of machinery.yaml at HEAD: '
exec mrun 2 -C proj assess --overlay ov-git --out out
stderr '^usage: --overlay ov-git: .git/config: an overlay never writes under .git$'
exec mrun 2 -C proj assess --overlay ov-through --out out
stderr '^usage: --overlay ov-through: alias/risk-links.yaml: alias is a symbolic link at HEAD; an overlay never writes through or over a link$'
exec mrun 2 -C proj assess --overlay ov-over --out out
stderr '^usage: --overlay ov-over: alias: alias is a symbolic link at HEAD; an overlay never writes through or over a link$'
mkdir ov-link/design
symlink ov-link/design/risk-links.yaml -> ../../ov/design/risk-links.yaml
exec mrun 2 -C proj assess --overlay ov-link --out out
stderr '^usage: --overlay ov-link: design/risk-links.yaml is a symbolic link; an overlay holds regular files only$'
mkdir ov-dirlink
symlink ov-dirlink/design -> ../ov/design
exec mrun 2 -C proj assess --overlay ov-dirlink --out out
stderr '^usage: --overlay ov-dirlink: design is a symbolic link; an overlay holds regular files only$'
exec mrun 2 -C proj assess --overlay ov-badcfg --out out
stderr '^config: machinery.yaml: version must be 2$'
! exists out

# the overlay: a links file that leaves one row unlinked, a status file HEAD does not have, and the config
exec machinery -C proj assess --overlay ov --out out
stdout '^project: proj at [0-9a-f]{7}$'
stdout '^overlay: 3 file\(s\) laid over the snapshot; this is not the result of HEAD: design/risk-links.yaml, design/status.yaml, machinery.yaml$'
cmp out/snapshot/design/risk-links.yaml ov/design/risk-links.yaml
cmp out/snapshot/design/status.yaml ov/design/status.yaml
grep '^systems:$' out/snapshot/machinery.yaml

# the run is the run of the overlaid design: the fourth row is unlinked there, not at HEAD
grep '^checked: 4 failure modes, 3 linked, 1 unlinked, ' out/stages/xref-failure.txt
grep '^not demonstrated: 1 of 4 failure modes name no subject; ' out/stages/xref-failure.txt

# the report lists every overlaid file with its sha256
grep '^- config: --overlay machinery.yaml$' out/report.md
grep '^- overlay: 3 file\(s\) laid over the snapshot; this is not the result of HEAD$' out/report.md
exec sh -c 'grep -x "  - \`design/risk-links.yaml\` sha256 $(shasum -a 256 ov/design/risk-links.yaml | cut -c1-64)" out/report.md'
exec sh -c 'grep -x "  - \`design/status.yaml\` sha256 $(shasum -a 256 ov/design/status.yaml | cut -c1-64)" out/report.md'
exec sh -c 'grep -x "  - \`machinery.yaml\` sha256 $(shasum -a 256 ov/machinery.yaml | cut -c1-64)" out/report.md'
grep '^  "config": "--overlay machinery.yaml",$' out/report.json
grep '^  "overlay": \[$' out/report.json
grep '^      "path": "design/risk-links.yaml",$' out/report.json
exec sh -c 'grep -x "      \"sha256\": \"$(shasum -a 256 ov/design/risk-links.yaml | cut -c1-64)\"" out/report.json'
! grep $WORK out/report.json
! grep $WORK out/report.md

# an overlaid links file that names no subject links nothing: the assessment shows every row
# unlinked, never a passed stage
exec machinery -C proj assess --overlay ov-garbage --out out-garbage
grep '^checked: 4 failure modes, 0 linked, 4 unlinked, ' out-garbage/stages/xref-failure.txt
! grep '^passed$' out-garbage/stages/xref-failure.txt
grep '^\| xref-failure \| failed \| 4 failure modes, 0 linked, 4 unlinked, ' out-garbage/report.md

# nothing in the project changed, and the overlay was only read
exec sh -c 'cd proj && find . -type f | LC_ALL=C sort | xargs cksum > ../after.txt'
cmp before.txt after.txt
exec git -C proj status --porcelain
! stdout .
cmp ov/design/risk-links.yaml links.orig

-- other.yaml --
version: 2
-- links.orig --
version: 1
links:
  - {id: RISK-1, kind: abuse, subject: "act:Loan.lend", required: refuse}
  - {id: RISK-2, subject: "invoke:hold_queue.sendNotice", required: retry-bounded}
  - {id: RISK-3, subject: "state:loan.Lost", required: surface}
-- ov/design/risk-links.yaml --
version: 1
links:
  - {id: RISK-1, kind: abuse, subject: "act:Loan.lend", required: refuse}
  - {id: RISK-2, subject: "invoke:hold_queue.sendNotice", required: retry-bounded}
  - {id: RISK-3, subject: "state:loan.Lost", required: surface}
-- ov/design/status.yaml --
version: 1
-- ov-garbage/design/risk-links.yaml --
version: 1
links:
  - {ids: [RISK-1..RISK-4]}
-- ov-owed/design/owed.yaml --
version: 1
owed: []
-- ov-model/design/model/library.modelith.yaml --
kind: DomainModel
-- ov-run/design/risk-links.yaml --
version: 1
links: []
-- ov-run/machinery.yaml --
version: 2
scope: ["internal/**"]
design:
  models:
    - design/model/library.modelith.yaml
import:
  machines:
    files: ["machines/*.json"]
    states: capitalize
    rename:
      root: {notes: _comment, entity: _lifecycle_of, startable: _entries, from_outside: _external_events}
      state: {skip: _ignores}
      transition: {allowed: _requires, denied: _refusal}
    bind:
      hold_queue: {serves: ["entity:Loan"]}
  failure_modes:
    file: docs/risks.md
    id: "^RISK-[0-9]+$"
    columns:
      failure: ["Failure", "What goes wrong"]
      behavior: ["Required behavior", "Expected"]
    links: design/risk-links.yaml
trace:
  code: ["internal/**/*.go"]
  tests: ["e2e/**", "design/*-links.yaml"]
  markers:
    serves: ["Implements:"]
    verifies: ["Checks:", "Proves:"]
    scenarios: ["Scenario:"]
-- ov-waiver/machinery.yaml --
version: 2
scope: ["internal/**"]
design:
  models:
    - design/model/library.modelith.yaml
import:
  machines:
    files: ["machines/*.json"]
    states: capitalize
    rename:
      root: {notes: _comment, entity: _lifecycle_of, startable: _entries, from_outside: _external_events}
      state: {skip: _ignores}
      transition: {allowed: _requires, denied: _refusal}
    bind:
      hold_queue: {serves: ["entity:Loan"]}
  failure_modes:
    file: docs/risks.md
    id: "^RISK-[0-9]+$"
    columns:
      failure: ["Failure", "What goes wrong"]
      behavior: ["Required behavior", "Expected"]
    links: design/risk-links.yaml
trace:
  code: ["internal/**/*.go"]
  tests: ["e2e/**"]
  markers:
    serves: ["Implements:"]
    verifies: ["Checks:", "Proves:"]
    scenarios: ["Scenario:"]
waivers:
  - {rule: invoke-failure-mode, id: "invoke:hold_queue.sendNotice", reason: "the notice service is modeled next"}
-- head2.yaml --
version: 2
constraints:
  size:
    paths: ["design/**"]
    max_file_lines: 100
-- bad-head.yaml --
version: 1
-- ov-judge/machinery.yaml --
version: 2
-- ov-judge/design/status.yaml --
version: 1
-- ov-status/design/status.yaml --
version: 1
-- ov-extra/design/notes/why.md --
Why the fourth row is not linked yet.
-- ov-upper/E2E/loans.sh --
echo replaced
-- ov-case/design/Risk-Links.yaml --
version: 1
links: []
-- ov-newcase/DESIGN/status.yaml --
version: 1
-- ov-cfg/machinery.yaml --
version: 2
design:
  risk: e2e/loans.sh
-- ov-cfg/e2e/loans.sh --
echo replaced
-- ov/machinery.yaml --
version: 2
scope: ["internal/**"]
design:
  models:
    - design/model/library.modelith.yaml
import:
  machines:
    files: ["machines/*.json"]
    states: capitalize
    rename:
      root: {notes: _comment, entity: _lifecycle_of, startable: _entries, from_outside: _external_events}
      state: {skip: _ignores}
      transition: {allowed: _requires, denied: _refusal}
    bind:
      hold_queue: {serves: ["entity:Loan"]}
  failure_modes:
    file: docs/risks.md
    id: "^RISK-[0-9]+$"
    columns:
      failure: ["Failure", "What goes wrong"]
      behavior: ["Required behavior", "Expected"]
    links: design/risk-links.yaml
systems:
  - {name: reading-room}
trace:
  code: ["internal/**/*.go"]
  tests: ["e2e/**"]
  markers:
    serves: ["Implements:"]
    verifies: ["Checks:", "Proves:"]
    scenarios: ["Scenario:"]
-- ov-test/e2e/loans.sh --
echo replaced
-- ov-code/internal/desk/extra.go --
package desk
-- ov-git/.git/config --
[core]
-- ov-through/alias/risk-links.yaml --
version: 1
links: []
-- ov-over/alias --
not a link any more
-- ov-badcfg/machinery.yaml --
version: 1
