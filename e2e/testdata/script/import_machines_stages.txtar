# formal gen and the ratchet read an imported machine like a native one
fixture empty
cp native.yaml machinery.yaml
mkdir design/machines machines
cp shelf.machine.json design/machines/shelf_unit.machine.json
exec machinery gen
gitinit
exec git branch base

# moving the machines from design.machines to import.machines keeps stage machines on
cp import.yaml machinery.yaml
cp shelf.json machines/shelf.json
rm design/machines/shelf_unit.machine.json
exec machinery gen
exec machinery check --stage machines --stage ratchet --base base
! stdout 'stage disabled'
stdout 'checked: 1 machines, 2 states, 2 transitions'
gitcommit imported
exec git branch imported

# the formal skeleton names the machine by its id and the source file it comes from
exec machinery formal new shelving --tool tla --machine shelf_unit --area shelving
grep 'paths: \["machines/shelf.json"\]' design/formal/shelving.spec.yaml
exec machinery formal gen
exists design/formal/shelf_unit.tla
grep '---- MODULE shelf_unit ----' design/formal/shelf_unit.tla
grep 'Generated by machinery formal gen from machines/shelf.json' design/formal/shelf_unit.tla
grep '"Full"' design/formal/shelf_unit.tla

# dropping import.machines switches the stage off, and the error names the key of the base
cp none.yaml machinery.yaml
exec mrun 1 check --stage ratchet --base imported
stdout 'ERROR  ratchet: stage disabled: machines applied at imported and import.machines is gone now'

-- native.yaml --
version: 2
design:
  machines: design/machines
-- import.yaml --
version: 2
design:
  risk: design/risk.yaml
import:
  machines:
    files: ["machines/*.json"]
    states: capitalize
    rename:
      state: {skip: _ignores}
-- none.yaml --
version: 2
design:
  risk: design/risk.yaml
-- design/risk.yaml --
version: 1
areas:
  - name: shelving
    tier: critical
    why: "a shelf is either stocked or empty, never both"
    ids: ["tc:SHEL*"]
    questions: [ordering]
-- shelf.machine.json --
{
  "id": "shelf_unit",
  "_role": "operational",
  "initial": "Empty",
  "states": {
    "Empty": {
      "on": {"stock": {"target": "Full"}},
      "_ignores": {"clear": "nothing to clear"}
    },
    "Full": {
      "on": {"clear": {"target": "Empty"}},
      "_ignores": {"stock": "already stocked"}
    }
  }
}
-- shelf.json --
{
  "id": "shelf-unit",
  "initial": "empty",
  "states": {
    "empty": {
      "on": {"stock": {"target": "full"}},
      "skip": {"clear": "nothing to clear"}
    },
    "full": {
      "on": {"clear": {"target": "empty"}},
      "skip": {"stock": "already stocked"}
    }
  }
}
