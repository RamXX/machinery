# the new annotations and the failure tag leave a machine loadable by the real XState package as written
fixture shop
exec sh -c 'printf "tools:\n  xstate: true\n" >> machinery.yaml'
cp annotated.json design/machines/Order.machine.json
exec machinery lint --stage machines --stage xstate
stdout '(?s)== machines ==\nchecked: 1 machines, 6 states, 15 transitions\npassed\n'
stdout '(?s)== xstate ==\nchecked: 1 machines, 12 cases\npassed\n'
! stdout 'ERROR'
stdout 'machinery lint: 2 passed, 0 failed, 0 not demonstrated, 0 not applicable'

-- annotated.json --
{
  "_comment": "Order lifecycle. Domain states mirror the OrderStatus enum; `paying` is the transient overlay around the payment call.",
  "_delays": {
    "payTimeout": "5000 ms - upper bound on the payment provider call"
  },
  "id": "order",
  "initial": "Pending",
  "context": {
    "orderId": null,
    "lastError": null
  },
  "states": {
    "Pending": {
      "on": {
        "pay": [
          {
            "target": "paying",
            "guard": "hasPaymentMethod",
            "actions": "stampAttempt"
          },
          {
            "actions": "recordPayRefused"
          }
        ],
        "cancel": {
          "target": "Cancelled",
          "actions": "recordCancellation",
          "_requires": [
            "Customer",
            "Clerk"
          ]
        },
        "providerDown": {
          "actions": "recordOutage"
        }
      },
      "_ignores": {
        "ship": "an unpaid order cannot ship; the API refuses with ORDER_NOT_PAID"
      }
    },
    "paying": {
      "invoke": {
        "src": "chargePayment",
        "onDone": {
          "target": "Paid",
          "actions": "recordCharge"
        },
        "onError": {
          "target": "PaymentFailed",
          "actions": "recordPaymentFailure",
          "_requires": [
            "system/payments"
          ]
        }
      },
      "after": {
        "payTimeout": {
          "target": "Pending",
          "actions": "recordPaymentTimeout"
        }
      }
    },
    "PaymentFailed": {
      "tags": "failure",
      "on": {
        "pay": [
          {
            "target": "paying",
            "guard": "hasPaymentMethod",
            "actions": "stampAttempt"
          },
          {
            "actions": "recordPayRefused"
          }
        ],
        "cancel": {
          "target": "Cancelled",
          "actions": "recordCancellation"
        }
      },
      "_ignores": {
        "ship": "an unpaid order cannot ship; the API refuses with ORDER_NOT_PAID",
        "providerDown": "no charge is in flight"
      }
    },
    "Paid": {
      "on": {
        "ship": {
          "target": "Shipped",
          "actions": "recordShipment"
        },
        "cancel": {
          "target": "Cancelled",
          "actions": [
            "refundPayment",
            "recordCancellation"
          ]
        }
      },
      "_ignores": {
        "pay": "already paid; a repeated pay is refused with ORDER_ALREADY_PAID",
        "providerDown": "the order is paid; an outage does not change it"
      }
    },
    "Shipped": {
      "type": "final",
      "entry": "notifyCustomer"
    },
    "Cancelled": {
      "_terminal": "a cancelled order is kept for audit; every later request is refused with ORDER_CANCELLED",
      "on": {
        "pay": {
          "actions": "recordRefusal"
        },
        "ship": {
          "actions": "recordRefusal"
        },
        "cancel": {
          "actions": "recordRefusal"
        }
      },
      "_ignores": {
        "providerDown": "nothing is charged any more"
      }
    }
  },
  "_entries": [
    "Paid"
  ],
  "_failure_events": [
    "providerDown"
  ]
}
