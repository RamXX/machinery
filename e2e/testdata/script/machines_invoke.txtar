# every invoke has onError and a timeout
fixture shop

# every invoke has onError
cp no_onerror.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: invoke ''chargePayment'' in paying has no onError$'
stdout '^failed: 1 finding\(s\)$'
stdout '^checked: 1 machines, 5 states, 7 transitions$'

# every invoking state has a timeout
cp no_after.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: invoking state paying has no after/timeout$'
stdout '^  ERROR  design/machines/Order\.machine\.json: _delays declares ''payTimeout'' but no after edge consumes it; a declared cadence nothing implements is not a bound \(wire it to an after, or drop it\)$'
stdout '^failed: 2 finding\(s\)$'
stdout '^checked: 1 machines, 5 states, 7 transitions$'

# an empty after block declares no timeout
cp empty_after.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: invoking state paying has an empty after block \(a timeout delay is required; after: \{\} declares nothing\)$'
stdout '^  ERROR  design/machines/Order\.machine\.json: _delays declares ''payTimeout'' but no after edge consumes it; a declared cadence nothing implements is not a bound \(wire it to an after, or drop it\)$'
stdout '^failed: 2 finding\(s\)$'
stdout '^checked: 1 machines, 5 states, 7 transitions$'

# an invoke names its actor
cp no_src.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: invoke in paying has no src \(src is a mandatory string naming the invoked actor\)$'
stdout '^failed: 1 finding\(s\)$'
stdout '^checked: 1 machines, 5 states, 8 transitions$'

# each invoke of a list is held to the rule
cp second_actor.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: invoke ''sendReceipt'' in paying has no onError$'
stdout '^failed: 1 finding\(s\)$'
stdout '^checked: 1 machines, 5 states, 9 transitions$'

-- no_onerror.json --
{
  "_comment": "Order lifecycle. Domain states mirror the OrderStatus enum; `paying` is the transient overlay around the payment call.",
  "_delays": {
    "payTimeout": "5000 ms - upper bound on the payment provider call"
  },
  "id": "order",
  "initial": "Pending",
  "context": {
    "orderId": null,
    "lastError": null
  },
  "states": {
    "Pending": {
      "on": {
        "pay": [
          {
            "target": "paying",
            "guard": "hasPaymentMethod",
            "actions": "stampAttempt"
          },
          {
            "actions": "recordPayRefused"
          }
        ],
        "cancel": {
          "target": "Cancelled",
          "actions": "recordCancellation"
        }
      },
      "_ignores": {
        "ship": "an unpaid order cannot ship; the API refuses with ORDER_NOT_PAID"
      }
    },
    "paying": {
      "invoke": {
        "src": "chargePayment",
        "onDone": {
          "target": "Paid",
          "actions": "recordCharge"
        }
      },
      "after": {
        "payTimeout": {
          "target": "Pending",
          "actions": "recordPaymentTimeout"
        }
      }
    },
    "Paid": {
      "on": {
        "ship": {
          "target": "Shipped",
          "actions": "recordShipment"
        },
        "cancel": {
          "target": "Cancelled",
          "actions": [
            "refundPayment",
            "recordCancellation"
          ]
        }
      },
      "_ignores": {
        "pay": "already paid; a repeated pay is refused with ORDER_ALREADY_PAID"
      }
    },
    "Shipped": {
      "type": "final",
      "entry": "notifyCustomer"
    },
    "Cancelled": {
      "type": "final"
    }
  }
}
