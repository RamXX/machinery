# adopt and an existing machinery.yaml (docs/formats.md section 17.2): adopt adds to a key only
# where the key is absent (a block at the end of its mapping) or holds a block list (items after
# its last one), in the indentation and line endings of the file, and every byte that was there
# stays. Every other shape is refused before anything is written, exit 2, with the lines to add
# by hand
fixture brownfield
mkdir design/model design/machines
cp depot-model.yaml design/model/depot.modelith.yaml
cp shipment.json design/machines/Shipment.machine.json
cp courier.json design/machines/CourierRun.machine.json
cp team.yaml machinery.yaml
gitinit

# the two shapes, in a file written by hand: comments, blank lines, the spacing before a comment,
# the order of the keys and a flow list adopt does not add to stay as they were
exec machinery adopt --paths 'internal/billing/**'
stdout '^  machinery\.yaml  edit: scope \+internal/billing/\*\*; design\.machines \+design/machines; trace\.code \+internal/shipping/\*\*, internal/billing/\*\*; trace\.tests \+e2e/\*\*; tests\.baseline; unbound waivers: 1$'
exec machinery adopt --paths 'internal/billing/**' --write
exec sh -c 'sed -E "s/adoption \([0-9a-f]{7}\)/adoption (SHA)/" machinery.yaml > got.yaml'
cmp got.yaml want-team.yaml
exec machinery adopt --paths 'internal/billing/**' --write
stdout '^adopt: wrote 0 file\(s\)$'
# what adopt added is in the same shapes, so a later adopt adds to it
gitcommit adopted
exec machinery adopt --paths 'cmd/**' --write
grep '^  - "cmd/\*\*"$' machinery.yaml
grep '^    - "cmd/\*\*"$' machinery.yaml
exec machinery config

# a file written with \r\n and no line break at its end: every line adopt adds ends in \r\n
fixture brownfield crlf
cd crlf
exec printf 'version: 2\r\nscope:\r\n  - "internal/shipping/**"\r\ntools:\r\n  bd: /nonexistent'
cp stdout machinery.yaml
gitinit
exec machinery adopt --paths 'internal/billing/**' --write
exec printf 'version: 2\r\nscope:\r\n  - "internal/shipping/**"\r\n  - "internal/billing/**"\r\ntools:\r\n  bd: /nonexistent\r\ntests:\r\n  e2e:\r\n    - "e2e/**"\r\n  baseline: design/tests-baseline.yaml\r\n'
cp stdout want-crlf.yaml
cmp machinery.yaml want-crlf.yaml
exec machinery config
cd ..

# every other shape is refused, the dry run and --write alike, and nothing is written. An empty
# flow list over two lines (it crashed adopt once), with a comment inside, on one line, no value
# and ~: the waivers go by hand, as a block list
exec sh -c 'cat base.yaml crash.part > crash.yaml'
cp crash.yaml machinery.yaml
exec mrun 2 adopt
stderr '^config: machinery\.yaml: adopt adds to a key only where it is absent or holds a block list, and writes nothing: add these lines by hand, then run adopt again$'
stderr '^waivers: waivers is a flow list; as a block list under waivers:$'
stderr '^  - \{rule: entity-machine, id: "entity:Carrier", reason: "unbound at adoption \([0-9a-f]{7}\)"\}$'
stderr '^  - \{rule: machine-binding, id: "courierRun", reason: "unbound at adoption \([0-9a-f]{7}\)"\}$'
! stderr 'panic|goroutine'
exec mrun 2 adopt --write
cmp machinery.yaml crash.yaml
exec sh -c 'cat base.yaml comment.part > comment.yaml'
cp comment.yaml machinery.yaml
exec mrun 2 adopt --write
stderr '^config: machinery\.yaml: adopt adds to a key only where it is absent or holds a block list, and writes nothing: add these lines by hand, then run adopt again$'
stderr '^waivers: waivers is a flow list; as a block list under waivers:$'
stderr '^  - \{rule: entity-machine, id: "entity:Carrier", reason: "unbound at adoption \([0-9a-f]{7}\)"\}$'
stderr '^  - \{rule: machine-binding, id: "courierRun", reason: "unbound at adoption \([0-9a-f]{7}\)"\}$'
! stderr 'panic|goroutine'
cmp machinery.yaml comment.yaml
exec sh -c 'cat base.yaml empty.part > empty.yaml'
cp empty.yaml machinery.yaml
exec mrun 2 adopt
stderr '^config: machinery\.yaml: adopt adds to a key only where it is absent or holds a block list, and writes nothing: add these lines by hand, then run adopt again$'
stderr '^waivers: waivers is a flow list; as a block list under waivers:$'
stderr '^  - \{rule: entity-machine, id: "entity:Carrier", reason: "unbound at adoption \([0-9a-f]{7}\)"\}$'
stderr '^  - \{rule: machine-binding, id: "courierRun", reason: "unbound at adoption \([0-9a-f]{7}\)"\}$'
! stderr 'panic|goroutine'
exec sh -c 'cat base.yaml none.part > none.yaml'
cp none.yaml machinery.yaml
exec mrun 2 adopt --write
stderr '^config: machinery\.yaml: adopt adds to a key only where it is absent or holds a block list, and writes nothing: add these lines by hand, then run adopt again$'
stderr '^waivers: waivers has no value; as a block list under waivers:$'
stderr '^  - \{rule: entity-machine, id: "entity:Carrier", reason: "unbound at adoption \([0-9a-f]{7}\)"\}$'
stderr '^  - \{rule: machine-binding, id: "courierRun", reason: "unbound at adoption \([0-9a-f]{7}\)"\}$'
! stderr 'panic|goroutine'
cmp machinery.yaml none.yaml
exec sh -c 'cat base.yaml tilde.part > tilde.yaml'
cp tilde.yaml machinery.yaml
exec mrun 2 adopt
stderr '^config: machinery\.yaml: adopt adds to a key only where it is absent or holds a block list, and writes nothing: add these lines by hand, then run adopt again$'
stderr '^waivers: waivers holds the scalar ~; as a block list under waivers:$'
stderr '^  - \{rule: entity-machine, id: "entity:Carrier", reason: "unbound at adoption \([0-9a-f]{7}\)"\}$'
stderr '^  - \{rule: machine-binding, id: "courierRun", reason: "unbound at adoption \([0-9a-f]{7}\)"\}$'
! stderr 'panic|goroutine'

# a merge key at the top level that supplies waivers: a waivers key of adopt's would override it
exec sh -c 'cat base.yaml merge.part > merge.yaml'
cp merge.yaml machinery.yaml
exec mrun 2 adopt --write
stderr '^config: machinery\.yaml: adopt adds to a key only where it is absent or holds a block list, and writes nothing: add these lines by hand, then run adopt again$'
stderr '^waivers: the top level has a merge key \(<<\); at the top level:$'
stderr '^waivers:$'
stderr '^  - \{rule: machine-binding, id: "courierRun", reason: "unbound at adoption \([0-9a-f]{7}\)"\}$'
! stderr 'panic|goroutine'
! stderr 'entity:Carrier'
cmp machinery.yaml merge.yaml

# an anchor on a list adopt adds to, and an alias in the place of one
cp anchor.yaml machinery.yaml
exec mrun 2 adopt --paths 'internal/billing/**' --write
stderr '^config: machinery\.yaml: adopt adds to a key only where it is absent or holds a block list, and writes nothing: add these lines by hand, then run adopt again$'
stderr '^scope: scope has the anchor &s; as a block list under scope:$'
stderr '^  - "internal/billing/\*\*"$'
stderr '^trace\.code: trace\.code is the alias \*s; as a block list under trace\.code:$'
stderr '^    - "internal/billing/\*\*"$'
! stderr 'panic|goroutine'
cmp machinery.yaml anchor.yaml

# flow lists over several lines and on one, and a flow mapping adopt would add a key to
cp flow.yaml machinery.yaml
exec mrun 2 adopt --paths 'internal/billing/**'
stderr '^config: machinery\.yaml: adopt adds to a key only where it is absent or holds a block list, and writes nothing: add these lines by hand, then run adopt again$'
stderr '^scope: scope is a flow list; as a block list under scope:$'
stderr '^  - "internal/billing/\*\*"$'
stderr '^trace\.code: trace\.code is a flow list; as a block list under trace\.code:$'
stderr '^    - "internal/billing/\*\*"$'
! stderr 'panic|goroutine'
cp tests.yaml machinery.yaml
exec mrun 2 adopt
stderr '^config: machinery\.yaml: adopt adds to a key only where it is absent or holds a block list, and writes nothing: add these lines by hand, then run adopt again$'
stderr '^tests\.baseline: tests is a flow mapping; under tests:$'
stderr '^  baseline: design/tests-baseline\.yaml$'
! stderr 'panic|goroutine'

# a literal block written last, in a file without a line break at its end: an item after it would
# change its value
exec sh -c 'cat base.yaml literal.part > literal.txt; printf %s "$(cat literal.txt)" > literal.yaml'
cp literal.yaml machinery.yaml
exec mrun 2 adopt --write
stderr '^config: machinery\.yaml: adopt adds to a key only where it is absent or holds a block list, and writes nothing: add these lines by hand, then run adopt again$'
stderr '^waivers: a block scalar ends waivers, and an addition after it would change its value; as a block list under waivers:$'
stderr '^  - \{rule: machine-binding, id: "courierRun", reason: "unbound at adoption \([0-9a-f]{7}\)"\}$'
! stderr 'panic|goroutine'
cmp machinery.yaml literal.yaml

# more than one YAML document
exec sh -c 'cat base.yaml docs.part > docs.yaml'
cp docs.yaml machinery.yaml
exec mrun 2 adopt
stderr '^config: machinery\.yaml: adopt adds to a key only where it is absent or holds a block list, and writes nothing: add these lines by hand, then run adopt again$'
stderr '^waivers: the file holds more than one YAML document; as a block list under waivers:$'
stderr '^  - \{rule: machine-binding, id: "courierRun", reason: "unbound at adoption \([0-9a-f]{7}\)"\}$'
! stderr 'panic|goroutine'

-- team.yaml --
# owned by the platform team: hand-edited

version: 2   # the format

# the riskiest area first
scope:
  - "internal/shipping/**"   # shipping only, for now

tests:
  e2e: ["e2e/**"]   # end-to-end tests only

tools:
  bd: /nonexistent    # no backlog here

design:
  models: [design/model/depot.modelith.yaml]   # the one model

waivers:
  # a waiver the team wrote
  - {rule: entity-machine, id: "entity:Carrier", reason: "carriers come later"}

# the end of the file
-- want-team.yaml --
# owned by the platform team: hand-edited

version: 2   # the format

# the riskiest area first
scope:
  - "internal/shipping/**"   # shipping only, for now
  - "internal/billing/**"

tests:
  e2e: ["e2e/**"]   # end-to-end tests only
  baseline: design/tests-baseline.yaml

tools:
  bd: /nonexistent    # no backlog here

design:
  models: [design/model/depot.modelith.yaml]   # the one model
  machines: design/machines

waivers:
  # a waiver the team wrote
  - {rule: entity-machine, id: "entity:Carrier", reason: "carriers come later"}
  - {rule: machine-binding, id: "courierRun", reason: "unbound at adoption (SHA)"}

# the end of the file
trace:
  code:
    - "internal/shipping/**"
    - "internal/billing/**"
  tests:
    - "e2e/**"
-- base.yaml --
version: 2
scope:
  - "internal/shipping/**"
tools:
  bd: /nonexistent
tests:
  e2e:
    - "e2e/**"
  baseline: design/tests-baseline.yaml
design:
  models:
    - design/model/depot.modelith.yaml
  machines: design/machines
trace:
  code:
    - "internal/shipping/**"
  tests:
    - "e2e/**"
-- crash.part --
waivers: [
]
-- comment.part --
waivers: [  # none yet
]
-- empty.part --
waivers: []
-- none.part --
waivers:
-- tilde.part --
waivers: ~
-- merge.part --
<<: {waivers: [{rule: entity-machine, id: "entity:Carrier", reason: "carriers come later"}]}
-- literal.part --
waivers:
  - rule: entity-machine
    id: "entity:Carrier"
    reason: |
      carriers come later
      and so does their lifecycle
-- docs.part --
waivers:
  - {rule: entity-machine, id: "entity:Carrier", reason: "carriers come later"}
---
notes: a second document
-- anchor.yaml --
version: 2
scope: &s
  - "internal/shipping/**"
tools:
  bd: /nonexistent
tests:
  e2e:
    - "e2e/**"
  baseline: design/tests-baseline.yaml
design:
  models:
    - design/model/depot.modelith.yaml
  machines: design/machines
trace:
  code: *s
  tests:
    - "e2e/**"
waivers:
  - {rule: entity-machine, id: "entity:Carrier", reason: "carriers come later"}
  - {rule: machine-binding, id: "courierRun", reason: "it binds later"}
-- flow.yaml --
version: 2
scope: [
  "internal/shipping/**",
]
tools:
  bd: /nonexistent
tests:
  e2e:
    - "e2e/**"
  baseline: design/tests-baseline.yaml
design:
  models:
    - design/model/depot.modelith.yaml
  machines: design/machines
trace:
  code: ["internal/shipping/**"]   # the code
  tests:
    - "e2e/**"
waivers:
  - {rule: entity-machine, id: "entity:Carrier", reason: "carriers come later"}
  - {rule: machine-binding, id: "courierRun", reason: "it binds later"}
-- tests.yaml --
version: 2
scope:
  - "internal/shipping/**"
tools:
  bd: /nonexistent
tests: {e2e: ["e2e/**"]}
design:
  models:
    - design/model/depot.modelith.yaml
  machines: design/machines
trace:
  code:
    - "internal/shipping/**"
  tests:
    - "e2e/**"
waivers:
  - {rule: entity-machine, id: "entity:Carrier", reason: "carriers come later"}
  - {rule: machine-binding, id: "courierRun", reason: "it binds later"}
-- depot-model.yaml --
kind: DomainModel
version: v1
title: Depot
enums:
  ShipmentStatus:
    values:
      - {name: Created, definition: "Registered, not yet packed."}
      - {name: Packed, definition: "Packed; terminal here."}
      - {name: Cancelled, definition: "Abandoned; terminal."}
entities:
  Shipment:
    definition: "One parcel moving through the depot."
    attributes:
      - {name: status, type: ShipmentStatus}
    actions:
      - {name: pack, actor: Warehouse}
      - {name: cancel, actor: Warehouse}
  Carrier:
    definition: "A company that moves parcels."
    attributes:
      - {name: name, type: string}
    actions:
      - {name: onboard, actor: Warehouse}
-- shipment.json --
{
  "id": "shipment",
  "initial": "Created",
  "states": {
    "Created": {"on": {"pack": {"target": "Packed"}, "cancel": {"target": "Cancelled"}}},
    "Packed": {"type": "final"},
    "Cancelled": {"type": "final"}
  }
}
-- courier.json --
{
  "id": "courierRun",
  "_role": "operational",
  "initial": "Waiting",
  "states": {
    "Waiting": {"on": {"pickUp": {"target": "Driving"}}, "_ignores": {"dropOff": "nothing is picked up yet"}},
    "Driving": {"on": {"dropOff": {"target": "Waiting"}}, "_ignores": {"pickUp": "already carrying a load"}}
  }
}
