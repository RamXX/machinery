# reachability, dead ends, absorbing states, cycles
fixture shop

# a state nothing enters
cp unreachable.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: unreachable state Orphan$'
stdout '^failed: 1 finding\(s\)$'
stdout '^checked: 1 machines, 6 states, 8 transitions$'

# a non-final leaf with no transition
cp dead_end.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: dead-end non-final leaf state stuck$'
stdout '^failed: 1 finding\(s\)$'
stdout '^checked: 1 machines, 6 states, 8 transitions$'

# transitions exist but none leaves the state
cp absorbing.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: absorbing non-final leaf state stuck \(transitions exist but none leaves the state; add an exiting transition or make it final\)$'
stdout '^failed: 1 finding\(s\)$'
stdout '^checked: 1 machines, 6 states, 9 transitions$'

# a final state cannot have transitions
cp final_transitions.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: final state Cancelled declares transitions or an invoke; XState ignores them, so they are dead spec$'
stdout '^failed: 1 finding\(s\)$'
stdout '^checked: 1 machines, 5 states, 9 transitions$'

# a compound state needs an initial
cp no_initial.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: compound state Paid has no initial$'
stdout '^failed: 1 finding\(s\)$'
stdout '^checked: 1 machines, 6 states, 8 transitions$'

# onDone on a state with no children never fires
cp ondone_atomic.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: state Paid has onDone but no child states \(onDone fires when a compound state reaches a final child; this one never fires\)$'
stdout '^failed: 1 finding\(s\)$'
stdout '^checked: 1 machines, 5 states, 9 transitions$'

# unguarded always transitions that loop
cp always_cycle.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: unguarded always cycle a -> b -> a \(eventless transitions with no guard re-fire forever\)$'
stdout '^failed: 1 finding\(s\)$'
stdout '^checked: 1 machines, 7 states, 10 transitions$'

# the initial state is a top-level state
cp bad_initial.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: initial ''Nope'' is not a top-level state$'
stdout '^failed: 1 finding\(s\)$'

# a machine has states
cp no_states.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: machine has no states$'
stdout '^failed: 1 finding\(s\)$'
stdout '^checked: 1 machines, 0 states, 0 transitions$'

-- unreachable.json --
{
  "_comment": "Order lifecycle. Domain states mirror the OrderStatus enum; `paying` is the transient overlay around the payment call.",
  "_delays": {
    "payTimeout": "5000 ms - upper bound on the payment provider call"
  },
  "id": "order",
  "initial": "Pending",
  "context": {
    "orderId": null,
    "lastError": null
  },
  "states": {
    "Pending": {
      "on": {
        "pay": [
          {
            "target": "paying",
            "guard": "hasPaymentMethod",
            "actions": "stampAttempt"
          },
          {
            "actions": "recordPayRefused"
          }
        ],
        "cancel": {
          "target": "Cancelled",
          "actions": "recordCancellation"
        }
      },
      "_ignores": {
        "ship": "an unpaid order cannot ship; the API refuses with ORDER_NOT_PAID"
      }
    },
    "paying": {
      "invoke": {
        "src": "chargePayment",
        "onDone": {
          "target": "Paid",
          "actions": "recordCharge"
        },
        "onError": {
          "target": "Pending",
          "actions": "recordPaymentFailure"
        }
      },
      "after": {
        "payTimeout": {
          "target": "Pending",
          "actions": "recordPaymentTimeout"
        }
      }
    },
    "Paid": {
      "on": {
        "ship": {
          "target": "Shipped",
          "actions": "recordShipment"
        },
        "cancel": {
          "target": "Cancelled",
          "actions": [
            "refundPayment",
            "recordCancellation"
          ]
        }
      },
      "_ignores": {
        "pay": "already paid; a repeated pay is refused with ORDER_ALREADY_PAID"
      }
    },
    "Shipped": {
      "type": "final",
      "entry": "notifyCustomer"
    },
    "Cancelled": {
      "type": "final"
    },
    "Orphan": {
      "type": "final"
    }
  }
}
