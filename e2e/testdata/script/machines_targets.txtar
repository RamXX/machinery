# strict target resolution and state ids
fixture shop

# a #id.path target resolves
cp sibling_ok.json design/machines/Order.machine.json
exec machinery lint --stage machines
stdout '^checked: 1 machines, 5 states, 8 transitions$'
stdout '^passed$'

# a bare name resolves among siblings only
cp dangling.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: dangling target ''Canceled'' \(no sibling of Paid is named ''Canceled''\) from Paid \(on:cancel\)$'
stdout '^failed: 1 finding\(s\)$'

# .child targets are outside the subset
cp relative.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: relative target ''\.Cancelled'' is outside the supported subset \(use a sibling name or #id\.path\.to\.state\) from Pending \(on:cancel\)$'
stdout '^failed: 1 finding\(s\)$'

# a dotted target needs the # form
cp dotted.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: dangling target ''order\.Cancelled'' \(dotted targets must use the #id\.path\.to\.state form\) from Pending \(on:cancel\)$'
stdout '^failed: 1 finding\(s\)$'

# every segment after the id must exist
cp bad_child.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: dangling target ''#order\.Nope'' \(the machine root has no child state ''Nope''\) from Pending \(on:cancel\)$'
stdout '^failed: 1 finding\(s\)$'

# the head must be the machine id or a declared state id
cp bad_head.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: dangling target ''#nosuch'' \(''nosuch'' is neither the machine id nor a declared state id\) from Pending \(on:cancel\)$'
stdout '^failed: 1 finding\(s\)$'

# a bare name never falls back to a cousin
cp cousin.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: dangling target ''Shipped'' \(no sibling of Paid\.Settled is named ''Shipped''\) from Paid\.Settled \(on:ship\)$'
stdout '^  ERROR  design/machines/Order\.machine\.json: unreachable state Shipped$'
stdout '^failed: 2 finding\(s\)$'
stdout '^checked: 1 machines, 6 states, 8 transitions$'

# state ids must be identifiers
cp id_pattern.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: state Paid id ''my-id'' is not a valid identifier \(a dotted or symbolic id can never be referenced by #id\.path\)$'
stdout '^failed: 1 finding\(s\)$'

# state ids are unique
cp id_duplicate.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: duplicate state id ''x'' \(declared on Pending and Paid\)$'
stdout '^failed: 1 finding\(s\)$'

# a state id cannot be the machine id
cp id_machine.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: state Paid id ''order'' collides with the machine id$'
stdout '^failed: 1 finding\(s\)$'

# a declared state id is a valid head
cp id_ref.json design/machines/Order.machine.json
exec machinery lint --stage machines
stdout '^checked: 1 machines, 5 states, 8 transitions$'
stdout '^passed$'

-- sibling_ok.json --
{
  "_comment": "Order lifecycle. Domain states mirror the OrderStatus enum; `paying` is the transient overlay around the payment call.",
  "_delays": {
    "payTimeout": "5000 ms - upper bound on the payment provider call"
  },
  "id": "order",
  "initial": "Pending",
  "context": {
    "orderId": null,
    "lastError": null
  },
  "states": {
    "Pending": {
      "on": {
        "pay": [
          {
            "target": "paying",
            "guard": "hasPaymentMethod",
            "actions": "stampAttempt"
          },
          {
            "actions": "recordPayRefused"
          }
        ],
        "cancel": {
          "target": "#order.Cancelled",
          "actions": "recordCancellation"
        }
      },
      "_ignores": {
        "ship": "an unpaid order cannot ship; the API refuses with ORDER_NOT_PAID"
      }
    },
    "paying": {
      "invoke": {
        "src": "chargePayment",
        "onDone": {
          "target": "Paid",
          "actions": "recordCharge"
        },
        "onError": {
          "target": "Pending",
          "actions": "recordPaymentFailure"
        }
      },
      "after": {
        "payTimeout": {
          "target": "Pending",
          "actions": "recordPaymentTimeout"
        }
      }
    },
    "Paid": {
      "on": {
        "ship": {
          "target": "Shipped",
          "actions": "recordShipment"
        },
        "cancel": {
          "target": "Cancelled",
          "actions": [
            "refundPayment",
            "recordCancellation"
          ]
        }
      },
      "_ignores": {
        "pay": "already paid; a repeated pay is refused with ORDER_ALREADY_PAID"
      }
    },
    "Shipped": {
      "type": "final",
      "entry": "notifyCustomer"
    },
    "Cancelled": {
      "type": "final"
    }
  }
}
