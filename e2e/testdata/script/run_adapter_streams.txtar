# a suite run through a wrapper that stages the tests and starts go test itself, twice:
# machinery reads the streams the wrapper left in MACHINERY_GO_TEST_JSON (section 10.3)
fixture shop
fixture shop-gotests
cp mapped.yaml machinery.yaml
exec machinery gen
gitinit

exec mrun 2 run --streams -- sh run-suite.sh
stderr '^usage: --streams needs --adapter go-test-json: add it before --streams$'

# two streams of one staged package, joined to the files under trace.tests through the map
exec machinery run --adapter go-test-json --streams -- sh run-suite.sh
stdout '^run-suite: 2 go test run\(s\), exit 0$'
stderr '^machinery run: adapter go-test-json: 2 stream\(s\), 1 package\(s\), 7 test function\(s\) with a verdict: 7 passed, 0 failed, 0 skipped$'
stderr '^machinery run: adapter: receipts written: 6 pass, 0 fail, 0 skip$'
stderr '^machinery run: adapter: claimed, not run: 0 id\(s\)$'
exec sh -c 'head -n 1 .machinery/receipts/*.jsonl'
stdout '"command":\["sh","run-suite.sh"\],"stack":"","started":"[^"]+","adapter":"go-test-json"\}$'
exec sh -c 'grep -h inv:paid-before-shipped .machinery/receipts/*.jsonl'
stdout '"test":"e2e/suite/order_test.go::TestShipNeedsPayment","observed":"go test: TestShipNeedsPayment passed","source":"adapter","granularity":"function","tags":"unknown"\}$'
# machinery did not see the flags the wrapper passed: the build tags are unknown, never []
exec sh -c '! grep -q "\"tags\":\\[" .machinery/receipts/*.jsonl'
exec sh -c 'grep -h fm:payment-provider-down .machinery/receipts/*.jsonl'
stdout '"outcome":"pass","test":"e2e/suite/outage_test.go"'
exec mrun 1 verify
stdout '^checked: 16 obligations, 6 proven, 3 by adapter at function granularity, 3 by adapter at file granularity, 0 partial, 2 owed, 6 receipts$'
stdout '^  ERROR  stale owed entry: fm:payment-provider-down is proven$'

# no stream: the command ran nothing the adapter can read. A file of another name is not read.
# The directory is machinery's own, it starts empty, and it is gone after the run
rm .machinery/receipts
env MACHINERY_GO_TEST_JSON=/nonexistent
exec machinery run --adapter go-test-json --streams -- sh -c 'ls -A "$MACHINERY_GO_TEST_JSON" | wc -l; echo "$MACHINERY_GO_TEST_JSON" > .machinery/dir.txt; echo notes > "$MACHINERY_GO_TEST_JSON/notes.txt"'
env MACHINERY_GO_TEST_JSON=
stdout '^ *0$'
stderr '^machinery run: adapter go-test-json: no stream in MACHINERY_GO_TEST_JSON: the command ran nothing the adapter can read, and nothing is proven$'
stderr '^machinery run: adapter: receipts written: 0 pass, 0 fail, 0 skip$'
stderr '^machinery run: adapter: claimed, not run: 6 id\(s\)$'
! grep nonexistent .machinery/dir.txt
exec sh -c 'test ! -e "$(cat .machinery/dir.txt)"'
exec mrun 1 verify
stdout '^checked: 16 obligations, 0 proven, 0 partial, 2 owed, 0 receipts$'

# machinery cannot add -count=1 to what a wrapper starts: a pass replayed from the cache counts
# nothing
rm .machinery/receipts
env SUITE_FLAGS=-short
exec machinery run --adapter go-test-json --streams -- sh run-suite.sh
exec machinery run --adapter go-test-json --streams -- sh run-suite.sh
env SUITE_FLAGS=
stderr '^machinery run: adapter: receipts written: 0 pass, 0 fail, 0 skip$'
stderr '^machinery run: adapter: claimed, verdict not counted: 5 id\(s\)$'
stderr '^machinery run: adapter: package example\.test/shop/stage/suite: answered from the cache; a pass replayed from the cache counts nothing: run go test with -count=1$'
exec sh -c '! grep -q "\"type\":\"receipt\"" "$(ls .machinery/receipts/*.jsonl | tail -n 1)"'

# one function with a pass in one stream and a skip in another: its verdicts differ, it failed
rm .machinery/receipts
exec machinery run --adapter go-test-json --streams -- sh twice.sh
stderr '^machinery run: adapter go-test-json: 2 stream\(s\), 1 package\(s\), 6 test function\(s\) with a verdict: 5 passed, 1 failed, 0 skipped$'
stderr '^machinery run: adapter: example\.test/shop/e2e/suite\.TestEmailUnique: pass in a\.json, skip in b\.json: verdicts differ, read as fail$'
stderr '^machinery run: adapter: receipts written: 4 pass, 1 fail, 0 skip$'
exec sh -c 'grep -h inv:customer-email-unique .machinery/receipts/*.jsonl'
stdout '"outcome":"fail","test":"e2e/suite/email_test.go::TestEmailUnique","observed":"go test: TestEmailUnique failed"'
exec mrun 1 verify
stdout '^  ERROR  failed: inv:customer-email-unique \(e2e/suite/email_test\.go::TestEmailUnique\)$'

# one package answered from the cache in one stream and run in another: the stream that ran it
# gives its passes, the cached one none
rm .machinery/receipts
exec machinery run --adapter go-test-json --streams -- sh cachedonce.sh
stdout '^cachedonce: 0 cached in the first stream, 1 in the second$'
stderr '^machinery run: adapter: receipts written: 5 pass, 0 fail, 0 skip$'
stderr '^machinery run: adapter: claimed, not run: 1 id\(s\)$'
! stderr 'verdict not counted'
stderr '^machinery run: adapter: package example\.test/shop/e2e/suite: answered from the cache; a pass replayed from the cache counts nothing: run go test with -count=1$'

# the verifier's case: a fresh stream where TestProviderDown fails, and a second stream answered
# from the cache. The fail is never lost: its fail receipt is written and verify fails the id
rm .machinery/receipts
exec machinery run --adapter go-test-json --streams -- sh cachedfail.sh
stdout '^cachedfail: 0 cached in a, 1 in b$'
stderr '^machinery run: adapter: package example\.test/shop/e2e/suite: answered from the cache; '
stderr '^machinery run: adapter: receipts written: 0 pass, 1 fail, 0 skip$'
exec sh -c 'grep -h fm:payment-provider-down .machinery/receipts/*.jsonl'
stdout '"outcome":"fail","test":"e2e/suite/outage_test\.go","observed":"go test: TestProviderDown failed"'
exec mrun 1 verify
stdout '^  ERROR  failed: fm:payment-provider-down \(e2e/suite/outage_test\.go\)$'
exec machinery status
stdout '  failed: 1  '

# one function with two verdicts in one stream (the wrapper ran it twice): they differ, it failed
rm .machinery/receipts
exec machinery run --adapter go-test-json --streams -- sh again.sh
stderr '^machinery run: adapter: example\.test/shop/e2e/again\.TestSettlesOnce: pass in again\.json, skip in again\.json: verdicts differ, read as fail$'
stderr '^machinery run: adapter: receipts written: 0 pass, 1 fail, 0 skip$'
exec sh -c 'grep -h "\"type\":\"receipt\"" .machinery/receipts/*.jsonl'
stdout '"id":"inv:terminal-is-final","outcome":"fail","test":"e2e/again/again_test.go::TestSettlesOnce"'

# one file staged into two packages: a function whose verdicts differ between them failed
rm .machinery/receipts
env TWO_ENV=SHOP_EMAIL=skip
exec machinery run --adapter go-test-json --streams -- sh two.sh
stderr '^machinery run: adapter: e2e/suite/email_test\.go::TestEmailUnique: pass in package example\.test/shop/stage/a, skip in package example\.test/shop/stage/b: verdicts differ, read as fail$'
stderr '^machinery run: adapter: receipts written: 4 pass, 1 fail, 0 skip$'
# and with equal verdicts the worst of what each package gives stands: one of the two did not
# end with pass, so the passes of the other do not count
rm .machinery/receipts
env TWO_ENV=SHOP_ROUTING=fail
exec machinery run --adapter go-test-json --streams -- sh two.sh
env TWO_ENV=
stderr '^machinery run: adapter: receipts written: 0 pass, 0 fail, 0 skip$'
stderr '^machinery run: adapter: claimed, verdict not counted: 4 id\(s\)$'
stderr 'package example\.test/shop/stage/b: did not end with pass; no pass is written from it$'

# a test binary run directly under go tool test2json -p: read under the same rules
rm .machinery/receipts
exec machinery run --adapter go-test-json --streams -- sh direct.sh -p example.test/shop/e2e/suite
stderr '^machinery run: adapter go-test-json: 1 stream\(s\), 1 package\(s\), 6 test function\(s\) with a verdict: 6 passed, 0 failed, 0 skipped$'
stderr '^machinery run: adapter: receipts written: 5 pass, 0 fail, 0 skip$'
# its package did not end with pass: no pass from it
rm .machinery/receipts
env SHOP_ROUTING=fail
exec machinery run --adapter go-test-json --streams -- sh direct.sh -p example.test/shop/e2e/suite
env SHOP_ROUTING=
stderr '^machinery run: adapter: receipts written: 0 pass, 0 fail, 0 skip$'
stderr 'package example\.test/shop/e2e/suite: did not end with pass; no pass is written from it$'
# without -p its events name no package: the verdicts are used for nothing
rm .machinery/receipts
exec machinery run --adapter go-test-json --streams -- sh direct.sh
stderr '^machinery run: adapter go-test-json: 1 stream\(s\), 0 package\(s\), 0 test function\(s\) with a verdict: 0 passed, 0 failed, 0 skipped$'
stderr '^machinery run: adapter: receipts written: 0 pass, 0 fail, 0 skip$'
stderr '^machinery run: adapter: 6 verdict\(s\) name no package and are used for nothing: run the test binary under go tool test2json -p <import path>$'

# a file that is not a well-formed stream: the run is left incomplete and nothing of it counts
rm .machinery/receipts
exec mrun 1 run --adapter go-test-json --streams -- sh broken.sh
stderr '^machinery: run: stream 2-broken\.jsonl: line 2: not a go test -json event; the run is left incomplete: fix what writes the stream, delete the receipts file and run again$'
! stderr 'receipts written'
exec sh -c '! grep -q "\"type\":\"end\"" .machinery/receipts/*.jsonl'
exec sh -c '! grep -q "\"type\":\"receipt\"" .machinery/receipts/*.jsonl'
exec mrun 1 verify
stdout '^  ERROR  incomplete run: \.machinery/receipts/'
exec machinery status
stdout '^refused: \.machinery/receipts/.*: incomplete run$'
# the exit code of the command stands when it is not 0; a file without an event is no stream
rm .machinery/receipts
exec mrun 3 run --adapter go-test-json --streams -- sh -c ': > "$MACHINERY_GO_TEST_JSON/empty.json"; exit 3'
stderr '^machinery: run: stream empty\.json: no event; the run is left incomplete: fix what writes the stream, delete the receipts file and run again$'

# a same-named function in a mapped file that claims nothing: ambiguous, counts nothing. The
# claiming file was not built in this run, and machinery has no way to know
cp shadow_test.go e2e/suite/shadow_test.go
cp named.yaml machinery.yaml
gitcommit 'a second file defines the function'
rm .machinery/receipts
exec machinery run --adapter go-test-json --streams -- sh once.sh
stderr '^machinery run: adapter: example\.test/shop/e2e/suite\.TestProviderDown: defined in e2e/suite/outage_test\.go, e2e/suite/shadow_test\.go: ambiguous: a pass or a skip counts for none of them, a fail fails each; rename one of the functions$'
stderr '^machinery run: adapter: receipts written: 5 pass, 0 fail, 0 skip$'
exec sh -c '! grep -q fm:payment-provider-down .machinery/receipts/*.jsonl'

# the narrow entry of the verifier's case: only the claiming file is mapped. The shadow is not
# among the entry's files, but it is in the directory of one: the name is ambiguous, and the
# files of the directory that the entry does not name give their verdicts to no file
cp narrow.yaml machinery.yaml
gitcommit 'an entry that names only the claiming file'
rm .machinery/receipts
exec machinery run --adapter go-test-json --streams -- sh once.sh
stderr '^machinery run: adapter: example\.test/shop/e2e/suite\.TestProviderDown: defined in e2e/suite/outage_test\.go, e2e/suite/shadow_test\.go: ambiguous: '
stderr '^machinery run: adapter: receipts written: 0 pass, 0 fail, 0 skip$'
stderr '^machinery run: adapter: 6 test function\(s\) with a verdict are in no file under trace\.tests: package\(s\) example\.test/shop/e2e/suite; '
exec sh -c '! grep -q fm:payment-provider-down .machinery/receipts/*.jsonl'

# without an entry for its package a verdict finds no file, also in the package's own directory
rm e2e/suite/shadow_test.go
cp unmapped.yaml machinery.yaml
gitcommit 'no map'
exec machinery run --adapter go-test-json --streams -- sh once.sh
stderr '^machinery run: adapter: receipts written: 0 pass, 0 fail, 0 skip$'
stderr '^machinery run: adapter: 6 test function\(s\) with a verdict are in no file under trace\.tests: package\(s\) example\.test/shop/e2e/suite; with --streams a package.s verdicts go only to the files of its entry in evidence\.adapter\.sources: add one$'

-- once.sh --
#!/bin/sh
set -eu
go test -json -count=1 ./e2e/suite > "$MACHINERY_GO_TEST_JSON/once.json"
-- cachedonce.sh --
#!/bin/sh
# the same package twice without -count=1: the second answer comes from the cache
set -eu
SHOP_ROUTING="fresh-$$-$(date +%s)"
export SHOP_ROUTING
go test -json ./e2e/suite > "$MACHINERY_GO_TEST_JSON/a.json"
go test -json ./e2e/suite > "$MACHINERY_GO_TEST_JSON/b.json"
first=$(grep -c '(cached)' "$MACHINERY_GO_TEST_JSON/a.json" || true)
second=$(grep -c '(cached)' "$MACHINERY_GO_TEST_JSON/b.json" || true)
echo "cachedonce: $first cached in the first stream, $second in the second"
-- cachedfail.sh --
#!/bin/sh
# stream a runs the suite with the tests behind faults, and TestProviderDown fails; stream b
# asks only for TestPayThenShip, which the first command left in the cache
set -u
go test -json -run TestPayThenShip ./e2e/suite > /dev/null
SHOP_OUTAGE=fail go test -json -count=1 -tags faults ./e2e/suite > "$MACHINERY_GO_TEST_JSON/a.json"
go test -json -run TestPayThenShip ./e2e/suite > "$MACHINERY_GO_TEST_JSON/b.json"
first=$(grep -c '(cached)' "$MACHINERY_GO_TEST_JSON/a.json")
second=$(grep -c '(cached)' "$MACHINERY_GO_TEST_JSON/b.json")
echo "cachedfail: $first cached in a, $second in b"
exit 0
-- again.sh --
#!/bin/sh
set -eu
go test -json -count=2 ./e2e/again > "$MACHINERY_GO_TEST_JSON/again.json"
-- two.sh --
#!/bin/sh
# stages the suite into two packages and tests each; TWO_ENV is set for the second
set -u
rm -rf stage
mkdir -p stage/a stage/b
cp e2e/suite/order_test.go e2e/suite/email_test.go e2e/suite/scenario_test.go stage/a/
cp e2e/suite/order_test.go e2e/suite/email_test.go e2e/suite/scenario_test.go stage/b/
go test -json -count=1 ./stage/a > "$MACHINERY_GO_TEST_JSON/a.json"
env ${TWO_ENV:-X=} go test -json -count=1 ./stage/b > "$MACHINERY_GO_TEST_JSON/b.json"
rm -rf stage
exit 0
-- e2e/again/again_test.go --
package again

import "testing"

var settled int

// TestSettlesOnce passes the first time it runs in a process and is skipped after that.
//
// machinery:verifies inv:terminal-is-final
func TestSettlesOnce(t *testing.T) {
	settled++
	if settled > 1 {
		t.Skip("already settled")
	}
}
-- shadow_test.go --
//go:build !faults

package suite

import "testing"

func TestProviderDown(t *testing.T) {}
-- twice.sh --
#!/bin/sh
# the same suite twice, the second time without a customer store
set -eu
go test -json -count=1 ./e2e/suite > "$MACHINERY_GO_TEST_JSON/a.json"
SHOP_EMAIL=skip go test -json -count=1 ./e2e/suite > "$MACHINERY_GO_TEST_JSON/b.json"
-- direct.sh --
#!/bin/sh
# builds the test binary and runs it itself, under go tool test2json
set -u
go test -c -o .machinery/suite.test ./e2e/suite || exit 1
go tool test2json "$@" .machinery/suite.test -test.v=test2json > "$MACHINERY_GO_TEST_JSON/direct.json"
exit 0
-- broken.sh --
#!/bin/sh
set -eu
go test -json -count=1 ./e2e/suite > "$MACHINERY_GO_TEST_JSON/1-good.json"
printf '{"Action":"start","Package":"example.test/shop/e2e/suite"}\nFAIL example.test/shop/e2e/suite\n' > "$MACHINERY_GO_TEST_JSON/2-broken.jsonl"
-- mapped.yaml --
version: 2
design:
  models:
    - design/model/shop.modelith.yaml
  machines: design/machines
  failure_modes: design/failure-modes.yaml
contracts:
  - kind: openapi
    path: contracts/openapi.yaml
trace:
  code: ["internal/**/*.go"]
  tests: ["e2e/**"]
evidence:
  adapter:
    sources:
      - package: "example.test/shop/stage/**"
        files: ["e2e/suite/*_test.go"]
      - package: "example.test/shop/e2e/suite"
        files: ["e2e/suite/*_test.go"]
      - package: "example.test/shop/e2e/again"
        files: ["e2e/again/*_test.go"]
constraints:
  layers:
    - {name: domain, paths: ["internal/domain/**"]}
    - {name: api, paths: ["internal/api/**"]}
  size:
    max_file_lines: 200
    max_func_lines: 40
waivers:
  - {rule: action-event, id: "act:Order.place", reason: "creation enters the initial state Pending"}
-- named.yaml --
version: 2
design:
  models:
    - design/model/shop.modelith.yaml
  machines: design/machines
  failure_modes: design/failure-modes.yaml
contracts:
  - kind: openapi
    path: contracts/openapi.yaml
trace:
  code: ["internal/**/*.go"]
  tests: ["e2e/suite/order_test.go", "e2e/suite/email_test.go", "e2e/suite/scenario_test.go", "e2e/suite/outage_test.go"]
evidence:
  adapter:
    sources:
      - package: "example.test/shop/e2e/suite"
        files: ["e2e/suite/*_test.go"]
constraints:
  layers:
    - {name: domain, paths: ["internal/domain/**"]}
    - {name: api, paths: ["internal/api/**"]}
  size:
    max_file_lines: 200
    max_func_lines: 40
waivers:
  - {rule: action-event, id: "act:Order.place", reason: "creation enters the initial state Pending"}
-- narrow.yaml --
version: 2
design:
  models:
    - design/model/shop.modelith.yaml
  machines: design/machines
  failure_modes: design/failure-modes.yaml
contracts:
  - kind: openapi
    path: contracts/openapi.yaml
trace:
  code: ["internal/**/*.go"]
  tests: ["e2e/suite/order_test.go", "e2e/suite/email_test.go", "e2e/suite/scenario_test.go", "e2e/suite/outage_test.go"]
evidence:
  adapter:
    sources:
      - package: "example.test/shop/e2e/suite"
        files: ["e2e/suite/outage_test.go"]
constraints:
  layers:
    - {name: domain, paths: ["internal/domain/**"]}
    - {name: api, paths: ["internal/api/**"]}
  size:
    max_file_lines: 200
    max_func_lines: 40
waivers:
  - {rule: action-event, id: "act:Order.place", reason: "creation enters the initial state Pending"}
-- unmapped.yaml --
version: 2
design:
  models:
    - design/model/shop.modelith.yaml
  machines: design/machines
  failure_modes: design/failure-modes.yaml
contracts:
  - kind: openapi
    path: contracts/openapi.yaml
trace:
  code: ["internal/**/*.go"]
  tests: ["e2e/**"]
constraints:
  layers:
    - {name: domain, paths: ["internal/domain/**"]}
    - {name: api, paths: ["internal/api/**"]}
  size:
    max_file_lines: 200
    max_func_lines: 40
waivers:
  - {rule: action-event, id: "act:Order.place", reason: "creation enters the initial state Pending"}
