# The plugin manifests are valid JSON and every path they name exists; their author is the
# project, never a person or an account; the agent surfaces stay small; the hooks only call
# machinery hook (docs/formats.md section 21).
exec node check.cjs $REPO
stdout 'manifests ok'
exec node hooks.cjs $REPO
stdout 'hooks ok'
exists $REPO/skills/machinery/SKILL.md
exists $REPO/agents/machinery-pm.md
exists $REPO/agents/machinery-verifier.md
exists $REPO/agents/machinery-modeler.md
exists $REPO/agents/machinery-builder.md
exists $REPO/agents/machinery-checker.md
exists $REPO/agents/machinery-delegate.md
exists $REPO/docs/roles.md
exists $REPO/hooks/hooks.json

# size limits of section 21
exec sh -c 'test $(wc -l < $REPO/skills/machinery/SKILL.md) -le 120'
exec sh -c 'for f in $REPO/agents/*.md; do test $(wc -l < $f) -le 60 || exit 1; done'
exec sh -c 'test $(wc -l < $REPO/docs/roles.md) -le 120'

# one prompt per role, and no vendor model in a prompt's frontmatter
exec sh -c 'test $(ls $REPO/agents | wc -l) -eq 6'
exec sh -c '! grep -l "^model:" $REPO/agents/*.md'

# the delegate is marked experimental
grep 'Experimental' $REPO/agents/machinery-delegate.md

# A release build reports the version declared by the manifests, even from an archive.
exec make -C $REPO build TOOLS=$WORK/release VERSION=2.0.0 BUILD_DATE=2026-01-02
exec $WORK/release/machinery --version
stdout '^machinery 2\.0\.0 \(([0-9a-f]{40}(-dirty)?|unknown), 2026-01-02\)$'

# every command the skill and the agent prompts name exists
exec machinery
cp stdout help.txt
exec node commands.cjs $REPO help.txt
stdout 'commands ok'

# and takes every flag they show with it
exec node flags.cjs $REPO help.txt
stdout 'flags ok'

# a flag the tool does not have is caught
mkdir bad/skills/machinery bad/agents
cp bad.md bad/agents/bad.md
cp $REPO/skills/machinery/SKILL.md bad/skills/machinery/SKILL.md
! exec node flags.cjs bad help.txt
stderr 'agents/bad.md: machinery waves has no flag --dispatch'

-- check.cjs --
const fs = require("fs");
const path = require("path");
const repo = process.argv[2];
const authors = {name: "The Machinery Authors", url: "https://github.com/RamXX/machinery"};
for (const f of [".claude-plugin/plugin.json", ".claude-plugin/marketplace.json", ".codex-plugin/plugin.json"]) {
  const m = JSON.parse(fs.readFileSync(path.join(repo, f), "utf8"));
  if (m.name !== "machinery") throw new Error(f + ": name");
  const who = m.author || m.owner;
  if (!who || who.name !== authors.name || who.url !== authors.url || Object.keys(who).length !== 2) throw new Error(f + ": author " + JSON.stringify(who));
  if (m.interface && m.interface.developerName !== authors.name) throw new Error(f + ": developerName " + m.interface.developerName);
  if (f.endsWith("plugin.json") && m.version !== "2.0.0") throw new Error(f + ": version");
  for (const k of ["skills", "agents"]) {
    if (m[k] && !fs.existsSync(path.join(repo, m[k]))) throw new Error(f + ": missing " + m[k]);
  }
  if (m.hooks) throw new Error(f + ": the plugin's hooks live in hooks/hooks.json, loaded without a manifest key");
}
console.log("manifests ok");
-- hooks.cjs --
const fs = require("fs");
const path = require("path");
const repo = process.argv[2];
const h = JSON.parse(fs.readFileSync(path.join(repo, "hooks/hooks.json"), "utf8")).hooks;
const want = {SessionStart: ["session-start", undefined], PreToolUse: ["pre-tool", "Bash"], Stop: ["stop", undefined]};
if (Object.keys(h).sort().join() !== Object.keys(want).sort().join()) throw new Error("events: " + Object.keys(h).join());
for (const [event, [arg, matcher]] of Object.entries(want)) {
  if (h[event].length !== 1) throw new Error(event + ": one matcher group");
  const g = h[event][0];
  if (g.matcher !== matcher) throw new Error(event + ": matcher " + g.matcher);
  if (g.hooks.length !== 1) throw new Error(event + ": one handler");
  const c = g.hooks[0];
  if (c.type !== "command" || c.command !== "machinery" || JSON.stringify(c.args) !== JSON.stringify(["hook", arg])) throw new Error(event + ": runs " + JSON.stringify(c));
}
console.log("hooks ok");
-- bad.md --
Then `machinery waves --dispatch`.
-- flags.cjs --
const fs = require("fs");
const path = require("path");
const {spawnSync} = require("child_process");
const repo = process.argv[2];
const help = fs.readFileSync(process.argv[3], "utf8");
const known = new Set();
for (const line of help.split("\n")) {
  const m = line.match(/^  ([a-z]+(?: [a-z]+)?) {2,}/);
  if (m) known.add(m[1]);
}
const flagsOf = {};
function flags(cmd) {
  if (!flagsOf[cmd]) {
    const r = spawnSync("machinery", [...cmd.split(" "), "--help"], {encoding: "utf8"});
    flagsOf[cmd] = new Set([...(r.stdout + r.stderr).matchAll(/^  -([a-z-]+)/gm)].map((m) => m[1]));
  }
  return flagsOf[cmd];
}
const files = ["skills/machinery/SKILL.md", ...fs.readdirSync(path.join(repo, "agents")).map((f) => "agents/" + f)];
let checked = 0;
for (const f of files) {
  // a line of a code block that ends in a backslash goes on in the next one
  const text = fs.readFileSync(path.join(repo, f), "utf8").replace(/\\\n\s*/g, " ");
  // a command is an inline code span, or a line of a code block, that starts with machinery
  const spans = [...text.matchAll(/`(machinery [^`]*)`/g)].map((m) => m[1].replace(/\s+/g, " "));
  for (const line of text.split("\n")) if (line.startsWith("machinery ")) spans.push(line);
  for (const s of spans) {
    const w = s.split(" ");
    const cmd = known.has(w[1] + " " + w[2]) ? w[1] + " " + w[2] : w[1];
    if (!known.has(cmd)) continue; // commands.cjs reports an unknown command
    const own = s.split(" -- ")[0]; // what follows -- belongs to the command machinery runs
    for (const m of own.matchAll(/(?:^| |\|)--([a-z-]+)/g)) {
      checked++;
      if (!flags(cmd).has(m[1])) {
        console.error(f + ": machinery " + cmd + " has no flag --" + m[1]);
        process.exit(1);
      }
    }
  }
}
if (checked < 30) throw new Error("too few flags found: " + checked);
console.log("flags ok");
-- commands.cjs --
const fs = require("fs");
const path = require("path");
const repo = process.argv[2];
const help = fs.readFileSync(process.argv[3], "utf8");
const known = new Set();
for (const line of help.split("\n")) {
  const m = line.match(/^  ([a-z]+(?: [a-z]+)?) {2,}/);
  if (m) known.add(m[1]);
}
const files = ["skills/machinery/SKILL.md", ...fs.readdirSync(path.join(repo, "agents")).map((f) => "agents/" + f)];
let checked = 0;
for (const f of files) {
  const text = fs.readFileSync(path.join(repo, f), "utf8");
  for (const m of text.matchAll(/`machinery ([a-z]+)(?: ([a-z]+))?/g)) {
    checked++;
    if (!known.has(m[1]) && !known.has(m[1] + " " + m[2])) throw new Error(f + ": unknown command machinery " + m[1] + " " + (m[2] || ""));
  }
}
if (checked < 20) throw new Error("too few commands found: " + checked);
console.log("commands ok");
