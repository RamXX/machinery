# _entries: the top-level states, besides initial, in which an instance may be created directly
fixture shop

# a state only an imported order starts in is unreachable without the annotation
cp no_entries.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^  ERROR  design/machines/Order\.machine\.json: unreachable state Legacy$'
stdout '^failed: 1 finding\(s\)$'

# reachability starts from every entry as well as from the initial state
cp valid.json design/machines/Order.machine.json
exec machinery lint --stage machines
stdout '^checked: 1 machines, 6 states, 10 transitions$'
stdout '^passed$'

# the runtime table carries the entries, sorted, after initial
exec machinery gen
grep '"initial": "Pending",\n  "entries": \[\n    "Legacy",\n    "Paid"\n  \],\n  "states": \[' design/gen/tables/order.table.json

# a machine without the annotation has no entries key
cp $REPO/e2e/testdata/fixtures/shop/design/machines/Order.machine.json design/machines/Order.machine.json
exec machinery gen
! grep '"entries"' design/gen/tables/order.table.json

# the annotation is a non-empty array
cp not_array.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^  ERROR  design/machines/Order\.machine\.json: _entries must be a non-empty array of top-level state names in which an instance may be created directly$'
stdout '^failed: 1 finding\(s\)$'
cp empty.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^  ERROR  design/machines/Order\.machine\.json: _entries must be a non-empty array of top-level state names in which an instance may be created directly$'
stdout '^failed: 1 finding\(s\)$'

# every item is a non-empty string
cp bad_items.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^  ERROR  design/machines/Order\.machine\.json: _entries items must be non-empty state-name strings$'
stdout '^failed: 2 finding\(s\)$'

# each names an existing top-level state
cp unknown.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^  ERROR  design/machines/Order\.machine\.json: _entries names ''Ghost'', which is not a top-level state$'
stdout '^failed: 1 finding\(s\)$'

# the initial state is not an entry: every instance may start there already
cp initial.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^  ERROR  design/machines/Order\.machine\.json: _entries names ''Pending'', the initial state; list only the other states an instance may be created in$'
stdout '^failed: 1 finding\(s\)$'

# no state is listed twice
cp duplicate.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^  ERROR  design/machines/Order\.machine\.json: _entries names ''Paid'' twice$'
stdout '^failed: 1 finding\(s\)$'

-- valid.json --
{
  "_comment": "Order lifecycle. Domain states mirror the OrderStatus enum; `paying` is the transient overlay around the payment call.",
  "_delays": {
    "payTimeout": "5000 ms - upper bound on the payment provider call"
  },
  "id": "order",
  "initial": "Pending",
  "context": {
    "orderId": null,
    "lastError": null
  },
  "states": {
    "Pending": {
      "on": {
        "pay": [
          {
            "target": "paying",
            "guard": "hasPaymentMethod",
            "actions": "stampAttempt"
          },
          {
            "actions": "recordPayRefused"
          }
        ],
        "cancel": {
          "target": "Cancelled",
          "actions": "recordCancellation"
        }
      },
      "_ignores": {
        "ship": "an unpaid order cannot ship; the API refuses with ORDER_NOT_PAID"
      }
    },
    "paying": {
      "invoke": {
        "src": "chargePayment",
        "onDone": {
          "target": "Paid",
          "actions": "recordCharge"
        },
        "onError": {
          "target": "Pending",
          "actions": "recordPaymentFailure"
        }
      },
      "after": {
        "payTimeout": {
          "target": "Pending",
          "actions": "recordPaymentTimeout"
        }
      }
    },
    "Paid": {
      "on": {
        "ship": {
          "target": "Shipped",
          "actions": "recordShipment"
        },
        "cancel": {
          "target": "Cancelled",
          "actions": [
            "refundPayment",
            "recordCancellation"
          ]
        }
      },
      "_ignores": {
        "pay": "already paid; a repeated pay is refused with ORDER_ALREADY_PAID"
      }
    },
    "Legacy": {
      "on": {
        "ship": {
          "target": "Shipped",
          "actions": "recordShipment"
        },
        "cancel": {
          "target": "Cancelled",
          "actions": "recordCancellation"
        }
      },
      "_ignores": {
        "pay": "a legacy order was paid in the old system; refused with ORDER_ALREADY_PAID"
      }
    },
    "Shipped": {
      "type": "final",
      "entry": "notifyCustomer"
    },
    "Cancelled": {
      "type": "final"
    }
  },
  "_entries": [
    "Paid",
    "Legacy"
  ]
}
