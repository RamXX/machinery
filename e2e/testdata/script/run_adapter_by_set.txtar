# a claiming file with no test function of its own that is a candidate file of a package of the
# run (a helper) is judged by its set: it is satisfied when, in one run, that package ended with
# pass and every test function of the package's candidate files passed. A set that did not run in
# full (a -run filter, a build tag) gives it nothing, a fail of the set fails it, and a helper
# that is a candidate of no package of any run cannot be judged. A marker directly above a
# function that is not a test function is a marker of its file (sections 10.3 and 12)
fixture shop
fixture shop-gotests
exec machinery gen
gitinit

# the whole set runs and passes: the helper is satisfied by its set, for its marker at file level
# and for the one above its helper function; the marker above a helper in a file with a test
# function is read at file level
exec machinery run --adapter go-test-json -- go test -tags faults ./e2e/suite
stderr '^machinery run: adapter: receipts written: 9 pass, 0 fail, 0 skip$'
stderr '^machinery run: adapter: e2e/suite/support_test\.go: no test function; its claims are judged by its set: every test function of package example\.test/shop/e2e/suite$'
! stderr 'the adapter does not judge [A-Za-z]+;'
stderr '^machinery run: adapter: in the whole project: 0 claimed id\(s\) not run, 1 claiming file\(s\) with no test function, 0 claim\(s\) above functions the adapter does not judge$'
exec sh -c 'grep -c "\"test\":\"e2e/suite/support_test.go\",\"observed\":\"go test: all 8 test function(s) of its set passed (package example.test/shop/e2e/suite) (subtests: 2)\",\"source\":\"adapter\",\"granularity\":\"file\"" .machinery/receipts/*.jsonl'
stdout '^2$'
exec sh -c 'grep -c "\"test\":\"e2e/suite/ship_helper_test.go\",\"observed\":\"go test: all 1 test function(s) of the file passed\"" .machinery/receipts/*.jsonl'
stdout '^1$'
exec sh -c 'tail -n 1 .machinery/receipts/*.jsonl'
stdout '"adapter_sets":\["e2e/suite/support_test.go"\]'
exec mrun 1 verify
! stdout 'partly run'
! stdout 'cannot be judged'
stdout '^  warn   by its set: inv:customer-email-unique: e2e/suite/support_test\.go: no test function of its own; every test function of its package passed in one run$'
stdout '^  warn   by its set: inv:terminal-is-final: e2e/suite/support_test\.go: no test function of its own; every test function of its package passed in one run$'
! stdout 'by its set: inv:paid-before-shipped'
exec machinery proof --ids inv:paid-before-shipped
stdout '^  inv:paid-before-shipped -> e2e/suite/order_test\.go::TestShipNeedsPayment -> pass: '

# a -run filter leaves the set without a verdict for some of its functions: the helper has no
# pass, and verify says it is judged by its set
rm .machinery/receipts
exec machinery run --adapter go-test-json -- go test -tags faults -run 'TestEmailUnique|TestCancelIsFinal|TestShipNeedsPayment' ./e2e/suite
exec sh -c '! grep -q "\"test\":\"e2e/suite/support_test.go\"" .machinery/receipts/*.jsonl'
exec mrun 1 verify
stdout '^  ERROR  partly run: inv:customer-email-unique: 1 of 2 claimants passed: '
stdout '^  warn   partly run: inv:customer-email-unique: no verdict: e2e/suite/support_test\.go \(by its set\)$'
stdout '^  warn   partly run: inv:paid-before-shipped: no verdict: e2e/suite/ship_helper_test\.go$'
! stdout 'by its set: inv:'
# the rest of the set in another run at the same commit does not make it whole: a set is judged
# in one run
exec machinery run --adapter go-test-json -- go test -tags faults -skip 'TestEmailUnique|TestCancelIsFinal|TestShipNeedsPayment' ./e2e/suite
exec sh -c '! grep -q "\"test\":\"e2e/suite/support_test.go\"" .machinery/receipts/*.jsonl'
exec mrun 1 verify
stdout '^  warn   partly run: inv:customer-email-unique: no verdict: e2e/suite/support_test\.go \(by its set\)$'

# so does a build tag that leaves a test function of the set out of the build
rm .machinery/receipts
exec machinery run --adapter go-test-json -- go test ./e2e/suite
exec mrun 1 verify
stdout '^  warn   partly run: inv:customer-email-unique: no verdict: e2e/suite/support_test\.go \(by its set\)$'

# a fail of the set fails the ids of the helper, also a fail of a test that claims nothing
rm .machinery/receipts
env SHOP_ROUTING=fail
exec mrun 1 run --adapter go-test-json -- go test -tags faults ./e2e/suite
env SHOP_ROUTING=
exec sh -c 'grep -c "\"outcome\":\"fail\",\"test\":\"e2e/suite/support_test.go\",\"observed\":\"go test: TestRouting of its set failed\"" .machinery/receipts/*.jsonl'
stdout '^2$'
exec mrun 1 verify
stdout '^  ERROR  failed: inv:customer-email-unique \(e2e/suite/support_test\.go\)$'
stdout '^  ERROR  failed: inv:terminal-is-final \(e2e/suite/support_test\.go\)$'

# a helper that is a candidate of no package of any run cannot be judged, and neither can one
# whose package has no test function at all
rm .machinery/receipts
mkdir e2e/lone
cp lone_test.go.txt e2e/lone/lone_test.go
gitcommit 'a helper in a package of its own'
exec machinery run --adapter go-test-json -- go test -tags faults ./e2e/suite
exec mrun 1 verify
stdout '^  warn   partly run: inv:paid-before-shipped: e2e/lone/lone_test\.go: cannot be judged by the adapter \(no test function\); '
exec machinery run --adapter go-test-json -- go test -tags faults ./e2e/lone
stderr '^machinery run: adapter: e2e/lone/lone_test\.go: no test function; its claims count nothing$'
exec mrun 1 verify
stdout '^  warn   partly run: inv:paid-before-shipped: e2e/lone/lone_test\.go: cannot be judged by the adapter \(no test function\); '
rm e2e/lone
gitcommit 'the lone helper is gone'

# a file with no test function that carries a build constraint is judged by no set, in any run
# and whatever the run built: go test may not have built it. A //go:build line whatever it says
# (here one the run satisfies, and one nothing satisfies), a // +build line, and a name with a
# _GOOS, _GOARCH or _GOOS_GOARCH suffix each keep it a claimant the adapter cannot judge, beside a
# set that passed in full and a helper without a constraint that it judges
rm .machinery/receipts
cp never_test.go.txt e2e/suite/never_test.go
cp faults_helper_test.go.txt e2e/suite/faults_helper_test.go
cp plusbuild_test.go.txt e2e/suite/plusbuild_test.go
cp helper_test.go.txt e2e/suite/helper_windows_test.go
cp helper_test.go.txt e2e/suite/helper_s390x_test.go
cp helper_test.go.txt e2e/suite/helper_plan9_386_test.go
gitcommit 'helpers that carry a build constraint'
exec machinery run --adapter go-test-json -- go test -tags faults ./e2e/suite
stderr '^machinery run: adapter: e2e/suite/support_test\.go: no test function; its claims are judged by its set: every test function of package example\.test/shop/e2e/suite$'
stderr '^machinery run: adapter: e2e/suite/never_test\.go: no test function; it carries a build constraint, so no set judges it: its claims count nothing$'
stderr '^machinery run: adapter: e2e/suite/faults_helper_test\.go: no test function; it carries a build constraint, so no set judges it: its claims count nothing$'
stderr '^machinery run: adapter: e2e/suite/plusbuild_test\.go: no test function; it carries a build constraint, so no set judges it: its claims count nothing$'
stderr '^machinery run: adapter: e2e/suite/helper_windows_test\.go: no test function; it carries a build constraint, so no set judges it: its claims count nothing$'
stderr '^machinery run: adapter: e2e/suite/helper_s390x_test\.go: no test function; it carries a build constraint, so no set judges it: its claims count nothing$'
stderr '^machinery run: adapter: e2e/suite/helper_plan9_386_test\.go: no test function; it carries a build constraint, so no set judges it: its claims count nothing$'
exec sh -c '! grep -E "\"test\":\"e2e/suite/(never|faults_helper|plusbuild|helper_[a-z0-9_]+)_test\.go\"" .machinery/receipts/*.jsonl'
exec sh -c 'tail -n 1 .machinery/receipts/*.jsonl'
stdout '"adapter_sets":\["e2e/suite/support_test.go"\]'
exec mrun 1 verify --partly
stdout '^  warn   by its set: inv:customer-email-unique: e2e/suite/support_test\.go: '
! stdout 'by its set: inv:[a-z-]+: e2e/suite/(never|faults_helper|plusbuild|helper_)'
stdout '^  ERROR  partly run: inv:customer-email-unique: 2 of 4 claimants passed: '
stdout '^  warn   partly run: inv:customer-email-unique: e2e/suite/never_test\.go: cannot be judged by the adapter \(it carries a build constraint: it may not have been built\); put the marker above a test function, emit a receipt from its own test, or give it an excused entry with a reason$'
stdout '^  warn   partly run: inv:customer-email-unique: e2e/suite/faults_helper_test\.go: cannot be judged by the adapter \(it carries a build constraint: it may not have been built\); '
stdout '^  warn   partly run: inv:terminal-is-final: e2e/suite/plusbuild_test\.go: cannot be judged by the adapter \(it carries a build constraint: it may not have been built\); '
stdout '^  warn   partly run: inv:paid-before-shipped: e2e/suite/helper_windows_test\.go: cannot be judged by the adapter \(it carries a build constraint: it may not have been built\); '
stdout '^  warn   partly run: inv:paid-before-shipped: e2e/suite/helper_s390x_test\.go: cannot be judged by the adapter \(it carries a build constraint: it may not have been built\); '
stdout '^  warn   partly run: inv:paid-before-shipped: e2e/suite/helper_plan9_386_test\.go: cannot be judged by the adapter \(it carries a build constraint: it may not have been built\); '
# verify judges a claimant as it is when it judges: a run made while a helper carried no
# constraint (here on a dirty tree, its //go:build line taken out) gave its set a pass for it,
# and once the line is back that pass credits nothing
rm .machinery/receipts
cp faults_helper_open.go.txt e2e/suite/faults_helper_test.go
exec machinery run --adapter go-test-json -- go test -tags faults ./e2e/suite
stderr '^machinery run: adapter: e2e/suite/faults_helper_test\.go: no test function; its claims are judged by its set: every test function of package example\.test/shop/e2e/suite$'
exec sh -c 'grep -c "\"test\":\"e2e/suite/faults_helper_test.go\",\"observed\":\"go test: all [0-9]* test function(s) of its set passed" .machinery/receipts/*.jsonl'
stdout '^1$'
exec git checkout -q e2e/suite/faults_helper_test.go
exec mrun 1 verify --allow-dirty --partly
stdout '^  warn   partly run: inv:customer-email-unique: e2e/suite/faults_helper_test\.go: cannot be judged by the adapter \(it carries a build constraint: it may not have been built\); '
! stdout 'by its set: inv:customer-email-unique: e2e/suite/faults_helper_test\.go'
rm e2e/suite/never_test.go e2e/suite/faults_helper_test.go e2e/suite/plusbuild_test.go
rm e2e/suite/helper_windows_test.go e2e/suite/helper_s390x_test.go e2e/suite/helper_plan9_386_test.go
gitcommit 'the constrained helpers are gone'

# with --streams a staged source with no test function that an entry maps to the package is a
# helper of its set too
rm .machinery/receipts
cp staged_support.go.txt e2e/suite/staged_support.go
cp sources.yaml machinery.yaml
gitcommit 'a staged helper, and the suite through a wrapper'
exec machinery run --adapter go-test-json --streams -- sh suite.sh
stderr '^machinery run: adapter: e2e/suite/staged_support\.go: no test function; its claims are judged by its set: every test function of package example\.test/shop/e2e/suite$'
exec mrun 1 verify
stdout '^  warn   by its set: inv:terminal-is-final: e2e/suite/staged_support\.go: no test function of its own; every test function of its package passed in one run$'
! stdout 'partly run: inv:terminal-is-final'

# a source that imports "C" carries a build constraint too: go leaves it out of a build with cgo
# off, as here, and the pass of its set says nothing of it
rm .machinery/receipts
cp cgo_support.go.txt e2e/suite/cgo_support.go
gitcommit 'a staged helper that uses cgo'
env CGO_ENABLED=0
exec machinery run --adapter go-test-json --streams -- sh suite.sh
env CGO_ENABLED=
stderr '^machinery run: adapter: e2e/suite/cgo_support\.go: no test function; it carries a build constraint, so no set judges it: its claims count nothing$'
exec sh -c '! grep -q "\"test\":\"e2e/suite/cgo_support.go\"" .machinery/receipts/*.jsonl'
exec mrun 1 verify --partly
stdout '^  warn   partly run: inv:paid-before-shipped: e2e/suite/cgo_support\.go: cannot be judged by the adapter \(it carries a build constraint: it may not have been built\); '
! stdout 'by its set: inv:paid-before-shipped: e2e/suite/cgo_support\.go'
rm e2e/suite/cgo_support.go
gitcommit 'the cgo helper is gone'

# a set is judged in each of its packages: one helper and two test files mapped to two packages,
# each built from copies of them. When both run every test function, the helper passes by the
# set of both; when the second runs only TestA, TestB has no verdict there, and the pass of TestB
# in the first package does not stand in for it: the helper gets nothing
rm .machinery/receipts
mkdir e2e/set
cp set_a_test.go.txt e2e/set/a_test.go
cp set_b_test.go.txt e2e/set/b_test.go
cp set_helper_test.go.txt e2e/set/helper_test.go
cp two-packages.yaml machinery.yaml
gitcommit 'one set in two packages'
exec machinery run --adapter go-test-json --streams -- sh two.sh
exec sh -c 'grep -c "\"test\":\"e2e/set/helper_test.go\",\"observed\":\"go test: all 4 test function(s) of its set passed (packages example.test/shop/stage/one, example.test/shop/stage/two)\"" .machinery/receipts/*.jsonl'
stdout '^1$'
rm .machinery/receipts
env TWO_RUN=TestA
exec machinery run --adapter go-test-json --streams -- sh two.sh
env TWO_RUN=
stderr '^machinery run: adapter go-test-json: 2 stream\(s\), 2 package\(s\), 3 test function\(s\) with a verdict: 3 passed, 0 failed, 0 skipped$'
exec sh -c '! grep "\"test\":\"e2e/set/helper_test.go\"" .machinery/receipts/*.jsonl'
exec mrun 1 verify --partly
stdout '^  warn   partly run: inv:customer-email-unique: no verdict: e2e/set/helper_test\.go \(by its set\)$'
! stdout 'by its set: inv:customer-email-unique: e2e/set/helper_test\.go'

-- e2e/suite/support_test.go --
package suite

// The helpers of the suite have no test function of their own. This marker stands above no
// function: the file claims the invariant, and its set judges it.
//
// machinery:verifies inv:customer-email-unique

// settleAll applies every event; the marker above it is a marker of its file.
//
// machinery:verifies inv:terminal-is-final
func settleAll(events ...string) int { return len(events) }
-- e2e/suite/ship_helper_test.go --
package suite

import "testing"

// shipped is a helper; the marker above it is a marker of its file, whose one test function
// must pass.
//
// machinery:verifies inv:paid-before-shipped
func shipped(event string) bool { return event == "ship" && settleAll(event) == 1 }

func TestShippedHelper(t *testing.T) {
	if !shipped("ship") {
		t.Fatal("ship is not shipped")
	}
}
-- never_test.go.txt --
//go:build never

package suite

// A helper go test never builds: nothing sets the tag never.
//
// machinery:verifies inv:customer-email-unique
-- faults_helper_test.go.txt --
//go:build faults

package suite

// A helper the run builds, with -tags faults; it carries a build constraint all the same.
//
// machinery:verifies inv:customer-email-unique
-- faults_helper_open.go.txt --
package suite

// The same helper with its //go:build line taken out.
//
// machinery:verifies inv:customer-email-unique
-- cgo_support.go.txt --
package suite

import "C"

// A source the wrapper builds with the suite when cgo is on; it has no test function.
//
// machinery:verifies inv:paid-before-shipped

func cgoSupport() bool { return true }
-- plusbuild_test.go.txt --
// +build ignore

package suite

// A helper behind a +build line.
//
// machinery:verifies inv:terminal-is-final
-- helper_test.go.txt --
package suite

// A helper whose name builds it for one system, or one architecture, only.
//
// machinery:verifies inv:paid-before-shipped
-- set_a_test.go.txt --
package set

import "testing"

// machinery:verifies inv:customer-email-unique
func TestA(t *testing.T) {}
-- set_b_test.go.txt --
package set

import "testing"

func TestB(t *testing.T) {}
-- set_helper_test.go.txt --
package set

// A helper of the set, mapped with it to two packages.
//
// machinery:verifies inv:customer-email-unique
-- two.sh --
#!/bin/sh
# copies the files of e2e/set into stage/one and stage/two and tests both; stage/two runs only
# the test functions TWO_RUN names
set -u
status=0
for p in one two; do
  mkdir -p "stage/$p"
  cp e2e/set/*_test.go "stage/$p/"
done
go test -json -count=1 ./stage/one > "$MACHINERY_GO_TEST_JSON/one.json" || status=1
go test -json -count=1 -run "${TWO_RUN:-.}" ./stage/two > "$MACHINERY_GO_TEST_JSON/two.json" || status=1
rm -rf stage
exit $status
-- two-packages.yaml --
version: 2
design:
  models:
    - design/model/shop.modelith.yaml
  machines: design/machines
  failure_modes: design/failure-modes.yaml
contracts:
  - kind: openapi
    path: contracts/openapi.yaml
trace:
  code: ["internal/**/*.go"]
  tests: ["e2e/**"]
constraints:
  layers:
    - {name: domain, paths: ["internal/domain/**"]}
    - {name: api, paths: ["internal/api/**"]}
  size:
    max_file_lines: 200
    max_func_lines: 40
waivers:
  - {rule: action-event, id: "act:Order.place", reason: "creation enters the initial state Pending"}
evidence:
  adapter:
    sources:
      - {package: example.test/shop/stage/one, files: ["e2e/set/*_test.go"]}
      - {package: example.test/shop/stage/two, files: ["e2e/set/*_test.go"]}
-- lone_test.go.txt --
package lone

// machinery:verifies inv:paid-before-shipped

func lone() bool { return true }
-- staged_support.go.txt --
package suite

// A source the wrapper builds with the suite; it has no test function.
//
// machinery:verifies inv:terminal-is-final

func stagedSupport() bool { return true }
-- suite.sh --
#!/bin/sh
set -eu
go test -count=1 -json -tags faults ./e2e/suite > "${MACHINERY_GO_TEST_JSON:?}/suite.json"
-- sources.yaml --
version: 2
design:
  models:
    - design/model/shop.modelith.yaml
  machines: design/machines
  failure_modes: design/failure-modes.yaml
contracts:
  - kind: openapi
    path: contracts/openapi.yaml
trace:
  code: ["internal/**/*.go"]
  tests: ["e2e/**"]
constraints:
  layers:
    - {name: domain, paths: ["internal/domain/**"]}
    - {name: api, paths: ["internal/api/**"]}
  size:
    max_file_lines: 200
    max_func_lines: 40
waivers:
  - {rule: action-event, id: "act:Order.place", reason: "creation enters the initial state Pending"}
evidence:
  adapter:
    sources:
      - {package: example.test/shop/e2e/suite, files: ["e2e/suite/*.go"]}
