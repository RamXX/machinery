# declared delays: both directions
fixture shop

# a raw millisecond key bypasses the named delay
cp raw_ms.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: state paying after key ''5000'' is a raw millisecond value; name the delay and declare its bound in _delays$'
stdout '^  ERROR  design/machines/Order\.machine\.json: _delays declares ''payTimeout'' but no after edge consumes it; a declared cadence nothing implements is not a bound \(wire it to an after, or drop it\)$'
stdout '^failed: 2 finding\(s\)$'

# every named delay is declared
cp undeclared.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: state Paid after delay ''holdTimeout'' is not declared in _delays \(named delays carry their ms bound and rationale there\)$'
stdout '^failed: 1 finding\(s\)$'
stdout '^checked: 1 machines, 5 states, 9 transitions$'

# a declared delay that nothing consumes is not a bound
cp unused.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: _delays declares ''unusedDelay'' but no after edge consumes it; a declared cadence nothing implements is not a bound \(wire it to an after, or drop it\)$'
stdout '^failed: 1 finding\(s\)$'

# _delays is an object
cp not_object.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: _delays must be an object mapping delay names to "<ms> - <rationale>" strings$'
stdout '^  ERROR  design/machines/Order\.machine\.json: state paying after delay ''payTimeout'' is not declared in _delays \(named delays carry their ms bound and rationale there\)$'
stdout '^failed: 2 finding\(s\)$'

-- raw_ms.json --
{
  "_comment": "Order lifecycle. Domain states mirror the OrderStatus enum; `paying` is the transient overlay around the payment call.",
  "_delays": {
    "payTimeout": "5000 ms - upper bound on the payment provider call"
  },
  "id": "order",
  "initial": "Pending",
  "context": {
    "orderId": null,
    "lastError": null
  },
  "states": {
    "Pending": {
      "on": {
        "pay": [
          {
            "target": "paying",
            "guard": "hasPaymentMethod",
            "actions": "stampAttempt"
          },
          {
            "actions": "recordPayRefused"
          }
        ],
        "cancel": {
          "target": "Cancelled",
          "actions": "recordCancellation"
        }
      },
      "_ignores": {
        "ship": "an unpaid order cannot ship; the API refuses with ORDER_NOT_PAID"
      }
    },
    "paying": {
      "invoke": {
        "src": "chargePayment",
        "onDone": {
          "target": "Paid",
          "actions": "recordCharge"
        },
        "onError": {
          "target": "Pending",
          "actions": "recordPaymentFailure"
        }
      },
      "after": {
        "5000": {
          "target": "Pending",
          "actions": "recordPaymentTimeout"
        }
      }
    },
    "Paid": {
      "on": {
        "ship": {
          "target": "Shipped",
          "actions": "recordShipment"
        },
        "cancel": {
          "target": "Cancelled",
          "actions": [
            "refundPayment",
            "recordCancellation"
          ]
        }
      },
      "_ignores": {
        "pay": "already paid; a repeated pay is refused with ORDER_ALREADY_PAID"
      }
    },
    "Shipped": {
      "type": "final",
      "entry": "notifyCustomer"
    },
    "Cancelled": {
      "type": "final"
    }
  }
}
