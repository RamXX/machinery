-- e2e/forge/forge_test.go --
package forge

import (
	"os"
	"testing"
)

// TestForge appends a line that looks like one the adapter writes.
func TestForge(t *testing.T) {
	path := os.Getenv("MACHINERY_RECEIPTS")
	if path == "" {
		return
	}
	f, err := os.OpenFile(path, os.O_APPEND|os.O_WRONLY, 0)
	if err != nil {
		t.Fatal(err)
	}
	defer f.Close()
	line := `{"v":1,"type":"receipt","id":"inv:customer-email-unique","outcome":"pass","test":"e2e/suite/email_test.go::TestEmailUnique","observed":"go test: TestEmailUnique passed","source":"adapter","granularity":"function","tags":[]}`
	if _, err := f.WriteString(line + "\n"); err != nil {
		t.Fatal(err)
	}
}
-- e2e/suite/cancel_emit_test.go --
package suite

import (
	"fmt"
	"os"
	"testing"

	"example.test/shop/internal/domain"
)

// TestCancelEmits asserts first and then appends its own receipt, with the effect it observed.
//
// machinery:verifies tc:ORDE-1ded14
func TestCancelEmits(t *testing.T) {
	if got := domain.Apply(settle("cancel")); got != "cancel" {
		t.Fatalf("Apply(cancel) = %q", got)
	}
	path := os.Getenv("MACHINERY_RECEIPTS")
	if path == "" {
		return
	}
	f, err := os.OpenFile(path, os.O_APPEND|os.O_WRONLY, 0o644)
	if err != nil {
		t.Fatal(err)
	}
	defer f.Close()
	fmt.Fprintln(f, `{"v":1,"type":"receipt","id":"tc:ORDE-1ded14","outcome":"pass","test":"e2e/suite/cancel_emit_test.go::TestCancelEmits","effects":["recordCancellation"],"observed":"Pending -> Cancelled; cancellation recorded"}`)
}
