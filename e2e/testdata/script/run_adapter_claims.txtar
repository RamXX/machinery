# claims the adapter cannot turn into a receipt, the build tags of GOFLAGS, and a test that emits
# its own receipt during an adapter run (section 10.3)
fixture shop
fixture shop-gotests
exec machinery gen
gitinit

env GOFLAGS=-tags=faults
exec machinery run --adapter go-test-json -- go test -count=1 ./e2e/suite ./e2e/replay
env GOFLAGS=
stderr '^machinery run: adapter go-test-json: 2 package\(s\), 9 test function\(s\) with a verdict: 9 passed, 0 failed, 0 skipped$'
stderr '^machinery run: adapter: receipts written: 6 pass, 0 fail, 0 skip$'
stderr '^machinery run: adapter: claimed, not run: 0 id\(s\)$'
# a tc id needs effects and a cx id a replay: a verdict of go test carries neither
stderr '^machinery run: adapter: needs a receipt with effects: 1 tc id\(s\)$'
stderr '^machinery run: adapter: needs a receipt with a replay: 1 cx id\(s\)$'
# a claiming file with no test function, and one that does not parse
stderr '^machinery run: adapter: e2e/suite/helpers_test\.go: no test function; its claims count nothing$'
stderr '^machinery run: adapter: e2e/drafts/broken_test\.go: not Go source that parses; its claims count nothing$'
# without -tags on the command line the tags of GOFLAGS are recorded
exec sh -c 'grep -c "\"source\":\"adapter\",\"granularity\":\"[a-z]*\",\"tags\":\[\"faults\"\]" .machinery/receipts/*.jsonl'
stdout '^6$'
# the receipt the test appended itself is in the same file, before the end line
exec sh -c 'grep -c "\"type\":\"receipt\"" .machinery/receipts/*.jsonl'
stdout '^7$'
exec sh -c 'tail -n 1 .machinery/receipts/*.jsonl'
stdout '"type":"end"'

exec mrun 1 verify
! stdout 'ERROR  receipt'
! stdout 'malformed'
stdout '^checked: 17 obligations, 7 proven, 3 by adapter at function granularity, 3 by adapter at file granularity, 0 partial, 2 owed, 7 receipts$'
stdout '^  ERROR  unproven: cx:order-payment:race$'
! stdout 'unproven: tc:ORDE-1ded14'
exec machinery proof --ids tc:ORDE-1ded14
! stdout '^adapter:'
stdout '^  tc:ORDE-1ded14 -> e2e/suite/cancel_emit_test\.go::TestCancelEmits -> pass: Pending -> Cancelled; cancellation recorded$'

# a line with the adapter's fields that a test appends itself is not the adapter's: refused, and
# the pass it claims does not count
rm .machinery/receipts
exec machinery run --adapter go-test-json -- go test -count=1 ./e2e/forge
stderr '^machinery run: adapter: receipts written: 0 pass, 0 fail, 0 skip$'
exec sh -c 'tail -n 1 .machinery/receipts/*.jsonl'
stdout '"adapter_receipts":0\}$'
exec mrun 1 verify
stdout '^  ERROR  malformed receipts file: \.machinery/receipts/.*: line 2: inv:customer-email-unique: source, granularity and tags are written only by the run adapter: a test that emits receipts leaves them out$'
stdout '^  ERROR  unproven: inv:customer-email-unique$'
stdout '^checked: 17 obligations, 0 proven, 0 partial, 2 owed, 0 receipts$'

# a marker directly above a fuzz test or a benchmark belongs to that function, which the adapter
# does not judge: the claim counts nothing and never falls back to the file, whose
# TestHelperCheck passed. The fuzz seed is skipped under -short, the benchmark never runs
rm .machinery/receipts
cp fuzz_test.go e2e/suite/fuzz_test.go
gitcommit 'a fuzz test and a benchmark with markers'
exec machinery run --adapter go-test-json -- go test -short -run 'TestHelperCheck|FuzzEmail' ./e2e/suite
stderr '^machinery run: adapter: e2e/suite/fuzz_test\.go: inv:customer-email-unique: the adapter does not judge FuzzEmail; put the marker above a Test function or at file level$'
stderr '^machinery run: adapter: e2e/suite/fuzz_test\.go: inv:paid-before-shipped: the adapter does not judge BenchmarkShip; put the marker above a Test function or at file level$'
! stderr 'the adapter does not judge BenchmarkOther'
stderr '^machinery run: adapter: in the whole project: .* 3 claim\(s\) above functions the adapter does not judge$'
! stderr 'fuzz_test\.go: no test function'
stderr -count=2 '; put the marker above a Test function or at file level$'
exec sh -c '! grep -q fuzz_test .machinery/receipts/*.jsonl'
exec mrun 1 verify
stdout '^  ERROR  unproven: inv:customer-email-unique$'
stdout '^  ERROR  unproven: inv:paid-before-shipped$'

-- design/formal/traces/order-payment.race.trace.json --
