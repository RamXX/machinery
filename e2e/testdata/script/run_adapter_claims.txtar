-- e2e/replay/replay_test.go --
package replay

import "testing"

// machinery:verifies cx:order-payment:race
func TestReplayRace(t *testing.T) {}
-- fuzz_test.go --
package suite

import "testing"

// FuzzEmail feeds addresses to the customer store; under -short its seed is skipped.
//
// machinery:verifies inv:customer-email-unique
func FuzzEmail(f *testing.F) {
	f.Add("a@example.test")
	f.Fuzz(func(t *testing.T, email string) {
		if testing.Short() {
			t.Skip("no customer store under -short")
		}
	})
}

// BenchmarkShip runs only with -bench, which direct mode does not accept.
//
// machinery:verifies inv:paid-before-shipped
func BenchmarkShip(b *testing.B) {
	for i := 0; i < b.N; i++ {
		settle("ship")
	}
}

// TestHelperCheck checks a helper and claims nothing.
func TestHelperCheck(t *testing.T) {
	if settle("pay") != "pay" {
		t.Fatal("settle changed the event")
	}
}
