# _external_events lists events a machine receives from outside; each must be answered by a state
fixture shop

# valid: an event handled by a state and an event that a state ignores
cp valid.json design/machines/Order.machine.json
exec machinery lint --stage machines
stdout '^checked: 1 machines, 5 states, 8 transitions$'
stdout '^passed$'

# the marker is an array
cp not_array.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^  ERROR  design/machines/Order\.machine\.json: _external_events must be an array of event-name strings this machine receives from outside its component$'
stdout '^failed: 1 finding\(s\)$'

# entries are non-empty strings
cp bad_entries.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^  ERROR  design/machines/Order\.machine\.json: _external_events entries must be non-empty event-name strings$'
stdout '^failed: 2 finding\(s\)$'

# an event no state handles or ignores makes the marker stale
cp stale.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^  ERROR  design/machines/Order\.machine\.json: _external_events names ''refund'' but no state handles or ignores it; the marker is stale \(remove it, or wire the event\)$'
stdout '^failed: 1 finding\(s\)$'

-- valid.json --
{
  "_comment": "Order lifecycle. Domain states mirror the OrderStatus enum; `paying` is the transient overlay around the payment call.",
  "_delays": {
    "payTimeout": "5000 ms - upper bound on the payment provider call"
  },
  "id": "order",
  "initial": "Pending",
  "context": {
    "orderId": null,
    "lastError": null
  },
  "states": {
    "Pending": {
      "on": {
        "pay": [
          {
            "target": "paying",
            "guard": "hasPaymentMethod",
            "actions": "stampAttempt"
          },
          {
            "actions": "recordPayRefused"
          }
        ],
        "cancel": {
          "target": "Cancelled",
          "actions": "recordCancellation"
        }
      },
      "_ignores": {
        "ship": "an unpaid order cannot ship; the API refuses with ORDER_NOT_PAID"
      }
    },
    "paying": {
      "invoke": {
        "src": "chargePayment",
        "onDone": {
          "target": "Paid",
          "actions": "recordCharge"
        },
        "onError": {
          "target": "Pending",
          "actions": "recordPaymentFailure"
        }
      },
      "after": {
        "payTimeout": {
          "target": "Pending",
          "actions": "recordPaymentTimeout"
        }
      }
    },
    "Paid": {
      "on": {
        "ship": {
          "target": "Shipped",
          "actions": "recordShipment"
        },
        "cancel": {
          "target": "Cancelled",
          "actions": [
            "refundPayment",
            "recordCancellation"
          ]
        }
      },
      "_ignores": {
        "pay": "already paid; a repeated pay is refused with ORDER_ALREADY_PAID"
      }
    },
    "Shipped": {
      "type": "final",
      "entry": "notifyCustomer"
    },
    "Cancelled": {
      "type": "final"
    }
  },
  "_external_events": [
    "pay",
    "ship"
  ]
}
