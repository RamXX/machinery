# what the adapter refuses before it runs anything, and the flags it adds to go test
# (section 10.3)
fixture shop
fixture shop-gotests
exec machinery gen
gitinit

exec mrun 2 run --adapter junit -- go test ./e2e/suite
stderr '^usage: --adapter: unknown adapter "junit": write --adapter go-test-json, the only adapter$'
exec mrun 2 run --adapter go-test-json -- sh e2e/orders.sh
stderr '^usage: --adapter go-test-json: the command must be go test, got sh e2e/orders\.sh: run go test itself, or add --streams and have the command leave its go test -json output in MACHINERY_GO_TEST_JSON$'
exec mrun 2 run --adapter go-test-json -- go vet ./...
stderr '^usage: --adapter go-test-json: the command must be go test, got go vet: run go test itself, or add --streams '
exec mrun 2 run --adapter go-test-json -- go test -count=2 ./e2e/suite
stderr '^usage: --adapter go-test-json: -count=2 is refused: write -count=1$'
exec mrun 2 run --adapter go-test-json -- go test -count 3 ./e2e/suite
stderr '^usage: --adapter go-test-json: -count=3 is refused: write -count=1$'
# every spelling that sets another count
exec mrun 2 run --adapter go-test-json -- go test -test.count=2 ./e2e/suite
stderr '^usage: --adapter go-test-json: -test\.count=2 is refused: write -count=1$'
exec mrun 2 run --adapter go-test-json -- go test --count=2 ./e2e/suite
stderr '^usage: --adapter go-test-json: -count=2 is refused: write -count=1$'
exec mrun 2 run --adapter go-test-json -- go test ./e2e/suite -args -test.count=2
stderr '^usage: --adapter go-test-json: -test\.count=2 is refused: write -count=1$'
env GOFLAGS=-count=2
exec mrun 2 run --adapter go-test-json -- go test ./e2e/suite
stderr '^usage: --adapter go-test-json: GOFLAGS has -count=2, which is refused: take it out of GOFLAGS$'
exec mrun 2 run --adapter go-test-json --streams -- sh run-suite.sh
stderr '^usage: --adapter go-test-json: GOFLAGS has -count=2, which is refused: take it out of GOFLAGS$'
env GOFLAGS=
exec mrun 2 run --adapter go-test-json -- go test -json=false -count=1 ./e2e/suite
stderr '^usage: --adapter go-test-json: -json=false is refused: the adapter reads the event stream; leave it out$'
# -overlay builds files that are not on disk, and the adapter reads the files on disk
exec mrun 2 run --adapter go-test-json -- go test -overlay overlay.json ./e2e/suite
stderr '^usage: --adapter go-test-json: -overlay is refused: the adapter reads the test files on disk; run without it$'
exec mrun 2 run --adapter go-test-json -- go test -overlay=overlay.json ./e2e/suite
stderr '^usage: --adapter go-test-json: -overlay is refused: '
env GOFLAGS=-overlay=overlay.json
exec mrun 2 run --adapter go-test-json -- go test ./e2e/suite
stderr '^usage: --adapter go-test-json: GOFLAGS has -overlay, which is refused: take it out of GOFLAGS$'
exec mrun 2 run --adapter go-test-json --streams -- sh run-suite.sh
stderr '^usage: --adapter go-test-json: GOFLAGS has -overlay, which is refused: take it out of GOFLAGS$'
env GOFLAGS=
# nothing ran and nothing was recorded
! exists .machinery/receipts
! exists .git/machinery/runs

# -json written by the caller is not added again, and a leading -C stays first
exec machinery run --adapter go-test-json -- go test -count=1 -json ./e2e/suite
exec sh -c 'head -n 1 .machinery/receipts/*.jsonl'
stdout '"command":\["go","test","-count=1","-json","./e2e/suite"\],'
rm .machinery/receipts
exec machinery run --adapter go-test-json -- go test -C e2e/suite -count=1 .
stderr 'adapter: receipts written: 5 pass, 0 fail, 0 skip$'
exec sh -c 'head -n 1 .machinery/receipts/*.jsonl'
stdout '"command":\["go","test","-C","e2e/suite","-json","-count=1","."\],'
# a -count after -args belongs to the test binary and is not read
rm .machinery/receipts
exec machinery run --adapter go-test-json -- go test -count=1 ./e2e/suite -args -- -count=2
stderr 'adapter: receipts written: 5 pass, 0 fail, 0 skip$'

# -count=1 is added when it is absent: go test never answers from its cache
rm .machinery/receipts
exec machinery run --adapter go-test-json -- go test -short ./e2e/suite
exec machinery run --adapter go-test-json -- go test -short ./e2e/suite
! stdout cached
stderr '^machinery run: adapter: receipts written: 5 pass, 0 fail, 0 skip$'
exec sh -c 'grep -h "\"type\":\"run\"" .machinery/receipts/*.jsonl'
stdout -count=2 '"command":\["go","test","-json","-count=1","-short","./e2e/suite"\],'
rm .machinery/receipts
exec machinery run --adapter go-test-json -- go test -C e2e/suite -json .
exec sh -c 'head -n 1 .machinery/receipts/*.jsonl'
stdout '"command":\["go","test","-C","e2e/suite","-count=1","-json","."\],'

# without trace.tests there is no claim to join the run to
cp notrace.yaml machinery.yaml
gitcommit 'no trace'
exec mrun 2 run --adapter go-test-json -- go test -count=1 ./e2e/suite
stderr '^usage: --adapter go-test-json: trace\.tests is not set: the adapter joins the run to the claims of the test files; list them in machinery\.yaml$'

-- notrace.yaml --
version: 2
design:
  models:
    - design/model/shop.modelith.yaml
  machines: design/machines
  failure_modes: design/failure-modes.yaml
contracts:
  - kind: openapi
    path: contracts/openapi.yaml
constraints:
  layers:
    - {name: domain, paths: ["internal/domain/**"]}
    - {name: api, paths: ["internal/api/**"]}
  size:
    max_file_lines: 200
    max_func_lines: 40
waivers:
  - {rule: action-event, id: "act:Order.place", reason: "creation enters the initial state Pending"}
