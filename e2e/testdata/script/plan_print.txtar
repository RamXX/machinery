# plan prints one story per group of owed ids, as Markdown or as a bd graph plan (section 15.2)
fixture shop
fixture shop-formal
exec sh -c 'printf "backlog:\n  tool: bd\n" >> machinery.yaml'
exec machinery gen

# nothing owed prints nothing and exits 0
cp owed-none.yaml design/owed.yaml
exec machinery plan
! stdout .
exec machinery plan --json
! stdout .

# every kind of group, every kind of edge
cp owed-all.yaml design/owed.yaml
mkdir design/formal/traces
cp race.trace.json design/formal/traces/order-payment.race.trace.json
exec machinery plan
cmp stdout want.md

# deterministic: the same bytes again
cp stdout first.md
exec machinery plan
cmp stdout first.md

# --json is a bd create --graph plan with the same stories and the edges
exec machinery plan --json
cp stdout plan.json
exec sh -c 'grep -c "\"key\":" plan.json'
stdout '^12$'
! stdout 'u003e'
grep '"key": "prove-order-pay",$' plan.json
grep '"title": "Model order-payment \(tla\)",$' plan.json
grep '"title": "Model order-ownership \(alloy\)",$' plan.json
grep '"title": "Serve Order actions",$' plan.json
grep '"acceptance_criteria": "- Each listed obligation is proven' plan.json
grep '"description": "Intent:\\nMachine order answers pay on the running system as its table says.\\n\\nAcceptance:\\n- tc:ORDE-2e883d: Pending on:pay \[hasPaymentMethod\] -> paying, effects: stampAttempt; observed on the running system\\n' plan.json
exec sh -c 'tr -d " \n" < plan.json | grep -o "\"edges\":.*"'
stdout '"from_key":"prove-cx-order-payment-race","to_key":"model-order-payment-tla","type":"blocks"'
stdout '"from_key":"prove-cx-order-payment-race","to_key":"prove-order-pay","type":"blocks"'
stdout '"from_key":"prove-fm-payment-provider-down","to_key":"prove-order-internal-transitions","type":"blocks"'
stdout '"from_key":"prove-order-cancel","to_key":"model-order-payment-tla","type":"blocks"'
stdout '"from_key":"prove-order-internal-transitions","to_key":"model-order-payment-tla","type":"blocks"'
stdout '"from_key":"prove-order-pay","to_key":"model-order-payment-tla","type":"blocks"'
stdout '"from_key":"prove-order-ship","to_key":"model-order-payment-tla","type":"blocks"'
exec sh -c 'grep -c "\"from_key\":" plan.json'
stdout '^7$'

# an edge needs both stories in the plan: without the Model story there is none to it
cp owed-nomodel.yaml design/owed.yaml
exec machinery plan
! stdout 'Model order-payment'
! stdout 'the formal model the tier requires'
stdout '^- Prove order internal transitions: the invoke path the failure is induced on$'

# usage errors
exec mrun 2 plan extra
stderr '^usage: machinery plan takes no arguments$'
exec mrun 2 plan --parent shop-1
stderr '^usage: --parent needs --apply$'
exec mrun 2 plan --apply --json
stderr '^usage: --apply and --json do not go together$'
exec mrun 2 plan --link shop-1
stderr '^usage: machinery plan --link <story> needs at least one id$'

