# a run records whether the tree was dirty (section 10, step 1)
fixture shop
exec machinery gen
gitinit

# an uncommitted change makes the run dirty
exec sh -c 'echo "// wip" >> internal/api/handlers.go'
exec machinery run -- sh e2e/orders.sh
exec sh -c 'head -n 1 .machinery/receipts/*.jsonl'
stdout '"dirty":true'

# so does an untracked file
exec git checkout -- internal/api/handlers.go
exec sh -c 'echo new > internal/new.txt'
rm .machinery/receipts
exec machinery run -- sh e2e/orders.sh
exec sh -c 'head -n 1 .machinery/receipts/*.jsonl'
stdout '"dirty":true'

# changes to the owed file and inside the receipts directory do not count
rm internal/new.txt
rm .machinery/receipts
cp owed-reordered.yaml design/owed.yaml
mkdir .machinery/receipts
exec sh -c 'echo scratch > .machinery/receipts/scratch.txt'
exec machinery run -- sh e2e/orders.sh
exec sh -c 'head -n 1 .machinery/receipts/*.jsonl'
stdout '"dirty":false'
! stdout '"dirty":true'

# even when the receipts directory is not ignored by git
rm .machinery/receipts
rm .gitignore
exec sh -c 'printf ".home/\n" > .gitignore'
gitcommit 'stop ignoring .machinery'
exec machinery run -- sh e2e/orders.sh
exec sh -c 'head -n 1 .machinery/receipts/*.jsonl'
stdout '"dirty":false'

-- owed-reordered.yaml --
version: 1
owed:
  - id: tc:ORDE-8bd6e7
    reason: "effect recordCharge is a noop in the skeleton"
  - id: fm:payment-provider-down
    reason: "no test induces a provider outage yet"
