# _requires names who may cause a transition: the lint checks its shape, the table row carries it
fixture shop

# the plain shop, for comparison
exec machinery gen
cp design/gen/obligations.json plain-obligations.json
! grep '"requires"' design/gen/tables/order.table.json
! grep 'Callers' design/gen/tables/order.table.md

# valid: two branches name their callers
cp valid.json design/machines/Order.machine.json
exec machinery lint --stage machines
stdout '^checked: 1 machines, 5 states, 8 transitions$'
stdout '^passed$'

# the rows that declare it carry it, sorted, as the last key; the others do not
exec machinery gen
grep -count=2 '"requires"' design/gen/tables/order.table.json
grep '"id": "tc:ORDE-1ded14",\n +"source": "Pending",\n +"kind": "on",\n +"event": "cancel",\n +"guard": "",\n +"target": "Cancelled",\n +"actions": \[\n +"recordCancellation"\n +\],\n +"effects": \[\n +"recordCancellation"\n +\],\n +"requires": \[\n +"Clerk",\n +"Customer"\n +\]\n +\}' design/gen/tables/order.table.json
grep '"id": "tc:ORDE-e6d28f",(?s:[^}]*)"requires": \[\n +"Clerk",\n +"system/fulfilment"\n +\]\n +\}' design/gen/tables/order.table.json

# the readable rendering lists them too
grep '^## Callers$' design/gen/tables/order.table.md
grep '^\| tc:ORDE-1ded14 \| Clerk, Customer \|$' design/gen/tables/order.table.md
grep '^\| tc:ORDE-e6d28f \| Clerk, system/fulfilment \|$' design/gen/tables/order.table.md

# callers change no case: the obligations are those of the plain shop
cmp design/gen/obligations.json plain-obligations.json

# the annotation is an array
cp not_array.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^  ERROR  design/machines/Order\.machine\.json: _requires must be a non-empty array naming who may cause the transition \(an actor or role, or system/<name>\) in Pending on:cancel$'
stdout '^failed: 1 finding\(s\)$'

# an empty array names nobody
cp empty.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^  ERROR  design/machines/Order\.machine\.json: _requires must be a non-empty array naming who may cause the transition \(an actor or role, or system/<name>\) in Pending on:cancel$'
stdout '^failed: 1 finding\(s\)$'

# every entry is a non-empty string
cp bad_entries.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^  ERROR  design/machines/Order\.machine\.json: _requires entries must be non-empty strings in Pending on:cancel$'
stdout '^failed: 2 finding\(s\)$'

# no caller is named twice
cp duplicate.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^  ERROR  design/machines/Order\.machine\.json: _requires names ''Clerk'' twice in Pending on:cancel$'
stdout '^failed: 1 finding\(s\)$'

-- valid.json --
{
  "_comment": "Order lifecycle. Domain states mirror the OrderStatus enum; `paying` is the transient overlay around the payment call.",
  "_delays": {
    "payTimeout": "5000 ms - upper bound on the payment provider call"
  },
  "id": "order",
  "initial": "Pending",
  "context": {
    "orderId": null,
    "lastError": null
  },
  "states": {
    "Pending": {
      "on": {
        "pay": [
          {
            "target": "paying",
            "guard": "hasPaymentMethod",
            "actions": "stampAttempt"
          },
          {
            "actions": "recordPayRefused"
          }
        ],
        "cancel": {
          "target": "Cancelled",
          "actions": "recordCancellation",
          "_requires": [
            "Customer",
            "Clerk"
          ]
        }
      },
      "_ignores": {
        "ship": "an unpaid order cannot ship; the API refuses with ORDER_NOT_PAID"
      }
    },
    "paying": {
      "invoke": {
        "src": "chargePayment",
        "onDone": {
          "target": "Paid",
          "actions": "recordCharge"
        },
        "onError": {
          "target": "Pending",
          "actions": "recordPaymentFailure"
        }
      },
      "after": {
        "payTimeout": {
          "target": "Pending",
          "actions": "recordPaymentTimeout"
        }
      }
    },
    "Paid": {
      "on": {
        "ship": {
          "target": "Shipped",
          "actions": "recordShipment",
          "_requires": [
            "system/fulfilment",
            "Clerk"
          ]
        },
        "cancel": {
          "target": "Cancelled",
          "actions": [
            "refundPayment",
            "recordCancellation"
          ]
        }
      },
      "_ignores": {
        "pay": "already paid; a repeated pay is refused with ORDER_ALREADY_PAID"
      }
    },
    "Shipped": {
      "type": "final",
      "entry": "notifyCustomer"
    },
    "Cancelled": {
      "type": "final"
    }
  }
}
