# evidence is bound to its commit (section 10.1)
fixture shop
exec machinery gen
gitinit
exec machinery run -- sh e2e/orders.sh

# a commit that changes only the owed file keeps the evidence valid
cp owed-reasons.yaml design/owed.yaml
gitcommit 'reword owed reasons'
exec machinery verify
stdout '^checked: 16 obligations, 14 proven, 1 partial, 2 owed, 15 receipts$'
stdout '^passed$'

# a receipts file from a commit that does not exist says nothing
exec sh -c 'cp .machinery/receipts/*.jsonl ghost.tmp && sed "s/\"commit\":\"[0-9a-f]*\"/\"commit\":\"0000000000000000000000000000000000000000\"/" ghost.tmp > .machinery/receipts/20200101T000000.000Z-0000000.jsonl && rm ghost.tmp'
exec machinery verify
stdout '15 receipts'
stdout '^passed$'

# a commit that changes anything else: the evidence says nothing about the new commit
exec sh -c 'echo "// changed" >> internal/domain/order.go'
gitcommit 'change code'
exec mrun 1 verify
stdout '^not demonstrated: no evidence at [0-9a-f]{7}$'

# a new run at the new commit is evidence again, and the old files are gone
exec machinery run -- sh e2e/orders.sh
exec machinery verify
stdout '^passed$'
exec sh -c 'ls .machinery/receipts | wc -l'
stdout '^ *1$'

-- owed-reasons.yaml --
version: 1
owed:
  - id: fm:payment-provider-down
    reason: "no outage test yet"
  - id: tc:ORDE-8bd6e7
    reason: "recordCharge is still a noop"
