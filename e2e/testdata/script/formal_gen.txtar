# Skeletons are generated from the machine and the model; properties are never touched.
fixture shop
fixture shop-formal
exec machinery gen
gitinit

# before generation the skeletons are missing
exec mrun 1 formal gen --check
stdout '== formal-gen =='
stdout 'DRIFT  design/formal/Order.tla: missing'
stdout 'DRIFT  design/formal/shop.als: missing'

exec machinery formal gen
stdout 'formal gen: wrote 2 file\(s\)'
exec machinery formal gen
stdout 'formal gen: wrote 0 file\(s\)'
exec machinery formal gen --check
stdout '^passed$'

# the TLA+ skeleton: one action group per transition case, named after its id
grep 'MODULE Order' design/formal/Order.tla
grep 'Generated by machinery formal gen from design/machines/Order.machine.json' design/formal/Order.tla
grep 'CONSTANTS Instances, Callers, Atomic' design/formal/Order.tla
grep 'VARIABLES st, fx, pend, last' design/formal/Order.tla
grep 'States == {"Pending", "paying", "Paid", "Shipped", "Cancelled"}' design/formal/Order.tla
grep 'Final == {"Shipped", "Cancelled"}' design/formal/Order.tla
grep 'tc:ORDE-2e883d  Pending on:pay \[hasPaymentMethod\] -> paying' design/formal/Order.tla
grep '^Do_ORDE_2e883d\(i, c\) ==' design/formal/Order.tla
grep '^Begin_ORDE_2e883d\(i, c\) ==' design/formal/Order.tla
grep '^Commit_ORDE_2e883d\(i, c\) ==' design/formal/Order.tla
grep '^Do_ORDE_ad945c\(i\) ==' design/formal/Order.tla
grep 'Bump\(@, {"recordShipment", "notifyCustomer"}\)' design/formal/Order.tla
grep 'Fairness == .A i .in Instances : WF_vars\(InternalOf\(i\)\)' design/formal/Order.tla

# the Alloy skeleton: derived from the Modelith model
grep '^module shop' design/formal/shop.als
grep 'abstract sig OrderStatus {}' design/formal/shop.als
grep 'one sig Pending, Paid, Shipped, Cancelled extends OrderStatus {}' design/formal/shop.als
grep 'order: set Order' design/formal/shop.als
grep 'status: one OrderStatus' design/formal/shop.als
grep 'customer: one Customer' design/formal/shop.als
grep 'fact { all y: Order . one order.y }' design/formal/shop.als
grep 'fact { all a: Customer, b: Order . b in a.order iff a in b.customer }' design/formal/shop.als

# a changed machine makes the skeleton stale
exec sed -i.bak 's/"recordShipment"/"recordDispatch"/' design/machines/Order.machine.json
exec mrun 1 formal gen --check
stdout 'DRIFT  design/formal/Order.tla: stale'
exec mrun 1 check --stage formal
stdout 'DRIFT  design/formal/Order.tla: stale; run machinery formal gen'
