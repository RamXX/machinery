# adopt without --write reports and writes nothing
fixture brownfield
gitinit
exec sh backlog.sh

exec machinery adopt --paths 'internal/shipping/**'
stdout '^adopt: [^ ]+ at [0-9a-f]{7}$'
stdout '^scope: internal/shipping/\*\*$'
stdout '^languages: go$'
stdout '^code files: 2 in scope$'
stdout '^test files: 0 under e2e roots, 1 elsewhere \(unit tests\), 1 with test doubles$'
stdout '^design: 0 model\(s\), 0 machine\(s\), 0 contract\(s\)$'
stdout '^backlog: bd, 4 open, 3 ready, 1 closed, cycles: none$'
stdout '^would write:$'
stdout '^  design/gen/obligations.json  generated by machinery gen$'
stdout '^  design/tests-baseline.yaml  baseline, new entries: 1$'
stdout '^  machinery.yaml  new config$'
stdout '^next:$'
stdout '^  machinery adopt --write  writes the files above$'
stdout '^  model the riskiest stateful resource under design/'
exec git status --short
! stdout .
! exists machinery.yaml
! exists design

# no --paths covers everything: both unit tests, and the code of every directory
exec machinery adopt
stdout '^scope: \*\*$'
stdout '^code files: 4 in scope$'
stdout '^test files: 0 under e2e roots, 2 elsewhere \(unit tests\), 1 with test doubles$'
stdout 'new entries: 2'
exec git status --short
! stdout .

# the project is the directory named by -C, and a test file under an e2e root is counted there
mkdir elsewhere
cd elsewhere
exec machinery -C .. adopt --paths 'internal/billing/**' --e2e 'e2e/**'
stdout '^scope: internal/billing/\*\*$'
stdout '^code files: 1 in scope$'
stdout '^test files: 0 under e2e roots, 1 elsewhere \(unit tests\), 0 with test doubles$'
cd ..
exec sh -c 'printf "package e2e\n" > e2e/flow_test.go'
exec machinery adopt --paths 'internal/billing/**'
stdout '^test files: 1 under e2e roots, 1 elsewhere \(unit tests\), 0 with test doubles$'
rm e2e/flow_test.go

# an existing machinery.yaml is read and never written: what adoption adds would go to
# design/adoption.yaml
cp machinery-existing.yaml machinery.yaml
exec machinery adopt --paths 'internal/billing/**'
stdout '^scope: internal/shipping/\*\*, internal/billing/\*\*$'
stdout '^  design/adoption\.yaml  adds: scope \+internal/billing/\*\*; tests\.baseline; backlog\.tool: bd$'
! stdout '^  machinery\.yaml'
cmp machinery.yaml machinery-existing.yaml

# the languages come from marker files in scope and in its parents, and from extensions
exec cp -R .machinery/polysrc poly
exec machinery -C poly adopt --paths 'svc/**'
stdout '^adopt: poly at [0-9a-f]{7}$'
stdout '^languages: go$'
stdout '^backlog: none found$'
exec machinery -C poly adopt
stdout '^languages: elixir, go, python, rust, typescript$'
! exists poly/machinery.yaml

# a repository with no commit yet
exec git init -q fresh
exec machinery -C fresh adopt
stdout '^adopt: fresh at no commit$'
stdout '^languages: none found$'

# usage and config errors write nothing
exec mrun 2 adopt extra
stderr 'usage: machinery adopt takes no arguments'
exec mrun 2 adopt --paths '../outside/**'
stderr 'config: glob: "../outside/\*\*" must stay inside the project root'
exec mrun 2 adopt --paths '[bad'
stderr 'config: "\[bad" is not a valid glob'
cp machinery-broken.yaml machinery.yaml
exec mrun 2 adopt
stderr 'config: machinery.yaml: version must be 2'

-- machinery-existing.yaml --
version: 2
scope:
  - "internal/shipping/**"
tests:
  e2e:
    - "e2e/**"
-- machinery-broken.yaml --
version: 1
-- .machinery/polysrc/go.mod --
module example.test/poly
-- .machinery/polysrc/svc/main.go --
package main
-- .machinery/polysrc/web/package.json --
{}
-- .machinery/polysrc/web/app.ts --
export {}
-- .machinery/polysrc/tools/run.py --
print("x")
-- .machinery/polysrc/lib/mix.exs --
defmodule X do end
-- .machinery/polysrc/native/Cargo.toml --
[package]
