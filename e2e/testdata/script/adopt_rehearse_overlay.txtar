# adopt --rehearse --overlay <dir>: the rehearsal runs on the snapshot with the files of <dir>
# laid over it, and says so (docs/formats.md section 17.3)
fixture shop proj
cd proj
rm machinery.yaml
gitinit
cd ..

# refusals, exit 2, nothing written
exec mrun 2 -C proj adopt --overlay ov
stderr '^usage: --overlay goes with --rehearse$'
exec mrun 2 -C proj adopt --rehearse --overlay ov --out out
stderr '^usage: --overlay ov needs a config to be judged by \(the machinery.yaml of HEAD, or --config\): it says which files are design sources, and a config in the overlay never does$'
exec mrun 2 -C proj adopt --rehearse --overlay ov-cfg --out out
stderr '^usage: --overlay ov-cfg needs a config to be judged by \(the machinery.yaml of HEAD, or --config\): it says which files are design sources, and a config in the overlay never does$'
exec mrun 2 -C proj adopt --rehearse --config shop.yaml --overlay ov-test --out out
stderr '^usage: --overlay ov-test: e2e/orders.sh is not a design source of --config shop.yaml: an overlay holds only the config and the design sources it names \(design.risk, design.status, import.failure_modes.links\)$'
exec mrun 2 -C proj adopt --rehearse --config shop.yaml --overlay ov-code --out out
stderr '^usage: --overlay ov-code: internal/domain/order.go is not a design source of --config shop.yaml: '
# a config that names a test or code as a design source admits neither: what the globs of
# trace, tests and constraints match is never replaced, in any letter case, inside scope or not
exec mrun 2 -C proj adopt --rehearse --config tricky.yaml --overlay ov-risk --out out
stderr '^usage: --overlay ov-risk: e2e/risk.yaml is under trace.tests of --config tricky.yaml; an overlay never replaces what is read as code or tests$'
exec mrun 2 -C proj adopt --rehearse --config tricky.yaml --overlay ov-status --out out
stderr '^usage: --overlay ov-status: lib/domain/status.yaml is under constraints.layers of --config tricky.yaml; '
exec mrun 2 -C proj adopt --rehearse --config tricky2.yaml --overlay ov-code-glob --out out
stderr '^usage: --overlay ov-code-glob: cmd/status.yaml is under trace.code of --config tricky2.yaml; '
exec mrun 2 -C proj adopt --rehearse --config tricky2.yaml --overlay ov-fold --out out
stderr '^usage: --overlay ov-fold: Smoke/risk.yaml is under tests.e2e of --config tricky2.yaml; '
# the owed list and the failure-mode file are evidence and design the overlay does not carry
exec mrun 2 -C proj adopt --rehearse --config shop.yaml --overlay ov-owed --out out
stderr '^usage: --overlay ov-owed: design/owed.yaml is not a design source of --config shop.yaml: '
exec mrun 2 -C proj adopt --rehearse --config shop.yaml --overlay ov-modes --out out
stderr '^usage: --overlay ov-modes: design/failure-modes.yaml is not a design source of --config shop.yaml: '
! exists out

# the overlay holds a status file that makes one scenario proposed, and a risk file: one
# obligation fewer is owed than at HEAD
exec machinery -C proj adopt --rehearse --config shop-risk.yaml --overlay ov --out out
stdout '^project: proj at [0-9a-f]{7}$'
stdout '^overlay: 2 file\(s\) laid over the snapshot; this is not the result of HEAD: design/risk.yaml, design/status.yaml$'
stdout '^adopt: wrote 8 file\(s\), 0 waiver\(s\), 15 owed$'
cmp out/snapshot/design/status.yaml ov/design/status.yaml
cmp out/snapshot/design/risk.yaml ov/design/risk.yaml
grep '^- overlay: 2 file\(s\) laid over the snapshot; this is not the result of HEAD$' out/rehearsal.md
exec sh -c 'grep -x "  - \`design/status.yaml\` sha256 $(shasum -a 256 ov/design/status.yaml | cut -c1-64)" out/rehearsal.md'
grep '^- sc: 1$' out/rehearsal.md
grep '^      "path": "design/status.yaml",$' out/rehearsal.json
exec sh -c 'grep -x "      \"sha256\": \"$(shasum -a 256 ov/design/status.yaml | cut -c1-64)\"" out/rehearsal.json'

# the project is as it was
exec git -C proj status --porcelain
! stdout .
! exists proj/machinery.yaml
! exists proj/design/status.yaml

# without an overlay the report has none
exec machinery -C proj adopt --rehearse --config shop.yaml --out out2
! stdout '^overlay:'
stdout '^adopt: wrote 8 file\(s\), 0 waiver\(s\), 16 owed$'
! grep 'overlay' out2/rehearsal.md
grep '^  "overlay": \[\],$' out2/rehearsal.json

# a links file that names no subject, laid over a project whose catalog was linked: the
# rehearsed check shows every row unlinked, and the stage blocks
fixture library lib
cd lib
gitinit
cd ..
exec machinery -C lib adopt --rehearse --overlay ov-garbage --out out3
grep '^checked: 4 failure modes, 0 linked, 4 unlinked, ' out3/stages/check.txt
grep '^### xref-failure: failed: ' out3/rehearsal.md

-- shop.yaml --
version: 2
design:
  models:
    - design/model/shop.modelith.yaml
  machines: design/machines
  failure_modes: design/failure-modes.yaml
contracts:
  - kind: openapi
    path: contracts/openapi.yaml
trace:
  code: ["internal/**/*.go"]
  tests: ["e2e/**"]
constraints:
  layers:
    - {name: domain, paths: ["internal/domain/**"]}
    - {name: api, paths: ["internal/api/**"]}
  size:
    max_file_lines: 200
    max_func_lines: 40
-- shop-risk.yaml --
version: 2
design:
  models:
    - design/model/shop.modelith.yaml
  machines: design/machines
  failure_modes: design/failure-modes.yaml
  risk: design/risk.yaml
contracts:
  - kind: openapi
    path: contracts/openapi.yaml
trace:
  code: ["internal/**/*.go"]
  tests: ["e2e/**"]
constraints:
  layers:
    - {name: domain, paths: ["internal/domain/**"]}
    - {name: api, paths: ["internal/api/**"]}
  size:
    max_file_lines: 200
    max_func_lines: 40
-- ov/design/status.yaml --
version: 1
proposed:
  - {id: "sc:cancelled-order-refuses-payment", note: "not committed yet"}
-- ov/design/risk.yaml --
version: 1
areas:
  - name: shipping-permission
    tier: consequential
    why: "authorization: only a Clerk ships"
    ids: ["act:Order.ship"]
-- ov-garbage/design/risk-links.yaml --
version: 1
links:
  - {ids: [RISK-1..RISK-4]}
-- ov-owed/design/owed.yaml --
version: 1
owed: []
-- ov-modes/design/failure-modes.yaml --
version: 1
failure_modes: []
-- tricky2.yaml --
version: 2
scope: ["internal/**"]
design:
  risk: Smoke/risk.yaml
  status: cmd/status.yaml
trace:
  code: ["cmd/**"]
  tests: ["e2e/**"]
tests:
  e2e: ["smoke/**"]
-- ov-code-glob/cmd/status.yaml --
version: 1
-- ov-fold/Smoke/risk.yaml --
version: 1
-- tricky.yaml --
version: 2
scope: ["internal/**"]
design:
  risk: e2e/risk.yaml
  status: lib/domain/status.yaml
trace:
  code: ["cmd/**"]
  tests: ["e2e/**"]
tests:
  e2e: ["smoke/**"]
constraints:
  layers:
    - {name: domain, paths: ["lib/domain/**"]}
-- ov-risk/e2e/risk.yaml --
version: 1
-- ov-status/lib/domain/status.yaml --
version: 1
-- ov-cfg/machinery.yaml --
version: 2
-- ov-cfg/design/status.yaml --
version: 1
-- ov-test/e2e/orders.sh --
echo replaced
-- ov-code/internal/domain/order.go --
package domain
