# a links entry covers many rows: ids takes a list of ids and of inclusive ranges of ids that
# share a prefix and end in a number (docs/formats.md section 5.4.1)
exec machinery lint --stage failure-modes --stage xref-failure
stdout '^checked: 14 failure modes, 0 abuse cases, 14 imported, 10 linked, 0 unlinked, 4 subject-less$'
stdout '^checked: 14 failure modes, 10 linked, 0 unlinked, 4 subject-less, 0 invokes, 1 dependencies, '
stdout '^machinery lint: 2 passed, 0 failed, 0 not demonstrated, 0 not applicable$'

# a range is written with at least the digits of its first id: FM-09..FM-101 names FM-09 to
# FM-99 and FM-100 to FM-101, and every id it names must be a row
cp wide.yaml design/links.yaml
exec mrun 1 lint --stage failure-modes
stdout '^  ERROR  design/links.yaml: FM-09..FM-101: no failure-mode row of docs/risks.md has the ids FM-13, FM-14, FM-15, FM-16, FM-17 and 82 more$'
stdout '^checked: 14 failure modes, 0 abuse cases, 14 imported, 6 linked, 8 unlinked$'
stdout '^failed: 1 finding\(s\)$'

# an id of a list that is no row
cp missing.yaml design/links.yaml
exec mrun 1 lint --stage failure-modes
stdout '^  ERROR  design/links.yaml: FM-01, FM-77: no failure-mode row of docs/risks.md has the id FM-77$'
stdout '^failed: 1 finding\(s\)$'

# two entries that name the same row: the finding names both, and the first one holds
cp two-deps.yaml machinery.yaml
cp overlap.yaml design/links.yaml
exec mrun 1 lint --stage failure-modes --stage xref-failure
stdout '^  ERROR  design/links.yaml: links 1 \(FM-01..FM-10\) and 2 \(FM-08..FM-12\) overlap: FM-08, FM-09, FM-10$'
stdout '^  ERROR  design/links.yaml: links 1 \(FM-01..FM-10\) and 3 \(fm-03\) overlap: fm-03$'
stdout '^  ERROR  design/links.yaml: links 2 \(FM-08..FM-12\) and 4 \(FM-100, FM-11, FM-12, ...\) overlap: FM-11, FM-12$'
stdout '^  ERROR  design/links.yaml: FM-100, FM-11, FM-12, ...: FM-100 is listed twice$'
stdout '^failed: 4 finding\(s\)$'
stdout '^checked: 14 failure modes, 14 linked, 0 unlinked, 0 invokes, 2 dependencies, '
stdout '^  ERROR  dependency-failure-mode: dependency:water: no failure mode names this dependency; '
cp one-dep.yaml machinery.yaml

# what is not a list of ids and ranges
cp malformed.yaml design/links.yaml
exec mrun 1 lint --stage failure-modes
stdout '^  ERROR  design/links.yaml: link 1: id and ids are both set; keep one$'
stdout '^  ERROR  design/links.yaml: link 2: id or ids is required$'
stdout '^  ERROR  design/links.yaml: link 3: id or ids is required$'
stdout '^  ERROR  design/links.yaml: FM-05..FM-03: the range FM-05..FM-03 runs backwards$'
stdout '^  ERROR  design/links.yaml: FM-01..RISK-03: the ends of the range FM-01..RISK-03 do not share a prefix$'
stdout '^  ERROR  design/links.yaml: FM-a..FM-b: the ends of the range FM-a..FM-b must end in a number$'
stdout '^  ERROR  design/links.yaml: FM-01..FM-03..FM-05: FM-01..FM-03..FM-05 is not an id or a range <first>..<last>$'
stdout '^  ERROR  design/links.yaml: FM-1..FM-99999: the range FM-1..FM-99999 names 99999 ids; a range holds at most 10000$'
stdout '^  ERROR  design/links.yaml: FM-06..FM-07: required must be fail-closed, retry-bounded, surface or refuse, got "maybe"$'
stdout '^failed: 9 finding\(s\)$'

-- machinery.yaml --
version: 2
import:
  failure_modes:
    file: docs/risks.md
    id: "^FM-[0-9]+$"
    columns: {failure: ["Failure"], behavior: ["Expected"]}
    links: design/links.yaml
dependencies:
  - {name: power, posture: real}
-- one-dep.yaml --
version: 2
import:
  failure_modes:
    file: docs/risks.md
    id: "^FM-[0-9]+$"
    columns: {failure: ["Failure"], behavior: ["Expected"]}
    links: design/links.yaml
dependencies:
  - {name: power, posture: real}
-- two-deps.yaml --
version: 2
import:
  failure_modes:
    file: docs/risks.md
    id: "^FM-[0-9]+$"
    columns: {failure: ["Failure"], behavior: ["Expected"]}
    links: design/links.yaml
dependencies:
  - {name: power, posture: real}
  - {name: water, posture: real}
-- docs/risks.md --
| Id | Failure | Expected |
|---|---|---|
| FM-01 | Failure number 01. | The desk handles number 01. |
| FM-02 | Failure number 02. | The desk handles number 02. |
| FM-03 | Failure number 03. | The desk handles number 03. |
| FM-04 | Failure number 04. | The desk handles number 04. |
| FM-05 | Failure number 05. | The desk handles number 05. |
| FM-06 | Failure number 06. | The desk handles number 06. |
| FM-07 | Failure number 07. | The desk handles number 07. |
| FM-08 | Failure number 08. | The desk handles number 08. |
| FM-09 | Failure number 09. | The desk handles number 09. |
| FM-10 | Failure number 10. | The desk handles number 10. |
| FM-11 | Failure number 11. | The desk handles number 11. |
| FM-12 | Failure number 12. | The desk handles number 12. |
| FM-100 | Failure number 100. | The desk handles number 100. |
| FM-101 | Failure number 101. | The desk handles number 101. |
-- design/links.yaml --
version: 1
links:
  - {ids: [FM-01..FM-10], subject: "dependency:power", required: fail-closed}
  - {ids: [fm-11, FM-12, FM-100..FM-101], no_subject: "about the building, which the design does not model"}
-- wide.yaml --
version: 1
links:
  - {ids: [FM-09..FM-101], subject: "dependency:power", required: fail-closed}
-- missing.yaml --
version: 1
links:
  - {ids: [FM-01, FM-77], subject: "dependency:power", required: fail-closed}
-- overlap.yaml --
version: 1
links:
  - {ids: [FM-01..FM-10], subject: "dependency:power", required: fail-closed}
  - {ids: [FM-08..FM-12], subject: "dependency:power", required: surface}
  - {id: fm-03, subject: "dependency:water", required: surface}
  - {ids: [FM-100, FM-11, FM-12, FM-100..FM-101], subject: "dependency:power", required: surface}
-- malformed.yaml --
version: 1
links:
  - {id: FM-01, ids: [FM-02], subject: "dependency:power", required: surface}
  - {subject: "dependency:power", required: surface}
  - {ids: [], subject: "dependency:power", required: surface}
  - {ids: [FM-05..FM-03], subject: "dependency:power", required: surface}
  - {ids: [FM-01..RISK-03], subject: "dependency:power", required: surface}
  - {ids: [FM-a..FM-b], subject: "dependency:power", required: surface}
  - {ids: [FM-01..FM-03..FM-05], subject: "dependency:power", required: surface}
  - {ids: [FM-1..FM-99999], subject: "dependency:power", required: surface}
  - {ids: [FM-06..FM-07], subject: "dependency:power", required: maybe}
