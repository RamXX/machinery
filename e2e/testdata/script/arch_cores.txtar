-- ledger.go.txt --
// Package domain holds the order rules of the fixture project.
package domain

// Ledger records the charges of orders.
type Ledger struct{ entries []string }

// Post records one charge.
func (l *Ledger) Post(order string) {
	l.entries = append(l.entries, order)
}
-- impure.go.txt --
// Package domain holds the order rules of the fixture project.
package domain

import (
	"os"
	"os/exec"
	"strings"
)

// Apply is a placeholder for the order behavior.
//
// machinery:serves act:Order.place act:Order.pay act:Order.ship act:Order.cancel
func Apply(event string) string {
	_ = exec.Command
	return strings.ToLower(event) + os.Getenv("SUFFIX")
}
-- bypass.go.txt --
// Package billing charges orders.
package billing

// Charge takes the payment of an order.
//
// machinery:serves act:Order.pay
func Charge(order string) string {
	return order
}
-- through-core.go.txt --
// Package billing charges orders.
package billing

import "example.test/shop/internal/domain"

// Charge takes the payment of an order through the core.
//
// machinery:serves act:Order.pay
func Charge(order string) string {
	return domain.Apply(order)
}
-- serves-ship.go.txt --
// Package billing charges orders.
package billing

// Ship hands an order to the carrier; no property is over it.
//
// machinery:serves act:Order.ship
func Ship(order string) string {
	return order
}
-- rules.py.txt --
def settle(order):
    return order
