-- risk-entries-ok.yaml --
version: 1
areas:
  - name: order-payment
    tier: vital
    why: "money moves; a customer charged twice cannot be made whole by a retry"
    ids: ["act:Order.pay", "tc:ORDE-2e883d", "tc:ORDE-8bd6e7", "tc:ORDE-267d12", "tc:ORDE-ad945c", "tc:ORDE-e6d28f", "inv:paid-before-shipped", "fm:payment-provider-down", "fm:pay-for-another-customer"]
    questions: [concurrency]
    property:
      - name: charged-once
        statement: "An order is charged at most once, whatever its callers do at the same time."
        kind: exactly-once
        over: ["act:Order.pay", "tc:ORDE-8bd6e7"]
    core:
      paths: ["internal/domain/**"]
      entry: ["internal/domain/order.go#Apply", "internal/domain/ledger.go#Ledger", "internal/domain/ledger.go#Ledger.Post"]
    assumes:
      - name: final-stays-final
        statement: "The store never rewrites the status of a shipped or cancelled order."
        evidence: ["inv:terminal-is-final"]
-- risk-entries-bad.yaml --
version: 1
areas:
  - name: order-payment
    tier: vital
    why: "money moves; a customer charged twice cannot be made whole by a retry"
    ids: ["act:Order.pay", "tc:ORDE-2e883d", "tc:ORDE-8bd6e7", "tc:ORDE-267d12", "tc:ORDE-ad945c", "tc:ORDE-e6d28f", "inv:paid-before-shipped", "fm:payment-provider-down", "fm:pay-for-another-customer"]
    questions: [concurrency]
    property:
      - name: charged-once
        statement: "An order is charged at most once, whatever its callers do at the same time."
        kind: exactly-once
        over: ["act:Order.pay", "tc:ORDE-8bd6e7"]
    core:
      paths: ["internal/domain/**"]
      entry: ["internal/domain/order.go#Missing", "internal/api/handlers.go#Handle", "internal/domain/gone.go#Apply", "internal/domain/order.go#Apply"]
    assumes:
      - name: final-stays-final
        statement: "The store never rewrites the status of a shipped or cancelled order."
        evidence: ["inv:terminal-is-final"]
-- risk-missing.yaml --
version: 1
areas:
