# guard-false dispositions: _refusal
fixture shop

# a fully guarded handler must say what happens when no guard admits
cp missing.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: state Pending on:cancel is fully guarded, so an event that satisfies no guard is silently absorbed\. Declare the disposition: _refusal: \{''cancel'': "<what happens when no guard admits>"\}, or add an unguarded branch$'
stdout '^failed: 1 finding\(s\)$'

# a declared refusal passes
cp declared.json design/machines/Order.machine.json
exec machinery lint --stage machines
stdout '^checked: 1 machines, 5 states, 8 transitions$'
stdout '^passed$'

# a refusal needs a disposition
cp empty.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: state Pending _refusal\[''cancel''\] has no disposition; state what happens when no guard admits$'
stdout '^  ERROR  design/machines/Order\.machine\.json: state Pending on:cancel is fully guarded, so an event that satisfies no guard is silently absorbed\. Declare the disposition: _refusal: \{''cancel'': "<what happens when no guard admits>"\}, or add an unguarded branch$'
stdout '^failed: 2 finding\(s\)$'

# a refusal for a handler with an unguarded branch is a stale claim
cp stale.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: state Pending declares _refusal\[''pay''\] but no fully guarded handler of that name exists; drop the entry or fix the name$'
stdout '^failed: 1 finding\(s\)$'

# timers are keyed after:<delay>
cp timer.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: state paying after:payTimeout is fully guarded, so a timer that satisfies no guard is silently absorbed\. Declare the disposition: _refusal: \{''after:payTimeout'': "<what happens when no guard admits>"\}, or add an unguarded branch$'
stdout '^failed: 1 finding\(s\)$'

# invoke results are keyed <src>.onDone and <src>.onError
cp invoke.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: state paying invoke chargePayment\.onDone is fully guarded, so a result that satisfies no guard is silently absorbed\. Declare the disposition: _refusal: \{''chargePayment\.onDone'': "<what happens when no guard admits>"\}, or add an unguarded branch$'
stdout '^failed: 1 finding\(s\)$'

# _refusal is an object
cp not_object.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: state Pending _refusal must map handler names to disposition strings$'
stdout '^failed: 1 finding\(s\)$'

-- missing.json --
{
  "_comment": "Order lifecycle. Domain states mirror the OrderStatus enum; `paying` is the transient overlay around the payment call.",
  "_delays": {
    "payTimeout": "5000 ms - upper bound on the payment provider call"
  },
  "id": "order",
  "initial": "Pending",
  "context": {
    "orderId": null,
    "lastError": null
  },
  "states": {
    "Pending": {
      "on": {
        "pay": [
          {
            "target": "paying",
            "guard": "hasPaymentMethod",
            "actions": "stampAttempt"
          },
          {
            "actions": "recordPayRefused"
          }
        ],
        "cancel": {
          "target": "Cancelled",
          "actions": "recordCancellation",
          "guard": "canCancel"
        }
      },
      "_ignores": {
        "ship": "an unpaid order cannot ship; the API refuses with ORDER_NOT_PAID"
      }
    },
    "paying": {
      "invoke": {
        "src": "chargePayment",
        "onDone": {
          "target": "Paid",
          "actions": "recordCharge"
        },
        "onError": {
          "target": "Pending",
          "actions": "recordPaymentFailure"
        }
      },
      "after": {
        "payTimeout": {
          "target": "Pending",
          "actions": "recordPaymentTimeout"
        }
      }
    },
    "Paid": {
      "on": {
        "ship": {
          "target": "Shipped",
          "actions": "recordShipment"
        },
        "cancel": {
          "target": "Cancelled",
          "actions": [
            "refundPayment",
            "recordCancellation"
          ]
        }
      },
      "_ignores": {
        "pay": "already paid; a repeated pay is refused with ORDER_ALREADY_PAID"
      }
    },
    "Shipped": {
      "type": "final",
      "entry": "notifyCustomer"
    },
    "Cancelled": {
      "type": "final"
    }
  }
}
-- declared.json --
{
  "_comment": "Order lifecycle. Domain states mirror the OrderStatus enum; `paying` is the transient overlay around the payment call.",
  "_delays": {
    "payTimeout": "5000 ms - upper bound on the payment provider call"
  },
  "id": "order",
  "initial": "Pending",
  "context": {
    "orderId": null,
    "lastError": null
  },
  "states": {
    "Pending": {
      "on": {
        "pay": [
          {
            "target": "paying",
            "guard": "hasPaymentMethod",
            "actions": "stampAttempt"
          },
          {
            "actions": "recordPayRefused"
          }
        ],
        "cancel": {
          "target": "Cancelled",
          "actions": "recordCancellation",
          "guard": "canCancel"
        }
      },
      "_ignores": {
        "ship": "an unpaid order cannot ship; the API refuses with ORDER_NOT_PAID"
      },
      "_refusal": {
        "cancel": "canCancel is false once a charge is in flight: the API answers ORDER_NOT_CANCELLABLE and the order stays Pending"
      }
    },
    "paying": {
      "invoke": {
        "src": "chargePayment",
        "onDone": {
          "target": "Paid",
          "actions": "recordCharge"
        },
        "onError": {
          "target": "Pending",
          "actions": "recordPaymentFailure"
        }
      },
      "after": {
        "payTimeout": {
          "target": "Pending",
          "actions": "recordPaymentTimeout"
        }
      }
    },
    "Paid": {
      "on": {
        "ship": {
          "target": "Shipped",
          "actions": "recordShipment"
        },
        "cancel": {
          "target": "Cancelled",
          "actions": [
            "refundPayment",
            "recordCancellation"
          ]
        }
      },
      "_ignores": {
        "pay": "already paid; a repeated pay is refused with ORDER_ALREADY_PAID"
      }
    },
    "Shipped": {
      "type": "final",
      "entry": "notifyCustomer"
    },
    "Cancelled": {
      "type": "final"
    }
  }
}
