# while a failure mode names no subject and is not declared subject-less with a reason,
# xref-failure is not demonstrated, never passed: it prints how many are linked and how many are
# not (docs/formats.md section 6.6)
exec mrun 1 lint --stage failure-modes --stage xref-failure
stdout '(?s)== failure-modes ==\nchecked: 2 failure modes, 0 abuse cases, 2 imported, 2 unlinked\npassed\n'
stdout '(?s)== xref-failure ==\nchecked: 2 failure modes, 0 linked, 2 unlinked, 0 invokes, 0 dependencies, 0 tiered actions, 0 failure states, 0 failure events\nnot demonstrated: 2 of 2 failure modes name no subject; link each in a links file \(import.failure_modes.links\) or declare it there with no_subject and a reason\n'
stdout '^machinery lint: 1 passed, 0 failed, 1 not demonstrated, 0 not applicable$'

# a links file that links nothing changes nothing
cp links-empty.yaml design/links.yaml
cp with-links.yaml machinery.yaml
exec mrun 1 lint --stage xref-failure
stdout '^not demonstrated: 2 of 2 failure modes name no subject; link each in design/links.yaml or declare it there with no_subject and a reason$'

# an entry that names no subject links nothing, whatever else it holds: missing, empty or
# malformed, for one row or a range, alone or in check, the rows stay unlinked
cp garbage-1.yaml design/links.yaml
exec mrun 1 lint --stage xref-failure
stdout '^checked: 2 failure modes, 0 linked, 2 unlinked, 0 invokes, '
stdout '^not demonstrated: 2 of 2 failure modes name no subject; link each in design/links.yaml or declare it there with no_subject and a reason$'
! stdout '^passed$'
cp garbage-2.yaml design/links.yaml
exec mrun 1 lint --stage xref-failure
stdout '^checked: 2 failure modes, 0 linked, 2 unlinked, 0 invokes, '
stdout '^not demonstrated: 2 of 2 failure modes name no subject; link each in design/links.yaml or declare it there with no_subject and a reason$'
! stdout '^passed$'
cp garbage-3.yaml design/links.yaml
exec mrun 1 lint --stage xref-failure
stdout '^checked: 2 failure modes, 0 linked, 2 unlinked, 0 invokes, '
stdout '^not demonstrated: 2 of 2 failure modes name no subject; link each in design/links.yaml or declare it there with no_subject and a reason$'
! stdout '^passed$'
cp garbage-4.yaml design/links.yaml
exec mrun 1 lint --stage xref-failure
stdout '^checked: 2 failure modes, 0 linked, 2 unlinked, 0 invokes, '
stdout '^not demonstrated: 2 of 2 failure modes name no subject; link each in design/links.yaml or declare it there with no_subject and a reason$'
! stdout '^passed$'
cp garbage-5.yaml design/links.yaml
exec mrun 1 lint --stage xref-failure
stdout '^checked: 2 failure modes, 0 linked, 2 unlinked, 0 invokes, '
stdout '^not demonstrated: 2 of 2 failure modes name no subject; link each in design/links.yaml or declare it there with no_subject and a reason$'
! stdout '^passed$'
exec mrun 1 check --stage xref-failure
stdout '^checked: 2 failure modes, 0 linked, 2 unlinked, 0 invokes, '
! stdout '^passed$'
# a subject without a required value, or with one that is none, is no link either
cp garbage-6.yaml design/links.yaml
exec mrun 1 lint --stage xref-failure
stdout '^checked: 2 failure modes, 0 linked, 2 unlinked, 0 invokes, '
# a subject that parses and names nothing in the design is not linked: with the finding the
# stage fails, and with the finding waived it is still not demonstrated
cp links-bad.yaml design/links.yaml
exec mrun 1 lint --stage xref-failure
stdout '^checked: 2 failure modes, 0 linked, 2 unlinked, 0 invokes, '
stdout '^failed: 1 finding\(s\)$'
cp with-subject-waiver.yaml machinery.yaml
exec mrun 1 lint --stage xref-failure
stdout '^  warn   waived: subject-resolves: act:Loan.burn: '
stdout '^not demonstrated: 2 of 2 failure modes name no subject; link each in design/links.yaml or declare it there with no_subject and a reason$'
cp with-links.yaml machinery.yaml

# one linked row of two is compared with the design, and the other still names nothing: the
# stage says how many, and does not pass
cp links-one.yaml design/links.yaml
exec mrun 1 lint --stage xref-failure
stdout '^checked: 2 failure modes, 1 linked, 1 unlinked, 0 invokes, '
stdout '^not demonstrated: 1 of 2 failure modes name no subject; link each in design/links.yaml or declare it there with no_subject and a reason$'
! stdout '^passed$'

# the other row declared subject-less, with the reason: every failure mode is accounted for
cp links-declared.yaml design/links.yaml
exec machinery lint --stage failure-modes --stage xref-failure
stdout '^checked: 2 failure modes, 0 abuse cases, 2 imported, 0 unlinked$'
stdout '^checked: 2 failure modes, 1 linked, 0 unlinked, 1 subject-less, 0 invokes, '
stdout '^machinery lint: 2 passed, 0 failed, 0 not demonstrated, 0 not applicable$'

# a declaration without a reason, or beside a subject, declares nothing: the row counts as
# unlinked and the stage does not pass, run alone or not
cp links-blank.yaml design/links.yaml
exec mrun 1 lint --stage xref-failure
stdout '^checked: 2 failure modes, 1 linked, 1 unlinked, 0 invokes, '
stdout '^not demonstrated: 1 of 2 failure modes name no subject; link each in design/links.yaml or declare it there with no_subject and a reason$'
cp links-both.yaml design/links.yaml
exec mrun 1 lint --stage xref-failure
stdout '^checked: 2 failure modes, 1 linked, 1 unlinked, 0 invokes, '
stdout '^not demonstrated: 1 of 2 failure modes name no subject; link each in design/links.yaml or declare it there with no_subject and a reason$'

# every row declared subject-less: nothing was compared with the design
cp links-all-declared.yaml design/links.yaml
exec mrun 1 lint --stage xref-failure
stdout '^checked: 2 failure modes, 0 linked, 0 unlinked, 2 subject-less, 0 invokes, '
stdout '^not demonstrated: no failure mode names a subject$'

# a linked row whose subject names nothing is a finding: the stage fails
cp links-bad.yaml design/links.yaml
exec mrun 1 lint --stage xref-failure
stdout '^  ERROR  subject-resolves: act:Loan.burn: failure mode risk-2: Loan.burn is not an action of the model$'
stdout '^failed: 1 finding\(s\)$'

# unlinked rows beside a finding: failed, not merely not demonstrated
cp links-empty.yaml design/links.yaml
cp with-invoke.yaml machinery.yaml
exec mrun 1 lint --stage xref-failure
stdout '^  ERROR  invoke-failure-mode: invoke:desk.checkCard: no failure mode names this invoke; declare what happens when it fails in design/links.yaml$'
stdout '^failed: 1 finding\(s\)$'

# a waiver accepts the finding but links nothing: still not demonstrated
cp with-waiver.yaml machinery.yaml
exec mrun 1 lint --stage xref-failure
stdout '^  warn   waived: invoke-failure-mode: invoke:desk.checkCard: '
stdout '^not demonstrated: 2 of 2 failure modes name no subject; link each in design/links.yaml or declare it there with no_subject and a reason$'

-- machinery.yaml --
version: 2
design:
  models:
    - design/model/desk.modelith.yaml
import:
  failure_modes:
    file: docs/risks.md
    id: "^RISK-[0-9]+$"
    columns:
      failure: ["Failure"]
      behavior: ["Required behavior"]
-- with-links.yaml --
version: 2
design:
  models:
    - design/model/desk.modelith.yaml
import:
  failure_modes:
    file: docs/risks.md
    id: "^RISK-[0-9]+$"
    columns:
      failure: ["Failure"]
      behavior: ["Required behavior"]
    links: design/links.yaml
-- with-invoke.yaml --
version: 2
design:
  models:
    - design/model/desk.modelith.yaml
  machines: design/machines
import:
  failure_modes:
    file: docs/risks.md
    id: "^RISK-[0-9]+$"
    columns:
      failure: ["Failure"]
      behavior: ["Required behavior"]
    links: design/links.yaml
-- with-waiver.yaml --
version: 2
design:
  models:
    - design/model/desk.modelith.yaml
  machines: design/machines
import:
  failure_modes:
    file: docs/risks.md
    id: "^RISK-[0-9]+$"
    columns:
      failure: ["Failure"]
      behavior: ["Required behavior"]
    links: design/links.yaml
waivers:
  - {rule: invoke-failure-mode, id: "invoke:desk.checkCard", reason: "the card check is modeled next"}
-- garbage-1.yaml --
version: 1
links:
  - {ids: [RISK-1..RISK-2]}
-- garbage-2.yaml --
version: 1
links:
  - {ids: [RISK-1, RISK-2], required: surface}
-- garbage-3.yaml --
version: 1
links:
  - {ids: [RISK-1, RISK-2], subject: "whatever", required: surface}
-- garbage-4.yaml --
version: 1
links:
  - {ids: [RISK-1..RISK-2], subject: "nonsense:thing", required: surface}
-- garbage-5.yaml --
version: 1
links:
  - {ids: [RISK-1..RISK-2], subject: "", required: bogus, kind: nonsense}
-- garbage-6.yaml --
version: 1
links:
  - {id: RISK-1, subject: "act:Loan.lend"}
  - {id: RISK-2, subject: "act:Loan.lend", required: bogus}
-- with-subject-waiver.yaml --
version: 2
design:
  models:
    - design/model/desk.modelith.yaml
import:
  failure_modes:
    file: docs/risks.md
    id: "^RISK-[0-9]+$"
    columns:
      failure: ["Failure"]
      behavior: ["Required behavior"]
    links: design/links.yaml
waivers:
  - {rule: subject-resolves, id: "act:Loan.burn", reason: "the action is modeled next"}
-- links-empty.yaml --
version: 1
links: []
-- links-one.yaml --
version: 1
links:
  - {id: RISK-2, subject: "act:Loan.lend", required: surface}
-- links-declared.yaml --
version: 1
links:
  - {id: RISK-1, no_subject: "the card reader is hardware the desk does not own or model"}
  - {id: RISK-2, subject: "act:Loan.lend", required: surface}
-- links-blank.yaml --
version: 1
links:
  - {id: RISK-1, no_subject: " "}
  - {id: RISK-2, subject: "act:Loan.lend", required: surface}
-- links-both.yaml --
version: 1
links:
  - {id: RISK-1, subject: "act:Loan.lend", no_subject: "the card reader is hardware", required: surface}
  - {id: RISK-2, subject: "act:Loan.lend", required: surface}
-- links-all-declared.yaml --
version: 1
links:
  - {id: RISK-1, no_subject: "the card reader is hardware the desk does not own or model"}
  - {id: RISK-2, no_subject: "double entry is a property of the ledger as a whole"}
-- links-bad.yaml --
version: 1
links:
  - {id: RISK-2, subject: "act:Loan.burn", required: surface}
-- docs/risks.md --
# Risks

| Risk | Failure | Required behavior |
|------|---------|-------------------|
| RISK-1 | The card reader is down. | The desk refuses the loan with READER_DOWN. |
| RISK-2 | A loan is recorded twice. | The second record is refused. |
-- design/model/desk.modelith.yaml --
kind: DomainModel
version: v1
title: Desk
enums:
  LoanStatus:
    values:
      - {name: Shelved, definition: "On the shelf."}
      - {name: Lent, definition: "With a member."}
entities:
  Loan:
    definition: "One copy lent to one member."
    attributes:
      - {name: status, type: LoanStatus}
    actions:
      - {name: lend, actor: Librarian}
-- design/machines/Desk.machine.json --
{
  "id": "desk",
  "_role": "operational",
  "_serves": ["act:Loan.lend"],
  "initial": "Idle",
  "_delays": {"cardTimeout": "2000 ms - upper bound on the card reader"},
  "states": {
    "Idle": {"on": {"lend": {"target": "checking"}}},
    "checking": {
      "invoke": {"src": "checkCard", "onDone": {"target": "Idle"}, "onError": {"target": "Idle"}},
      "after": {"cardTimeout": {"target": "Idle"}}
    }
  }
}
