design:
  models:
    - design/model/desk.modelith.yaml
import:
  machines:
    files: ["machines/*.json"]
    bind:
      desk: {lifecycle_of: Loan}
    annotate:
      desk:
        refusal_events: {lend_error: {action: lend, reason: "a refused loan\n  ERROR  fake: finding"}}
-- tab-action.yaml --
