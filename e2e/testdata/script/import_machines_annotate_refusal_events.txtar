    files: ["machines/*.json"]
    bind:
      desk: {lifecycle_of: Loan}
    annotate:
      desk:
        refusal_events: {lend_error: {action: "le\tnd", reason: "a refused loan changes nothing"}}
-- newline-alias.yaml --
