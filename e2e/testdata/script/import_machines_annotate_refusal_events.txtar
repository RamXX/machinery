          "target": "Lent"
        }
      },
      "_ignores": {
        "lend_error": "nothing is refused on the shelf",
        "giveBack": "the copy is on the shelf; refused with NOT_LENT",
        "count_failed": "a shelved copy is not counted"
      }
    },
    "Lent": {
      "on": {
        "lend_error": {
          "actions": "recordRefusal"
        },
        "giveBack": {
          "target": "Shelved"
        },
        "count_failed": {
          "target": "Shelved"
        }
      },
      "_ignores": {
        "lend": "already lent; the desk writes lend_error"
      }
    }
  }
}
-- two-reasons.yaml --
version: 2
design:
  models:
    - design/model/desk.modelith.yaml
import:
  machines:
    files: ["machines/*.json"]
    bind:
      desk: {lifecycle_of: Loan}
    annotate:
      desk:
        failure_events: ["*_failed"]
        aliases: {count_failed: writeOff}
        refusal_events: {lend_error: {action: lend, reason: "the desk entry says why"}}
      "machines/*.json":
        refusal_events: {lend_error: {action: lend, reason: "the glob entry says why"}}
-- newline-reason.yaml --
