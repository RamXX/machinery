-- failure-pattern.yaml --
version: 2
design:
  models:
    - design/model/desk.modelith.yaml
import:
  machines:
    files: ["machines/*.json"]
    bind:
      desk: {lifecycle_of: Loan}
    annotate:
      desk:
        aliases: {count_failed: writeOff}
        refusal_events: {lend_error: {action: lend, reason: "a refused loan changes nothing"}}
      "machines/*.json":
        failure_events: ["*_failed", "lend_err*"]
-- aliased.yaml --
version: 2
design:
  models:
    - design/model/desk.modelith.yaml
import:
  machines:
    files: ["machines/*.json"]
    bind:
      desk: {lifecycle_of: Loan}
    annotate:
      desk:
        failure_events: ["*_failed"]
        aliases: {count_failed: writeOff, lend_error: giveBack}
        refusal_events: {lend_error: {action: lend, reason: "a refused loan changes nothing"}}
-- no-reason.yaml --
version: 2
design:
  models:
    - design/model/desk.modelith.yaml
import:
  machines:
    files: ["machines/*.json"]
    bind:
      desk: {lifecycle_of: Loan}
    annotate:
      desk:
        refusal_events: {lend_error: {action: lend, reason: " "}}
-- desk-fails.json --
{
  "id": "desk",
  "_failure_events": ["lend_error"],
  "initial": "Shelved",
  "states": {
    "Shelved": {
      "on": {
