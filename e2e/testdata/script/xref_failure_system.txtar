# a failure mode about the system as a whole, or a named part of it that is not an entity, a
# dependency or a machine, has the subject system:<name>; the names are declared under systems in
# machinery.yaml (docs/formats.md sections 2, 5.4 and 6.6)
fixture shop
exec sh -c 'cat systems.yaml machinery.yaml > c.tmp && mv c.tmp machinery.yaml'
cp modes.yaml design/failure-modes.yaml

# a declared name resolves; no entity, state or event of the design is compared with it
exec machinery lint --stage failure-modes --stage xref-failure
stdout '^checked: 3 failure modes, 0 abuse cases$'
stdout '^checked: 3 failure modes, 1 invokes, 0 dependencies, 0 tiered actions, 0 failure states, 0 failure events$'
stdout '^machinery lint: 2 passed, 0 failed, 0 not demonstrated, 0 not applicable$'
exec machinery config
stdout '^systems:$'
stdout '^  - name: build$'

# a declared system that no failure mode names is no finding: nothing asks for one
cp one.yaml design/failure-modes.yaml
exec machinery lint --stage xref-failure
stdout '^passed$'

# an unknown name is an error
cp unknown.yaml design/failure-modes.yaml
exec mrun 1 lint --stage xref-failure
stdout '^  ERROR  unknown-system: system:warehouse: failure mode shelf-collapses: warehouse is not a configured system; declare it under systems in machinery.yaml \(no waiver covers an unknown system\)$'
stdout '^failed: 1 finding\(s\)$'
# and its failure mode is not linked
stdout '^checked: 2 failure modes, 1 linked, 1 unlinked, 1 invokes, '

# no waiver covers it: one on subject-resolves matches nothing and is stale, and the rule
# itself cannot be waived
cp machinery.yaml config.orig
exec sh -c 'printf "  - {rule: subject-resolves, id: \"system:warehouse\", reason: \"the warehouse is declared next\"}\n" >> machinery.yaml'
exec mrun 1 lint --stage xref-failure
stdout '^  ERROR  unknown-system: system:warehouse: '
stdout '^  ERROR  stale waiver: subject-resolves system:warehouse$'
! stdout 'waived'
cp config.orig machinery.yaml
exec sh -c 'printf "  - {rule: unknown-system, id: \"system:warehouse\", reason: \"the warehouse is declared next\"}\n" >> machinery.yaml'
exec mrun 2 lint --stage xref-failure
stderr '^config: waivers: "unknown-system" is not a rule that can be waived$'
cp config.orig machinery.yaml

# the value rules stay: required is mandatory, a name is needed, and an abuse case needs an
# act or entity subject
cp bad-values.yaml design/failure-modes.yaml
exec mrun 1 lint --stage failure-modes
stdout '^  ERROR  design/failure-modes.yaml: no-required: required must be fail-closed, retry-bounded, surface or refuse, got ""$'
stdout '^  ERROR  design/failure-modes.yaml: no-name: subject "system:" is not invoke:'
stdout '^  ERROR  design/failure-modes.yaml: abuse-build: kind: abuse needs an act or entity subject$'
stdout '^failed: 3 finding\(s\)$'

# config errors
cp no-name.yaml machinery.yaml
exec mrun 2 config
stderr '^config: systems: name is required$'
cp bad-name.yaml machinery.yaml
exec mrun 2 config
stderr '^config: systems: name "The Build" must match \^\[a-z\]\[a-z0-9-\]\*\$$'
cp twice.yaml machinery.yaml
exec mrun 2 config
stderr '^config: systems: duplicate name "build"$'

# an imported row is linked to a system like to anything else
fixture library lib
cd lib
exec sh -c 'cat ../lib-systems.yaml >> machinery.yaml'
cp ../lib-links.yaml design/risk-links.yaml
exec machinery lint --stage failure-modes --stage xref-failure
stdout '^checked: 4 failure modes, 1 abuse cases, 4 imported, 4 linked, 0 unlinked$'
stdout '^checked: 4 failure modes, 4 linked, 0 unlinked, '
stdout '^machinery lint: 2 passed, 0 failed, 0 not demonstrated, 0 not applicable$'

-- systems.yaml --
systems:
  - name: shop
    about: "the shop as a whole"
  - name: build
    about: "how the shop is built and released"
-- lib-systems.yaml --
systems:
  - {name: reading-room}
-- lib-links.yaml --
version: 1
links:
  - {id: RISK-1, kind: abuse, subject: "act:Loan.lend", required: refuse}
  - {id: RISK-2, subject: "invoke:hold_queue.sendNotice", required: retry-bounded}
  - {id: RISK-3, subject: "state:loan.Lost", required: surface}
  - {id: RISK-4, subject: "system:reading-room", required: surface}
-- modes.yaml --
version: 1
failure_modes:
  - id: payment-provider-down
    subject: invoke:order.chargePayment
    failure: "The payment provider does not answer or answers with an error."
    required: surface
    behavior: "The order returns to Pending and the caller sees PAYMENT_UNAVAILABLE."
  - id: release-unsigned
    subject: system:build
    failure: "A release is built without a signature."
    required: fail-closed
    behavior: "The release is not published."
  - id: clock-skew
    subject: system:shop
    failure: "The clocks of two hosts disagree by more than a minute."
    required: surface
    behavior: "The shop reports CLOCK_SKEW on its health endpoint."
-- one.yaml --
version: 1
failure_modes:
  - id: payment-provider-down
    subject: invoke:order.chargePayment
    failure: "The payment provider does not answer or answers with an error."
    required: surface
    behavior: "The order returns to Pending and the caller sees PAYMENT_UNAVAILABLE."
-- unknown.yaml --
version: 1
failure_modes:
  - id: payment-provider-down
    subject: invoke:order.chargePayment
    failure: "The payment provider does not answer or answers with an error."
    required: surface
    behavior: "The order returns to Pending and the caller sees PAYMENT_UNAVAILABLE."
  - id: shelf-collapses
    subject: system:warehouse
    failure: "A shelf gives way."
    required: surface
    behavior: "The stock count is corrected."
-- bad-values.yaml --
version: 1
failure_modes:
  - id: no-required
    subject: system:build
    failure: "x"
    behavior: "y"
  - id: no-name
    subject: "system:"
    failure: "x"
    required: surface
    behavior: "y"
  - id: abuse-build
    kind: abuse
    subject: system:build
    failure: "x"
    required: refuse
    behavior: "y"
-- no-name.yaml --
version: 2
systems:
  - {about: "nameless"}
-- bad-name.yaml --
version: 2
systems:
  - {name: "The Build"}
-- twice.yaml --
version: 2
systems:
  - {name: build}
  - {name: build}
