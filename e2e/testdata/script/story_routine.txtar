# the routine tier gate: proven ids, nothing owed, a proof for a commit the evidence is valid for (section 15.6)
fixture shop
exec sh -c 'printf "backlog:\n  tool: bd\n" >> machinery.yaml'
exec machinery gen
gitinit
exec bd init --stealth --non-interactive -p shop
exec bd create --id shop-r1 --title 'Prove pay and the terminal invariant' --body-file r1.txt --silent
exec bd create --id shop-o1 --title 'Prove the charge' --body-file o1.txt --silent
exec bd create --id shop-n1 --title 'No ids' --body-file n1.txt --silent
exec bd create --id shop-u1 --title 'Unknown id' --body-file u1.txt --silent

# a story without ids proves nothing
exec mrun 1 story shop-n1
stdout '^not demonstrated: story names no design ids$'

# no evidence and no proof
exec mrun 1 story shop-r1
stdout '^== story ==$'
stdout '^checked: 2 ids, 0 proofs, 0 predictions, 0 verdicts$'
stdout '^  ERROR  no proof for [0-9a-f]{7}: the builder runs machinery proof --story shop-r1 --post$'
stdout '^  ERROR  unproven: inv:terminal-is-final$'
stdout '^  ERROR  unproven: tc:ORDE-2e883d$'
stdout '^failed: 3 finding\(s\)$'

# evidence, still no proof
exec machinery run -- sh e2e/orders.sh
exec mrun 1 story shop-r1
stdout '^  ERROR  no proof for [0-9a-f]{7}'
! stdout 'unproven'

# a posted proof passes the routine gate
exec machinery proof --story shop-r1 --post
exec machinery story shop-r1
stdout '^checked: 2 ids, 1 proofs, 0 predictions, 0 verdicts$'
stdout '^passed$'
stdout '^machinery story: 1 passed, 0 failed, 0 not demonstrated, 0 not applicable$'

# an owed, partial id fails the gate even with a proof
exec mrun 1 proof --story shop-o1 --post
exec mrun 1 story shop-o1
stdout '^  ERROR  owed: tc:ORDE-8bd6e7$'
stdout '^  ERROR  unproven: tc:ORDE-8bd6e7$'
stdout '^failed: 2 finding\(s\)$'

# an unknown id
exec mrun 1 story shop-u1
stdout '^  ERROR  unknown id: tc:ORDE-ffffff$'

# a commit that changes only the owed file keeps the evidence and the proof valid
cp owed-reworded.yaml design/owed.yaml
gitcommit 'reword the owed list'
exec machinery story shop-r1
stdout '^passed$'

# uncommitted changes: the evidence does not describe the tree
exec sh -c 'printf "// a change\n" >> internal/domain/order.go'
exec mrun 1 story shop-r1
stdout '^  ERROR  working tree has uncommitted changes$'

# a code commit: the proof is for another commit, and so is the evidence
gitcommit 'change the code'
exec mrun 1 story shop-r1
stdout '^  ERROR  proof is for another commit: [0-9a-f]{7}; post a proof at [0-9a-f]{7} with machinery proof --story shop-r1 --post$'
stdout '^  ERROR  unproven: tc:ORDE-2e883d$'
exec machinery run -- sh e2e/orders.sh
exec mrun 1 story shop-r1
stdout '^  ERROR  proof is for another commit'
! stdout 'unproven'
exec machinery proof --story shop-r1 --post
exec machinery story shop-r1
stdout '^checked: 2 ids, 2 proofs, 0 predictions, 0 verdicts$'
stdout '^passed$'

# a failing receipt fails the gate, proof and status, also from a test that claims nothing (section 10.2)
exec machinery run -- sh fail.sh
exec mrun 1 story shop-r1
stdout '^  ERROR  failed: tc:ORDE-2e883d$'
! stdout 'inv:terminal-is-final'
exec mrun 1 proof --story shop-r1
stdout '^  tc:ORDE-2e883d -> fail\.sh -> FAIL: stayed Pending$'
exec machinery status
stdout '^proven: 13  partial: 1  failed: 1  '
exec mrun 1 verify --story shop-r1
stdout '^  ERROR  failed: tc:ORDE-2e883d \(fail\.sh\)$'
stdout '^  ERROR  receipt: tc:ORDE-2e883d: fail\.sh does not claim it; no file under trace\.tests is named fail\.sh: write test as <path of the test file> or <path>::<name>$'

-- r1.txt --
machinery:ids inv:terminal-is-final tc:ORDE-2e883d
machinery:scope internal/domain/**
-- o1.txt --
machinery:ids tc:ORDE-8bd6e7
-- n1.txt --
Nothing machine-readable here.
-- u1.txt --
machinery:ids tc:ORDE-ffffff
-- owed-reworded.yaml --
version: 1
owed:
  - id: fm:payment-provider-down
    reason: "no test induces an outage yet"
  - id: tc:ORDE-8bd6e7
    reason: "recordCharge is still a noop"
-- fail.sh --
#!/bin/sh
set -eu
[ -n "${MACHINERY_RECEIPTS:-}" ] || exit 0
printf '{"v":1,"type":"receipt","id":"tc:ORDE-2e883d","outcome":"fail","test":"fail.sh","effects":[],"observed":"stayed Pending"}\n' >> "$MACHINERY_RECEIPTS"
