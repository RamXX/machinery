# an owed id that is proven is a stale entry; owed sync --prune-only clears it (sections 11.2, 12)
fixture shop
exec machinery gen
gitinit
exec machinery run -- sh -c 'sh e2e/orders.sh && cat charge.jsonl >> "$MACHINERY_RECEIPTS"'
exec mrun 1 verify
stdout '^  ERROR  stale owed entry: tc:ORDE-8bd6e7 is proven$'
stdout '^checked: 16 obligations, 15 proven, 0 partial, 2 owed, 16 receipts$'
stdout '^failed: 1 finding\(s\)$'

exec machinery owed sync --prune-only
stdout '^owed: 1 kept, 0 added, 1 removed$'
! grep 'tc:ORDE-8bd6e7' design/owed.yaml
grep 'fm:payment-provider-down' design/owed.yaml

# the pruned owed file is not an uncommitted change for verify, and committing it keeps the evidence
exec machinery verify
stdout '^passed$'
gitcommit 'prune owed'
exec machinery verify
stdout '^checked: 16 obligations, 15 proven, 0 partial, 1 owed, 16 receipts$'
stdout '^passed$'

-- charge.jsonl --
{"v":1,"type":"receipt","id":"tc:ORDE-8bd6e7","outcome":"pass","test":"TestCharge","effects":["recordCharge"],"observed":"paying -> Paid; charge row written"}
