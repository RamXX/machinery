{"v":1,"type":"receipt","id":"cx:order-payment:known","outcome":"pass","test":"replay_test.go::TestReplayKnown","observed":"charged once","replay":"refuted"}
{"v":1,"type":"receipt","id":"cx:order-payment:lost","outcome":"pass","test":"replay_test.go::TestReplayLost","observed":"the order was not lost","replay":"refuted"}
