-- refuted.jsonl --
{"v":1,"type":"receipt","id":"cx:order-payment:race","outcome":"pass","test":"TestReplayRace","observed":"the second commit was refused","replay":"refuted"}
{"v":1,"type":"receipt","id":"cx:order-payment:known","outcome":"pass","test":"TestReplayKnown","observed":"charged once","replay":"refuted"}
{"v":1,"type":"receipt","id":"cx:order-payment:lost","outcome":"pass","test":"TestReplayLost","observed":"the order was not lost","replay":"refuted"}
