{"v":1,"type":"receipt","id":"cx:order-payment:known","outcome":"pass","test":"TestReplayKnown","observed":"charged twice","replay":"reproduced"}
{"v":1,"type":"receipt","id":"cx:order-payment:lost","outcome":"pass","test":"TestReplayLost","observed":"the order was lost","replay":"reproduced"}
