# cx ids are judged by the replay a receipt reports against the trace's expect (sections 12, 16.10)
fixture shop
exec machinery gen
grep '"id": "cx:order-payment:race"' design/gen/obligations.json
grep '"title": "Replay ChargedOnce \(order-payment run race\)"' design/gen/obligations.json
grep '"id": "cx:order-payment:lost"' design/gen/obligations.json
grep '"id": "cx:order-payment:known"' design/gen/obligations.json
gitinit

# no replay receipt: unproven
exec machinery run -- sh e2e/orders.sh
exec mrun 1 verify
stdout '^  ERROR  unproven: cx:order-payment:known$'
stdout '^  ERROR  unproven: cx:order-payment:lost$'
stdout '^  ERROR  unproven: cx:order-payment:race$'
stdout '^checked: 19 obligations, 14 proven, 1 partial, 2 owed, 15 receipts$'

# refuted: proves race (expect refuted); known (expect reproduced) and lost (undetermined) fail
rm .machinery/receipts
exec machinery run -- sh -c 'sh e2e/orders.sh && cat refuted.jsonl >> "$MACHINERY_RECEIPTS"'
exec mrun 1 verify
! stdout 'cx:order-payment:race'
stdout '^  ERROR  counterexample did not reproduce: cx:order-payment:known: the model is presumed wrong; fix the model, not the property$'
stdout '^  ERROR  counterexample did not reproduce: cx:order-payment:lost: the model is presumed wrong; fix the model, not the property$'
stdout '^checked: 19 obligations, 15 proven, 1 partial, 2 owed, 18 receipts$'
stdout '^failed: 2 finding\(s\)$'
exec machinery proof --ids cx:order-payment:race
stdout '^  cx:order-payment:race -> TestReplayRace -> pass: the second commit was refused$'
exec mrun 1 proof --ids cx:order-payment:lost
stdout '^  cx:order-payment:lost -> TestReplayLost -> FAIL: the order was not lost$'

# reproduced: proves known (expect reproduced); race (expect refuted) is a real bug, and so is lost
rm .machinery/receipts
exec machinery run -- sh -c 'sh e2e/orders.sh && cat reproduced.jsonl >> "$MACHINERY_RECEIPTS"'
exec mrun 1 verify
! stdout 'cx:order-payment:known'
stdout '^  ERROR  counterexample reproduced on the real system: cx:order-payment:lost: a real bug; fix the code, or record the run as a finding with a story$'
stdout '^  ERROR  counterexample reproduced on the real system: cx:order-payment:race: a real bug; fix the code, or record the run as a finding with a story$'
stdout '^failed: 2 finding\(s\)$'

# a cx receipt with outcome fail fails the id as any other
rm .machinery/receipts
exec machinery run -- sh -c 'sh e2e/orders.sh && cat failcx.jsonl >> "$MACHINERY_RECEIPTS"'
exec mrun 1 verify
stdout '^  ERROR  failed: cx:order-payment:race \(TestReplayRace\)$'

-- design/formal/traces/order-payment.race.trace.json --
{
  "version": 1,
  "id": "cx:order-payment:race",
  "spec": "order-payment",
  "run": "race",
  "tool": "tla",
  "violates": "ChargedOnce",
  "expect": "refuted",
  "machine": "order",
  "steps": [
    {"n": 1, "case": "tc:ORDE-2e883d", "instance": "i1", "caller": "c2", "step": "begin", "state": {"i1": "Pending"}},
    {"n": 2, "case": "tc:ORDE-2e883d", "instance": "i1", "caller": "c1", "step": "begin", "state": {"i1": "Pending"}},
    {"n": 3, "case": "tc:ORDE-2e883d", "instance": "i1", "caller": "c1", "step": "commit", "state": {"i1": "paying"}},
    {"n": 4, "case": "tc:ORDE-2e883d", "instance": "i1", "caller": "c2", "step": "commit", "state": {"i1": "paying"}}
  ],
  "loop": 0,
  "instance": {}
}
