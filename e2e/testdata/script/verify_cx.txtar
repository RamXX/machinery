-- e2e/replay_test.go --
package e2e

import "testing"

// machinery:verifies cx:order-payment:race cx:order-payment:known cx:order-payment:lost
func TestReplayRace(t *testing.T) {}
func TestReplayKnown(t *testing.T) {}
func TestReplayLost(t *testing.T) {}
