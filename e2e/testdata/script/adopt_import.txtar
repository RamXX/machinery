# adopt works with a machinery.yaml that imports machines: it counts them and adds no design.machines
fixture empty
cp config.yaml machinery.yaml
mkdir machines e2e internal/desk
cp desk.go internal/desk/desk.go
cp loan-desk.json machines/loan-desk.json
cp hold.json machines/hold.json
cp smoke.sh e2e/smoke.sh
gitinit

exec machinery adopt --paths 'internal/**'
stdout '^design: 0 model\(s\), 2 machine\(s\), 0 contract\(s\)$'
stdout '^  design/gen/imported/machines/loan_desk.machine.json  generated by machinery gen$'
stdout '^  design/owed.yaml  new owed entries: '
! stdout 'design.machines'

exec machinery adopt --paths 'internal/**' --write
stdout 'design/gen/imported/machines/hold_queue.machine.json'
stdout '^  design/owed.yaml$'
! grep 'design/machines' machinery.yaml
grep 'files: \["machines/\*.json"\]' machinery.yaml
grep -count=1 'machines:' machinery.yaml
grep 'id: tc:LOAN0E11-' design/owed.yaml
grep 'id: tc:HOLDED73-' design/owed.yaml
exec machinery lint --stage machines
stdout 'checked: 2 machines'
gitcommit adopted

# the translated files under the gen directory are not taken for design sources, and a second run writes nothing
exec machinery adopt --paths 'internal/**'
stdout '^design: 0 model\(s\), 2 machine\(s\), 0 contract\(s\)$'
exec machinery adopt --paths 'internal/**' --write
cmp stdout want-nothing.txt
exec mrun 0 check --stage machines --stage gen-drift --stage trace
stdout 'checked: 1 code files, 1 test files, 0 act ids, 15 obligations'

-- config.yaml --
version: 2
scope: ["internal/**"]
import:
  machines:
    files: ["machines/*.json"]
    states: capitalize
    rename:
      root: {notes: _comment, remark: _comment, startable: _entries, entity: _lifecycle_of}
      state: {skip: _ignores}
      transition: {allowed: _requires, denied: _refusal}
-- loan-desk.json --
{
  "id": "loan-desk",
  "notes": "the circulation desk",
  "remark": {"since": 2019},
  "startable": ["lent"],
  "initial": "shelved",
  "states": {
    "shelved": {
      "on": {
        "lend": {"target": "lent", "guard": "memberInGoodStanding", "allowed": ["Librarian"], "denied": "a member with fines is refused with MEMBER_BLOCKED"}
      },
      "skip": {"giveBack": "nothing is lent; the desk refuses with NOT_LENT"}
    },
    "lent": {
      "on": {
        "giveBack": {"target": "#loan-desk.shelved", "allowed": ["Member", "Librarian"]}
      },
      "skip": {"lend": "already lent; the desk refuses with ALREADY_LENT"}
    }
  }
}
-- hold.json --
{
  "id": "hold.queue",
  "entity": "Hold",
  "initial": "waiting",
  "_delays": {
    "holdExpiry": "604800000 ms - a hold lasts seven days",
    "noticeTimeout": "30000 ms - upper bound on the notice service"
  },
  "states": {
    "waiting": {
      "on": {"notify": {"target": "notifying"}},
      "after": {"holdExpiry": [{"target": "expired", "guard": "nobodyNotified", "denied": "a notified hold waits for pickup"}]},
      "skip": {"collect": "nothing to collect yet; the desk refuses with HOLD_NOT_READY"}
    },
    "notifying": {
      "invoke": {
        "src": "sendNotice",
        "onDone": {"target": "ready", "guard": "noticeDelivered", "denied": "an undelivered notice keeps the hold waiting"},
        "onError": {"target": "waiting"}
      },
      "after": {"noticeTimeout": {"target": "waiting"}}
    },
    "ready": {
      "on": {"collect": {"target": "collected"}},
      "skip": {"notify": "already notified"}
    },
    "expired": {"type": "final"},
    "collected": {"type": "final"}
  }
}
-- desk.go --
package desk

// Lend is a placeholder for the desk behavior.
func Lend() {}
-- smoke.sh --
#!/bin/sh
true
-- want-nothing.txt --
adopt: wrote 0 file(s)
