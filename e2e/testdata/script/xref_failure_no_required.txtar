# a links entry that names a subject which resolves and no required value is no finding of stage
# failure-modes and stops nothing: the row is unlinked for the verdict of stage xref-failure and
# counted on its own, by both stages, in the stage and in assess (docs/formats.md sections 5.4.1,
# 6.3 and 6.6)
exec mrun 1 lint --stage failure-modes --stage xref-failure
! stdout 'ERROR'
stdout '^checked: 3 failure modes, 0 abuse cases, 3 imported, 1 linked, 2 unlinked, 1 name a subject and no required value$'
stdout '^passed$'
stdout '^checked: 3 failure modes, 1 linked, 2 unlinked, 1 name a subject and no required value, 0 invokes, 0 dependencies, 0 tiered actions, 0 failure states, 0 failure events$'
stdout '^not demonstrated: 2 of 3 failure modes name no subject; link each in design/links.yaml or declare it there with no_subject and a reason; 1 of them name a subject and no required value: add required to each$'
exec machinery gen
stdout '^gen: wrote [0-9]+ file\(s\)$'
grep '"id": "fm:risk-1"' design/gen/obligations.json

# a required value that is given and is none of the four stays an error, and stops generation; the
# row is still counted as naming a subject and no required value
cp links-bogus.yaml design/links.yaml
exec mrun 1 lint --stage failure-modes --stage xref-failure
stdout '^  ERROR  design/links.yaml: RISK-3: required must be fail-closed, retry-bounded, surface or refuse, got "sometimes"$'
stdout -count=1 'ERROR'
stdout '^checked: 3 failure modes, 0 abuse cases, 3 imported, 1 linked, 2 unlinked, 2 name a subject and no required value$'
stdout '^checked: 3 failure modes, 1 linked, 2 unlinked, 2 name a subject and no required value, 0 invokes, '
stdout '; 2 of them name a subject and no required value: add required to each$'
exec mrun 1 gen
stdout '^gen: refused: the design has errors; nothing was written$'

# a subject that names nothing in the design is a finding of subject-resolves, with a required value
# or without one, and is not counted as naming a subject; nor is a row no entry names
cp links-nothing.yaml design/links.yaml
exec mrun 1 lint --stage failure-modes --stage xref-failure
stdout '^checked: 3 failure modes, 0 abuse cases, 3 imported, 1 linked, 2 unlinked$'
stdout '^passed$'
stdout '^  ERROR  subject-resolves: act:Loan\.burn: failure mode risk-1: Loan\.burn is not an action of the model$'
stdout -count=1 'ERROR'
stdout '^checked: 3 failure modes, 1 linked, 2 unlinked, 0 invokes, '
stdout '^failed: 1 finding\(s\)$'
! stdout 'no required value'

# with the value the row is linked, and the count is gone
cp links-full.yaml design/links.yaml
exec mrun 1 lint --stage failure-modes --stage xref-failure
stdout '^checked: 3 failure modes, 0 abuse cases, 3 imported, 2 linked, 1 unlinked$'
stdout '^checked: 3 failure modes, 2 linked, 1 unlinked, 0 invokes, '
! stdout 'no required value'

# a native failure mode is counted the same way; in the failure-mode file required stays required
cp native.yaml design/failure-modes.yaml
cp with-native.yaml machinery.yaml
exec mrun 1 lint --stage failure-modes --stage xref-failure
stdout '^  ERROR  design/failure-modes.yaml: reader-down: required must be fail-closed, retry-bounded, surface or refuse, got ""$'
stdout '^checked: 4 failure modes, 0 abuse cases, 3 imported, 2 linked, 2 unlinked, 1 name a subject and no required value$'
stdout '^checked: 4 failure modes, 2 linked, 2 unlinked, 1 name a subject and no required value, 0 invokes, '

# assess carries the count: in the stage output and in the report
mkdir proj/design/model proj/docs
cp machinery.orig proj/machinery.yaml
cp links.yaml proj/design/links.yaml
cp docs/risks.md proj/docs/risks.md
cp design/model/desk.modelith.yaml proj/design/model/desk.modelith.yaml
cd proj
gitinit
cd $WORK
exec machinery -C proj assess --out out
grep '^checked: 3 failure modes, 0 abuse cases, 3 imported, 1 linked, 2 unlinked, 1 name a subject and no required value$' out/stages/failure-modes.txt
grep '^passed$' out/stages/failure-modes.txt
grep '^checked: 3 failure modes, 1 linked, 2 unlinked, 1 name a subject and no required value, 0 invokes, ' out/stages/xref-failure.txt
grep '^\| xref-failure \| not demonstrated: 2 of 3 failure modes name no subject; .*; 1 of them name a subject and no required value: add required to each \| 3 failure modes, 1 linked, 2 unlinked, 1 name a subject and no required value, 0 invokes, ' out/report.md
grep '"noun": "name a subject and no required value"' out/report.json

-- machinery.yaml --
version: 2
design:
  models:
    - design/model/desk.modelith.yaml
import:
  failure_modes:
    file: docs/risks.md
    id: "^RISK-[0-9]+$"
    columns:
      failure: ["Failure"]
      behavior: ["Required behavior"]
    links: design/links.yaml
-- machinery.orig --
version: 2
design:
  models:
    - design/model/desk.modelith.yaml
import:
  failure_modes:
    file: docs/risks.md
    id: "^RISK-[0-9]+$"
    columns:
      failure: ["Failure"]
      behavior: ["Required behavior"]
    links: design/links.yaml
-- with-native.yaml --
version: 2
design:
  models:
    - design/model/desk.modelith.yaml
  failure_modes: design/failure-modes.yaml
import:
  failure_modes:
    file: docs/risks.md
    id: "^RISK-[0-9]+$"
    columns:
      failure: ["Failure"]
      behavior: ["Required behavior"]
    links: design/links.yaml
-- native.yaml --
version: 1
failure_modes:
  - id: reader-down
    subject: entity:Loan
    failure: "The reader is down."
    behavior: "The desk says so."
-- design/links.yaml --
version: 1
links:
  - {id: RISK-1, subject: "act:Loan.lend"}
  - {id: RISK-2, subject: "act:Loan.lend", required: surface}
-- links.yaml --
version: 1
links:
  - {id: RISK-1, subject: "act:Loan.lend"}
  - {id: RISK-2, subject: "act:Loan.lend", required: surface}
-- links-bogus.yaml --
version: 1
links:
  - {id: RISK-1, subject: "act:Loan.lend"}
  - {id: RISK-2, subject: "act:Loan.lend", required: surface}
  - {id: RISK-3, subject: "entity:Loan", required: sometimes}
-- links-nothing.yaml --
version: 1
links:
  - {id: RISK-1, subject: "act:Loan.burn"}
  - {id: RISK-2, subject: "act:Loan.lend", required: surface}
-- links-full.yaml --
version: 1
links:
  - {id: RISK-1, subject: "act:Loan.lend", required: fail-closed}
  - {id: RISK-2, subject: "act:Loan.lend", required: surface}
-- docs/risks.md --
# Risks

| Risk | Failure | Required behavior |
|------|---------|-------------------|
| RISK-1 | The card reader is down. | The desk refuses the loan with READER_DOWN. |
| RISK-2 | A loan is recorded twice. | The second record is refused. |
| RISK-3 | The shelf list is out of date. | The desk recounts the shelf. |
-- design/model/desk.modelith.yaml --
kind: DomainModel
version: v1
title: Desk
enums:
  LoanStatus:
    values:
      - {name: Shelved, definition: "On the shelf."}
      - {name: Lent, definition: "With a member."}
entities:
  Loan:
    definition: "One copy lent to one member."
    attributes:
      - {name: status, type: LoanStatus}
    actions:
      - {name: lend, actor: Librarian}
