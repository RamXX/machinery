# branch order, duplicate guards, empty lists, always lists
fixture shop

# an unguarded branch that is not last shadows the rest
cp shadowed.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: state Pending on:pay branch 1 is unguarded but not last; later branches are unreachable$'
stdout '^failed: 1 finding\(s\)$'

# two branches with one guard
cp dup_guard.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: state Pending on:pay has two branches with the same guard \(hasPaymentMethod\); the second is unreachable$'
stdout '^failed: 1 finding\(s\)$'
stdout '^checked: 1 machines, 5 states, 9 transitions$'

# an empty branch list swallows its trigger
cp empty_list.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: state Pending on:cancel has no branches \(an empty branch list silently swallows the trigger\)$'
stdout '^  ERROR  design/machines/Order\.machine\.json: empty transition branch list in Pending on:cancel \(the trigger would be silently swallowed\)$'
stdout '^failed: 2 finding\(s\)$'
stdout '^checked: 1 machines, 5 states, 7 transitions$'

# an empty guard string is not a guard
cp empty_guard.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: empty guard string in Pending on:pay \(write an unguarded branch instead\)$'
stdout '^  ERROR  design/machines/Order\.machine\.json: state Pending on:pay branch 1 is unguarded but not last; later branches are unreachable$'
stdout '^failed: 2 finding\(s\)$'

# a fully guarded always list with no escape is stuck when no guard holds
cp always_stuck.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: state route has a fully guarded always-list and no unguarded escape \(after/on/invoke\); if no guard is true the machine is stuck\. Add an unguarded fallback branch, or an _exhaustive note stating why the guards are total$'
stdout '^failed: 1 finding\(s\)$'
stdout '^checked: 1 machines, 6 states, 10 transitions$'

# an _exhaustive note states why the guards are total
cp always_exhaustive.json design/machines/Order.machine.json
exec machinery lint --stage machines
stdout '^checked: 1 machines, 6 states, 10 transitions$'
stdout '^passed$'

-- shadowed.json --
{
  "_comment": "Order lifecycle. Domain states mirror the OrderStatus enum; `paying` is the transient overlay around the payment call.",
  "_delays": {
    "payTimeout": "5000 ms - upper bound on the payment provider call"
  },
  "id": "order",
  "initial": "Pending",
  "context": {
    "orderId": null,
    "lastError": null
  },
  "states": {
    "Pending": {
      "on": {
        "pay": [
          {
            "actions": "recordPayRefused"
          },
          {
            "target": "paying",
            "guard": "hasPaymentMethod",
            "actions": "stampAttempt"
          }
        ],
        "cancel": {
          "target": "Cancelled",
          "actions": "recordCancellation"
        }
      },
      "_ignores": {
        "ship": "an unpaid order cannot ship; the API refuses with ORDER_NOT_PAID"
      }
    },
    "paying": {
      "invoke": {
        "src": "chargePayment",
        "onDone": {
          "target": "Paid",
          "actions": "recordCharge"
        },
        "onError": {
          "target": "Pending",
          "actions": "recordPaymentFailure"
        }
      },
      "after": {
        "payTimeout": {
          "target": "Pending",
          "actions": "recordPaymentTimeout"
        }
      }
    },
    "Paid": {
      "on": {
        "ship": {
          "target": "Shipped",
          "actions": "recordShipment"
        },
        "cancel": {
          "target": "Cancelled",
          "actions": [
            "refundPayment",
            "recordCancellation"
          ]
        }
      },
      "_ignores": {
        "pay": "already paid; a repeated pay is refused with ORDER_ALREADY_PAID"
      }
    },
    "Shipped": {
      "type": "final",
      "entry": "notifyCustomer"
    },
    "Cancelled": {
      "type": "final"
    }
  }
}
