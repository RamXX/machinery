# machines kept in a project's own JSON dialect are translated in memory and read as native files
fixture empty
cp config.yaml machinery.yaml
mkdir machines
cp loan-desk.json machines/loan-desk.json
cp hold.json machines/hold.json
cp loan-desk.json loan-desk.orig
exec machinery lint --stage machines
stdout '(?s)== machines ==\nchecked: 2 machines, 7 states, 8 transitions\npassed\n'

# gen writes the translated machines beside the tables; the sources are never written
exec machinery gen
stdout 'gen: wrote 7 file\(s\)'
stdout 'design/gen/imported/machines/loan_desk.machine.json'
stdout 'design/gen/imported/machines/hold_queue.machine.json'
stdout 'design/gen/tables/loan_desk.table.json'
stdout 'design/gen/tables/hold_queue.table.md'
cmp machines/loan-desk.json loan-desk.orig
cmp design/gen/imported/machines/loan_desk.machine.json want-loan.json

# a transition key renamed to _refusal moves to its state, keyed by the handler
grep '"after:holdExpiry": "a notified hold waits for pickup"' design/gen/imported/machines/hold_queue.machine.json
grep '"sendNotice.onDone": "an undelivered notice keeps the hold waiting"' design/gen/imported/machines/hold_queue.machine.json
! grep 'denied' design/gen/imported/machines/hold_queue.machine.json
# the translation never invents a binding; every machine gets a tag from its id
grep '"_lifecycle_of": "Hold"' design/gen/imported/machines/hold_queue.machine.json
! grep '_role' design/gen/imported/machines/hold_queue.machine.json
grep '"_oracle_tag": "HOLDED73"' design/gen/imported/machines/hold_queue.machine.json
grep '"initial": "Waiting"' design/gen/imported/machines/hold_queue.machine.json

# the table and the obligations name the source file, and the case ids use the tag
grep '"source": "machines/loan-desk.json"' design/gen/tables/loan_desk.table.json
grep '"tag": "LOAN0E11"' design/gen/tables/loan_desk.table.json
grep '"entries": \[' design/gen/tables/loan_desk.table.json
grep '"source_sha256": "f9d5bc493074f5a1cb2fc5d5acda68d4fbf9ef01322821685223a4ba8a429aff"' design/gen/tables/loan_desk.table.json
grep '"id": "tc:LOAN0E11-[0-9a-f]{6}"' design/gen/obligations.json
grep '"source": "machines/loan-desk.json"' design/gen/obligations.json
grep '"title": "Shelved on:lend \[memberInGoodStanding\] -> Lent"' design/gen/obligations.json
grep '"title": "Shelved refusal:lend -> \(unchanged\)"' design/gen/obligations.json
grep 'Generated by machinery gen from machines/loan-desk.json' design/gen/tables/loan_desk.table.md

# gen --check holds the translated files like every generated file
exec machinery gen --check
stdout 'checked: 7 generated files'
stdout '^passed$'
exec sh -c 'sed "s/ALREADY_LENT/LENT_ALREADY/" machines/loan-desk.json > m.tmp && mv m.tmp machines/loan-desk.json'
exec mrun 1 gen --check
stdout 'DRIFT  design/gen/imported/machines/loan_desk.machine.json: stale'
stdout 'DRIFT  design/gen/tables/loan_desk.table.json: stale'
! stdout 'hold_queue'
exec machinery gen
exec sh -c 'echo "{}" > design/gen/imported/machines/hold_queue.machine.json'
exec mrun 1 gen --check
stdout 'DRIFT  design/gen/imported/machines/hold_queue.machine.json: stale'
exec machinery gen
rm machines/hold.json
exec mrun 1 gen --check
stdout 'ERROR  design/gen/imported/machines/hold_queue.machine.json: unexpected file in gen directory'

# findings name the source file; a key the rename does not cover is still an error
cp loan-colour.json machines/loan-desk.json
exec mrun 1 lint --stage machines
stdout 'ERROR  machines/loan-desk.json: unsupported key .colour. in state Shelved'
stdout 'ERROR  machines/loan-desk.json: unsupported root key .shelfmark.'

# with states: keep the names stay as written
exec sh -c 'sed "s/capitalize/keep/" config.yaml > machinery.yaml'
cp loan-desk.orig machines/loan-desk.json
exec machinery gen
grep '"initial": "shelved"' design/gen/imported/machines/loan_desk.machine.json
grep '"target": "#loan_desk.shelved"' design/gen/imported/machines/loan_desk.machine.json
grep '"lent"' design/gen/imported/machines/loan_desk.machine.json

# ids that share a prefix get different tags
exec sh -c 'sed "s/\"loan-desk\"/\"loan-desk-annex\"/; s/#loan-desk/#loan-desk-annex/" loan-desk.orig > machines/annex.json'
exec machinery lint --stage machines
stdout 'checked: 2 machines'
exec machinery gen
grep '"_oracle_tag": "LOAN5619"' design/gen/imported/machines/loan_desk_annex.machine.json
grep '"_oracle_tag": "LOAN0E11"' design/gen/imported/machines/loan_desk.machine.json

-- config.yaml --
version: 2
import:
  machines:
    files: ["machines/*.json"]
    states: capitalize
    rename:
      root: {notes: _comment, remark: _comment, startable: _entries, entity: _lifecycle_of}
      state: {skip: _ignores}
      transition: {allowed: _requires, denied: _refusal}
-- loan-desk.json --
{
  "id": "loan-desk",
  "notes": "the circulation desk",
  "remark": {"since": 2019},
  "startable": ["lent"],
  "initial": "shelved",
  "states": {
    "shelved": {
      "on": {
        "lend": {"target": "lent", "guard": "memberInGoodStanding", "allowed": ["Librarian"], "denied": "a member with fines is refused with MEMBER_BLOCKED"}
      },
      "skip": {"giveBack": "nothing is lent; the desk refuses with NOT_LENT"}
    },
    "lent": {
      "on": {
        "giveBack": {"target": "#loan-desk.shelved", "allowed": ["Member", "Librarian"]}
      },
      "skip": {"lend": "already lent; the desk refuses with ALREADY_LENT"}
    }
  }
}
-- hold.json --
{
  "id": "hold.queue",
  "entity": "Hold",
  "initial": "waiting",
  "_delays": {
    "holdExpiry": "604800000 ms - a hold lasts seven days",
    "noticeTimeout": "30000 ms - upper bound on the notice service"
  },
  "states": {
    "waiting": {
      "on": {"notify": {"target": "notifying"}},
      "after": {"holdExpiry": [{"target": "expired", "guard": "nobodyNotified", "denied": "a notified hold waits for pickup"}]},
      "skip": {"collect": "nothing to collect yet; the desk refuses with HOLD_NOT_READY"}
    },
    "notifying": {
      "invoke": {
        "src": "sendNotice",
        "onDone": {"target": "ready", "guard": "noticeDelivered", "denied": "an undelivered notice keeps the hold waiting"},
        "onError": {"target": "waiting"}
      },
      "after": {"noticeTimeout": {"target": "waiting"}}
    },
    "ready": {
      "on": {"collect": {"target": "collected"}},
      "skip": {"notify": "already notified"}
    },
    "expired": {"type": "final"},
    "collected": {"type": "final"}
  }
}
-- want-loan.json --
{
  "id": "loan_desk",
  "_comment": "notes: the circulation desk | remark: {\"since\":2019}",
  "_entries": [
    "Lent"
  ],
  "initial": "Shelved",
  "states": {
    "Shelved": {
      "on": {
        "lend": {
          "target": "Lent",
          "guard": "memberInGoodStanding",
          "_requires": [
            "Librarian"
          ]
        }
      },
      "_ignores": {
        "giveBack": "nothing is lent; the desk refuses with NOT_LENT"
      },
      "_refusal": {
        "lend": "a member with fines is refused with MEMBER_BLOCKED"
      }
    },
    "Lent": {
      "on": {
        "giveBack": {
          "target": "#loan_desk.Shelved",
          "_requires": [
            "Member",
            "Librarian"
          ]
        }
      },
      "_ignores": {
        "lend": "already lent; the desk refuses with ALREADY_LENT"
      }
    }
  },
  "_oracle_tag": "LOAN0E11"
}
-- loan-colour.json --
{
  "id": "loan-desk",
  "shelfmark": "A1",
  "initial": "shelved",
  "states": {
    "shelved": {
      "colour": "blue",
      "on": {"lend": {"target": "lent"}}
    },
    "lent": {
      "on": {"giveBack": {"target": "shelved"}}
    }
  }
}
