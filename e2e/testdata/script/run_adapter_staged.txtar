// machinery:verifies sc:customer-pays-and-the-order-ships
-- staged.part --
evidence:
  adapter:
    sources:
      - package: "example.test/shop/e2e/testdata/sets/*"
        files: ["e2e/testdata/sets/*/*.go"]
      - package: "example.test/shop/e2e/testdata/notes"
        files: ["e2e/testdata/notes/*.go"]
-- loose.part --
evidence:
  adapter:
    sources:
      - package: "command-line-arguments"
        files: ["e2e/testdata/sets/*/*.go"]
-- nothing.part --
evidence:
  adapter:
    sources:
      - package: "example.test/shop/e2e/testdata/sets/*"
        files: ["e2e/testdata/sets/*/*.go.txt"]
-- dir.part --
evidence:
  adapter:
    sources:
      - package: "example.test/shop/e2e/..."
        dir: true
-- wide.part --
evidence:
  adapter:
    sources:
      - package: "example.test/shop/e2e/**"
        files: ["e2e/**/*_test.go"]
-- suite-dir.part --
evidence:
  adapter:
    sources:
      - package: "example.test/shop/e2e/suite/..."
        dir: true
-- exact.part --
evidence:
  adapter:
    sources:
      - package: "example.test/shop/e2e/suite"
        files: ["e2e/suite/*_test.go", "e2e/testdata/staged/*_test.go"]
-- dir-nothing.part --
evidence:
  adapter:
    sources:
      - package: "example.test/shop/nothing/..."
        dir: true
-- both.part --
evidence:
  adapter:
    sources:
      - package: "example.test/shop/e2e/..."
        files: ["e2e/suite/*_test.go"]
        dir: true
-- pattern.part --
evidence:
  adapter:
    sources:
      - package: "example.test/shop/e2e/*"
        dir: true
-- neither.part --
evidence:
  adapter:
    sources:
      - package: "example.test/shop/e2e/..."
