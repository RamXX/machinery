-- e2e/testdata/sets/ledger/ledger.go --
package sets

import (
	"os"
	"testing"
)

// TestBalance has the name of a function of the orders set. LEDGER_FAIL fails it.
//
// machinery:verifies inv:customer-email-unique
func TestBalance(t *testing.T) {
	if os.Getenv("LEDGER_FAIL") != "" {
		t.Fatal("the ledger does not balance")
	}
}
-- e2e/testdata/notes/notes.go --
package notes

// The claim of this staged source stands above no function, and it has no test function.
//
// machinery:verifies sc:cancelled-order-refuses-payment
-- broken.go --
package sets

import "testing"

// TestBroken does not build, and with it the whole set.
func TestBroken(t *testing.T) {
	var n int = "one"
	_ = n
}
-- more_test.go --
package more

import (
	"os"
	"path/filepath"
	"testing"
)

// TestEmailUnique has the name of a function of the suite. It fails in the directory
// MORE_FAILS_IN names.
//
// machinery:verifies inv:customer-email-unique
func TestEmailUnique(t *testing.T) {
	if wd, _ := os.Getwd(); filepath.Base(wd) == os.Getenv("MORE_FAILS_IN") {
		t.Fatal("second customer with the same email accepted")
	}
}
