# test sources a project keeps outside *_test.go files and stages before go test, sets of them
# named with go tool test2json -p, and the forms of evidence.adapter.sources (section 10.3): an
# entry with a wildcard maps each package to the files of its own directory when it names some,
# and dir: true maps every package of a pattern to the test files of its own directory
fixture shop
fixture shop-gotests
cp machinery.yaml base.yaml
exec sh -c 'cat base.yaml staged.part > machinery.yaml'
exec machinery gen
gitinit

# two sets of staged sources under e2e/testdata/sets, named by the import path of the directory
# their sources are kept in: one entry maps each set to its own sources. Both sets define
# TestBalance, and each verdict goes to the file of its own set: the name is not ambiguous
exec machinery run --adapter go-test-json --streams -- sh sets.sh
stdout '^sets: 2 set\(s\), exit 0$'
stderr '^machinery run: adapter go-test-json: 2 stream\(s\), 2 package\(s\), 3 test function\(s\) with a verdict: 3 passed, 0 failed, 0 skipped$'
stderr '^machinery run: adapter: receipts written: 3 pass, 0 fail, 0 skip$'
! stderr 'ambiguous'
! stderr 'no file under trace\.tests belongs to'
! stderr 'defined in no candidate file'
# the claims of the suite and of the notes file are of no package of the run: they count only in
# the project-wide line, the notes file among the claiming files with no test function
stderr '^machinery run: adapter: claimed, not run: 0 id\(s\)$'
stderr '^machinery run: adapter: in the whole project: 3 claimed id\(s\) not run, 1 claiming file\(s\) with no test function, 0 claim\(s\) above functions the adapter does not judge$'
! stderr 'no test function; its claims count nothing'
exec sh -c 'grep -h "\"type\":\"receipt\"" .machinery/receipts/*.jsonl'
stdout '"id":"inv:customer-email-unique","outcome":"pass","test":"e2e/testdata/sets/ledger/ledger\.go::TestBalance","observed":"go test: TestBalance passed"'
stdout '"id":"inv:paid-before-shipped","outcome":"pass","test":"e2e/testdata/sets/orders/orders\.go::TestBalance"'
stdout '"id":"inv:terminal-is-final","outcome":"pass","test":"e2e/testdata/sets/orders/orders\.go::TestShipOnce"'
exec mrun 1 verify
! stdout 'does not claim it'
# the suite claims the same ids and did not run: every claimant of them must pass, so each is
# partly run, the pass of its set counted among its claimants
stdout '^checked: 16 obligations, 0 proven, 0 partial, 3 partly run, 2 owed, 3 receipts$'
stdout '^  ERROR  partly run: inv:customer-email-unique: 1 of 2 claimants passed: run the claimants without a pass at this commit, or excuse those that cannot run here in evidence\.adapter\.excused$'
stdout '^  warn   partly run: inv:customer-email-unique: no verdict: e2e/suite/email_test\.go::TestEmailUnique$'
stdout '^  ERROR  partly run: inv:paid-before-shipped: 1 of 2 claimants passed: run the claimants without a pass at this commit, or excuse those that cannot run here in evidence\.adapter\.excused$'
stdout '^  ERROR  partly run: inv:terminal-is-final: 1 of 2 claimants passed: run the claimants without a pass at this commit, or excuse those that cannot run here in evidence\.adapter\.excused$'

# Relabeling the Package field of go test -json events gives the same receipts as test2json -p.
exec bash latest-receipts.sh
cp stdout sets.want
exec machinery run --adapter go-test-json --streams -- bash relabeled.sh
stderr '^machinery run: adapter go-test-json: 2 stream\(s\), 2 package\(s\), 3 test function\(s\) with a verdict: 3 passed, 0 failed, 0 skipped$'
stderr '^machinery run: adapter: receipts written: 3 pass, 0 fail, 0 skip$'
exec bash latest-receipts.sh
cmp stdout sets.want

# a fail goes by name: TestBalance fails in the ledger set, and the TestBalance of the orders set,
# which passed, is read as failed too. That is the false fail the contract names; renaming one
# of the two functions removes it
env LEDGER_FAIL=1
exec mrun 1 run --adapter go-test-json --streams -- sh sets.sh
env LEDGER_FAIL=
stderr '^machinery run: adapter: TestBalance: failed in package\(s\) example\.test/shop/e2e/testdata/sets/ledger, so read as failed in e2e/testdata/sets/orders/orders\.go: a fail goes by name to every file of evidence\.adapter\.sources that defines it; rename one of the functions if they are unrelated$'
stderr '^machinery run: adapter: receipts written: 1 pass, 2 fail, 0 skip$'
exec sh -c 'grep -h inv:paid-before-shipped "$(ls .machinery/receipts/*.jsonl | tail -n 1)"'
stdout '"outcome":"fail","test":"e2e/testdata/sets/orders/orders\.go::TestBalance","observed":"go test: TestBalance failed"'

# a set that does not build: the wrapper writes a stream that says its package failed, and no
# test of it ran. Every test function of its sources failed
cp broken.go e2e/testdata/sets/ledger/broken.go
exec mrun 1 run --adapter go-test-json --streams -- sh sets.sh
stdout '^sets: 2 set\(s\), exit 1$'
stderr '^machinery run: adapter: package example\.test/shop/e2e/testdata/sets/ledger: did not run its tests: 2 test function\(s\) read as failed: TestBalance, TestBroken$'
stderr '^machinery run: adapter: receipts written: 2 pass, 1 fail, 0 skip$'
exec sh -c 'grep -h inv:customer-email-unique "$(ls .machinery/receipts/*.jsonl | tail -n 1)"'
stdout '"outcome":"fail","test":"e2e/testdata/sets/ledger/ledger\.go::TestBalance","observed":"go test: TestBalance: the package did not run its tests"'
rm e2e/testdata/sets/ledger/broken.go

# go test on loose files names every set command-line-arguments: the sets cannot be told apart,
# the entry for that name maps every file to it, and TestBalance is ambiguous
exec sh -c 'cat base.yaml loose.part > machinery.yaml'
gitcommit 'the sets as command-line-arguments'
rm .machinery/receipts
exec machinery run --adapter go-test-json --streams -- sh loose.sh
stderr '^machinery run: adapter go-test-json: 2 stream\(s\), 1 package\(s\), '
stderr '^machinery run: adapter: command-line-arguments\.TestBalance: defined in e2e/testdata/sets/ledger/ledger\.go, e2e/testdata/sets/orders/orders\.go: ambiguous: a pass or a skip counts for none of them, a fail fails each; rename one of the functions$'
stderr '^machinery run: adapter: receipts written: 1 pass, 0 fail, 0 skip$'

# an entry whose files match no Go file under trace.tests is refused, and the refusal says what
# was looked for
exec sh -c 'cat base.yaml nothing.part > machinery.yaml'
exec mrun 2 run --adapter go-test-json --streams -- sh sets.sh
stderr '^usage: --adapter go-test-json: evidence\.adapter\.sources: entry 1 \(package example\.test/shop/e2e/testdata/sets/\*\): files e2e/testdata/sets/\*/\*\.go\.txt match no Go file under trace\.tests \(a file whose name ends in \.go\): correct the globs, or list the files in trace\.tests$'
exec git checkout -q machinery.yaml

# in direct mode nothing changes: only _test.go files are read, and the staged sources, the notes
# file among them, are not
exec sh -c 'cat base.yaml staged.part > machinery.yaml'
gitcommit 'the staged map again'
rm .machinery/receipts
exec machinery run --adapter go-test-json -- go test ./e2e/suite
stderr '^machinery run: adapter: receipts written: 5 pass, 0 fail, 0 skip$'
stderr '^machinery run: adapter: in the whole project: 1 claimed id\(s\) not run, 0 claiming file\(s\) with no test function, 0 claim\(s\) above functions the adapter does not judge$'

# a second package tested in its own directory, with a function of the same name as one of the
# suite, and a file whose claim stands above no test function
mkdir e2e/more
cp more_test.go e2e/more/more_test.go
cp doc_test.go e2e/more/doc_test.go
exec sh -c 'cat base.yaml dir.part > machinery.yaml'
gitcommit 'a second package, and one entry for every package of e2e'

# dir: true: every package the pattern matches is built from the test files of its own
# directory, so one entry serves both, and TestEmailUnique is not ambiguous
rm .machinery/receipts
exec machinery run --adapter go-test-json --streams -- sh -c 'go test -json -count=1 ./e2e/... > "$MACHINERY_GO_TEST_JSON/e2e.json"'
stderr '^machinery run: adapter go-test-json: 1 stream\(s\), 2 package\(s\), 7 test function\(s\) with a verdict: 7 passed, 0 failed, 0 skipped$'
stderr '^machinery run: adapter: receipts written: 6 pass, 0 fail, 0 skip$'
! stderr 'ambiguous'
stderr '^machinery run: adapter: e2e/more/doc_test\.go: no test function; its claims count nothing$'
exec sh -c 'grep -h inv:customer-email-unique .machinery/receipts/*.jsonl'
stdout '"test":"e2e/more/more_test\.go::TestEmailUnique"'
stdout '"test":"e2e/suite/email_test\.go::TestEmailUnique"'

# a fail goes by name to the files of a dir: true entry too: e2e/more/more_test.go copied into
# stage/x, a package no entry matches, fails there, and e2e/more passes. Both files that define
# TestEmailUnique fail, and the name gets no pass
rm .machinery/receipts
env MORE_FAILS_IN=x
exec mrun 1 run --adapter go-test-json --streams -- sh more.sh
env MORE_FAILS_IN=
stderr '^machinery run: adapter: TestEmailUnique: failed in package\(s\) example\.test/shop/stage/x, so read as failed in e2e/more/more_test\.go, e2e/suite/email_test\.go: a fail goes by name to every file of evidence\.adapter\.sources that defines it; rename one of the functions if they are unrelated$'
stderr '^machinery run: adapter: receipts written: 0 pass, 2 fail, 0 skip$'
! stderr 'no file under trace\.tests belongs to'
! stderr 'defined in no candidate file'
exec sh -c 'grep -h inv:customer-email-unique .machinery/receipts/*.jsonl'
stdout '"outcome":"fail","test":"e2e/more/more_test\.go::TestEmailUnique","observed":"go test: TestEmailUnique failed"'
stdout '"outcome":"fail","test":"e2e/suite/email_test\.go::TestEmailUnique","observed":"go test: TestEmailUnique failed"'

# a pattern x/... matches the package x itself, as it does for go
exec sh -c 'cat base.yaml suite-dir.part > machinery.yaml'
gitcommit 'dir: true for e2e/suite/...'
rm .machinery/receipts
exec machinery run --adapter go-test-json --streams -- sh -c 'go test -json -count=1 ./e2e/suite > "$MACHINERY_GO_TEST_JSON/suite.json"'
stderr '^machinery run: adapter: receipts written: 5 pass, 0 fail, 0 skip$'

# an entry with a wildcard over several directories maps each package to the files of its own
# directory: it does not make every file a candidate of every package
exec sh -c 'cat base.yaml wide.part > machinery.yaml'
gitcommit 'one glob over every directory of e2e'
rm .machinery/receipts
exec machinery run --adapter go-test-json --streams -- sh -c 'go test -json -count=1 ./e2e/... > "$MACHINERY_GO_TEST_JSON/e2e.json"'
stderr '^machinery run: adapter: receipts written: 6 pass, 0 fail, 0 skip$'
! stderr 'ambiguous'

# the verifier's case: a staged test kept under testdata is copied into e2e/suite, where it fails,
# and into a directory of its own, where it passes. The mapping narrows e2e/suite to its own
# files and gives the second package every file, but a fail goes by name: the staged file's
# function failed, and its id fails
mkdir e2e/testdata/staged
cp extra_test.go e2e/testdata/staged/extra_test.go
gitcommit 'a staged test kept under testdata'
rm .machinery/receipts
env EXTRA_FAILS_IN=suite
exec mrun 1 run --adapter go-test-json --streams -- sh extra.sh e2e/suite e2e/run/extra
env EXTRA_FAILS_IN=
stderr '^machinery run: adapter go-test-json: 2 stream\(s\), 2 package\(s\), 8 test function\(s\) with a verdict: 7 passed, 1 failed, 0 skipped$'
stderr '^machinery run: adapter: TestExtra: failed in package\(s\) example\.test/shop/e2e/suite, so read as failed in e2e/testdata/staged/extra_test\.go: a fail goes by name to every file of evidence\.adapter\.sources that defines it; rename one of the functions if they are unrelated$'
stderr '^machinery run: adapter: receipts written: 0 pass, 1 fail, 0 skip$'
! stderr 'no file under trace\.tests belongs to'
! stderr 'defined in no candidate file'
exec sh -c 'grep -h "\"type\":\"receipt\"" .machinery/receipts/*.jsonl'
stdout -count=1 receipt
stdout '"id":"inv:terminal-is-final","outcome":"fail","test":"e2e/testdata/staged/extra_test\.go::TestExtra","observed":"go test: TestExtra failed"'
exec mrun 1 verify
stdout '^  ERROR  failed: inv:terminal-is-final \(e2e/testdata/staged/extra_test\.go::TestExtra\)$'

# a function that started and gave no verdict goes by name as a fail does: the copy staged into
# e2e/suite ends the test binary with os.Exit, and the copy in a directory of its own passes
rm .machinery/receipts
env EXTRA_EXITS_IN=suite
exec mrun 1 run --adapter go-test-json --streams -- sh extra.sh e2e/suite e2e/run/extra
env EXTRA_EXITS_IN=
stderr '^machinery run: adapter: package example\.test/shop/e2e/suite: 1 test function\(s\) started and gave no verdict, read as failed: TestExtra$'
stderr '^machinery run: adapter: TestExtra: failed in package\(s\) example\.test/shop/e2e/suite, so read as failed in e2e/testdata/staged/extra_test\.go: a fail goes by name to every file of evidence\.adapter\.sources that defines it; rename one of the functions if they are unrelated$'
stderr '^machinery run: adapter: receipts written: 0 pass, 1 fail, 0 skip$'
exec sh -c 'grep -h inv:terminal-is-final .machinery/receipts/*.jsonl'
stdout '"outcome":"fail","test":"e2e/testdata/staged/extra_test\.go::TestExtra","observed":"go test: TestExtra: started, no verdict; the package failed"'

# a fail needs no package: the copy in a directory of its own passes, and the same file built
# into a test binary and run under go tool test2json without -p fails, by t.Fatal and by
# os.Exit, in events that name no package. The fail goes by name, the name gets no pass, and
# verify fails the id
rm .machinery/receipts
env EXTRA_FAILS_IN=x
exec mrun 1 run --adapter go-test-json --streams -- sh nameless.sh
env EXTRA_FAILS_IN=
stderr '^machinery run: adapter: receipts written: 0 pass, 1 fail, 0 skip$'
stderr '^machinery run: adapter: TestExtra: failed in events that name no package, so read as failed in e2e/testdata/staged/extra_test\.go: a fail goes by name to every file of evidence\.adapter\.sources that defines it; rename one of the functions if they are unrelated$'
stderr '^machinery run: adapter: 1 verdict\(s\) name no package: a pass or a skip of them counts nothing, a fail goes by name; run the test binary under go tool test2json -p <import path>$'
exec sh -c 'grep -h inv:terminal-is-final .machinery/receipts/*.jsonl'
stdout '"outcome":"fail","test":"e2e/testdata/staged/extra_test\.go::TestExtra","observed":"go test: TestExtra failed"'
exec mrun 1 verify
stdout '^  ERROR  failed: inv:terminal-is-final \(e2e/testdata/staged/extra_test\.go::TestExtra\)$'
rm .machinery/receipts
env EXTRA_EXITS_IN=x
exec mrun 1 run --adapter go-test-json --streams -- sh nameless.sh
env EXTRA_EXITS_IN=
stderr '^machinery run: adapter: receipts written: 0 pass, 1 fail, 0 skip$'
stderr '^machinery run: adapter: TestExtra: failed in events that name no package, so read as failed in e2e/testdata/staged/extra_test\.go: a fail goes by name to every file of evidence\.adapter\.sources that defines it; rename one of the functions if they are unrelated$'
# a function those events started and gave no verdict, in a run of them that did not end with
# pass, fails by name too
rm .machinery/receipts
exec mrun 1 run --adapter go-test-json --streams -- sh nameless.sh cut
stderr '^machinery run: adapter: receipts written: 0 pass, 1 fail, 0 skip$'
stderr '^machinery run: adapter: TestExtra: failed in events that name no package, so read as failed in e2e/testdata/staged/extra_test\.go: a fail goes by name to every file of evidence\.adapter\.sources that defines it; rename one of the functions if they are unrelated$'
exec sh -c 'grep -h inv:terminal-is-final .machinery/receipts/*.jsonl'
stdout '"outcome":"fail","test":"e2e/testdata/staged/extra_test\.go::TestExtra","observed":"go test: TestExtra: started, no verdict; the package failed"'
# the events that name no package are one whole, never split into runs: a run of them cut after
# it started TestExtra, followed in the same file by a run of the same binary that passes it, is
# still a function with more run events than verdicts. It fails by name, and no pass of it counts
rm .machinery/receipts
exec mrun 1 run --adapter go-test-json --streams -- sh nameless.sh cutpass
stderr '^machinery run: adapter: receipts written: 0 pass, 1 fail, 0 skip$'
stderr '^machinery run: adapter: TestExtra: failed in events that name no package, so read as failed in e2e/testdata/staged/extra_test\.go: a fail goes by name to every file of evidence\.adapter\.sources that defines it; rename one of the functions if they are unrelated$'
stderr '^machinery run: adapter: 1 verdict\(s\) name no package: a pass or a skip of them counts nothing, a fail goes by name; run the test binary under go tool test2json -p <import path>$'
exec sh -c 'grep -h inv:terminal-is-final .machinery/receipts/*.jsonl'
stdout -count=1 receipt
stdout '"outcome":"fail","test":"e2e/testdata/staged/extra_test\.go::TestExtra","observed":"go test: TestExtra: started, no verdict; the package failed"'
exec mrun 1 verify
stdout '^  ERROR  failed: inv:terminal-is-final \(e2e/testdata/staged/extra_test\.go::TestExtra\)$'
# and two whole runs of it in one file, each with its verdict, fail nothing: the counts add up
rm .machinery/receipts
exec machinery run --adapter go-test-json --streams -- sh nameless.sh twice
stderr '^machinery run: adapter: receipts written: 1 pass, 0 fail, 0 skip$'
stderr '^machinery run: adapter: 2 verdict\(s\) name no package: a pass or a skip of them counts nothing, a fail goes by name; run the test binary under go tool test2json -p <import path>$'
! stderr 'failed in events that name no package'
# with a package of the run in which the name failed as well, the line names both
rm .machinery/receipts
exec mrun 1 run --adapter go-test-json --streams -- sh nameless.sh both
stderr '^machinery run: adapter: TestExtra: failed in package\(s\) example\.test/shop/stage/y and in events that name no package, so read as failed in e2e/testdata/staged/extra_test\.go: a fail goes by name to every file of evidence\.adapter\.sources that defines it; rename one of the functions if they are unrelated$'

# an entry whose package has no wildcard names one package and maps every file to it: the
# staged copy's pass in e2e/suite goes to the file under testdata
exec sh -c 'cat base.yaml exact.part > machinery.yaml'
gitcommit 'one package, every file'
rm .machinery/receipts
exec machinery run --adapter go-test-json --streams -- sh extra.sh e2e/suite
stderr '^machinery run: adapter: receipts written: 6 pass, 0 fail, 0 skip$'
exec sh -c 'grep -h inv:terminal-is-final .machinery/receipts/*.jsonl'
stdout '"outcome":"pass","test":"e2e/testdata/staged/extra_test\.go::TestExtra","observed":"go test: TestExtra passed"'
stdout '"outcome":"pass","test":"e2e/suite/order_test\.go::TestCancelIsFinal"'
rm e2e/testdata/staged

# the run summary is scoped to the packages of the run: a run of e2e/suite alone does not count
# the claims of e2e/more nor name its file without a test function, and the project-wide line
# counts them once
exec sh -c 'cat base.yaml > machinery.yaml'
gitcommit 'no map'
rm .machinery/receipts
exec machinery run --adapter go-test-json -- go test ./e2e/more
stderr '^machinery run: adapter: receipts written: 1 pass, 0 fail, 0 skip$'
stderr '^machinery run: adapter: claimed, not run: 0 id\(s\)$'
stderr '^machinery run: adapter: in the whole project: 5 claimed id\(s\) not run, 1 claiming file\(s\) with no test function, 0 claim\(s\) above functions the adapter does not judge$'
stderr '^machinery run: adapter: e2e/more/doc_test\.go: no test function; its claims count nothing$'
rm .machinery/receipts
exec machinery run --adapter go-test-json -- go test ./e2e/suite
stderr '^machinery run: adapter: claimed, not run: 1 id\(s\)$'
stderr '^machinery run: adapter: in the whole project: 1 claimed id\(s\) not run, 1 claiming file\(s\) with no test function, 0 claim\(s\) above functions the adapter does not judge$'
! stderr 'doc_test\.go'

# refusals of dir: true: without --streams an entry that matches a package tested in its own
# directory, and with --streams a pattern that matches no such package
exec sh -c 'cat base.yaml dir.part > machinery.yaml'
exec mrun 2 run --adapter go-test-json -- go test ./e2e/suite
stderr '^usage: --adapter go-test-json: evidence\.adapter\.sources: entry 1 \(package example\.test/shop/e2e/\.\.\., dir: true\) matches example\.test/shop/e2e/more, the package of e2e/more: entries are read only with --streams; remove the entry, or run the suite through --streams$'
exec sh -c 'cat base.yaml dir-nothing.part > machinery.yaml'
exec mrun 2 run --adapter go-test-json --streams -- sh sets.sh
stderr '^usage: --adapter go-test-json: evidence\.adapter\.sources: entry 1 \(package example\.test/shop/nothing/\.\.\., dir: true\): the pattern matches the import path of no directory that holds a _test\.go file under trace\.tests: correct the pattern, or list the files in trace\.tests$'
! exists .machinery/receipts/nothing

# config errors of the two forms
exec sh -c 'cat base.yaml both.part > machinery.yaml'
exec mrun 2 config
stderr '^config: evidence\.adapter\.sources: entry 1: files and dir: true do not combine; write one entry for each$'
exec sh -c 'cat base.yaml pattern.part > machinery.yaml'
exec mrun 2 config
stderr '^config: evidence\.adapter\.sources: entry 1: package "example\.test/shop/e2e/\*" with dir: true is an import path pattern: \.\.\. is its only wildcard$'
exec sh -c 'cat base.yaml neither.part > machinery.yaml'
exec mrun 2 config
stderr '^config: evidence\.adapter\.sources: entry 1: files is required, or dir: true$'
exec git checkout -q machinery.yaml

-- sets.sh --
#!/bin/sh
# stages each set of sources kept under e2e/testdata/sets as test files, builds its test binary
# and runs it under go tool test2json, named by the import path of the directory the sources are
# kept in. A set that does not build gets a stream that says its package failed
set -u
status=0
n=0
for dir in e2e/testdata/sets/*/; do
  set=$(basename "$dir")
  n=$((n + 1))
  name="example.test/shop/e2e/testdata/sets/$set"
  out="$MACHINERY_GO_TEST_JSON/$set.json"
  rm -rf "stage/$set"
  mkdir -p "stage/$set"
  for f in "$dir"*.go; do cp "$f" "stage/$set/$(basename "$f" .go)_test.go"; done
  if go test -c -o "stage/$set.test" "./stage/$set" > /dev/null 2>&1; then
    go tool test2json -t -p "$name" "stage/$set.test" -test.v=test2json > "$out" || status=1
  else
    printf '{"Action":"start","Package":"%s"}\n{"Action":"fail","Package":"%s"}\n' "$name" "$name" > "$out"
    status=1
  fi
done
rm -rf stage
echo "sets: $n set(s), exit $status"
exit $status
-- extra.sh --
#!/bin/sh
# copies the staged test e2e/testdata/staged/extra_test.go into each directory named, runs go test
# there with a stream of its own, and removes the copy, and the directory when it made it
set -u
status=0
n=0
for dir in "$@"; do
  n=$((n + 1))
  made=
  [ -d "$dir" ] || { mkdir -p "$dir"; made=1; }
  cp e2e/testdata/staged/extra_test.go "$dir/extra_test.go"
  go test -json -count=1 "./$dir" > "$MACHINERY_GO_TEST_JSON/$n.json" || status=1
  rm "$dir/extra_test.go"
  [ -z "$made" ] || rm -r "$dir"
done
exit $status
-- extra_test.go --
package suite

import (
	"os"
	"path/filepath"
	"testing"
)

// TestExtra is kept under testdata and copied into a package before go test runs. It fails in
// the directory EXTRA_FAILS_IN names, and ends the test binary in the one EXTRA_EXITS_IN names.
//
// machinery:verifies inv:terminal-is-final
func TestExtra(t *testing.T) {
	wd, _ := os.Getwd()
	switch filepath.Base(wd) {
	case os.Getenv("EXTRA_FAILS_IN"):
		t.Fatal("a cancelled order changed status")
	case os.Getenv("EXTRA_EXITS_IN"):
		os.Exit(1)
	}
}
-- nameless.sh --
#!/bin/sh
# copies the staged test into e2e/run/extra and runs go test there, then builds the same file
# into a test binary in stage/x and runs it under go tool test2json without -p, so that its
# events name no package. With "cut" the second stream holds the events of such a binary that
# started TestExtra and stopped there, typed as the wrapper saw them; with "cutpass" a whole run
# of the binary follows them in the same file, and with "twice" the file holds two whole runs;
# with "both" a run of a copy in stage/y comes first, whose package failed after it started
# TestExtra
set -u
status=0
mkdir -p e2e/run/extra stage/x
cp e2e/testdata/staged/extra_test.go e2e/run/extra/extra_test.go
go test -json -count=1 ./e2e/run/extra > "$MACHINERY_GO_TEST_JSON/1.json" || status=1
rm -r e2e/run
cut='{"Action":"start"}
{"Action":"run","Test":"TestExtra"}'
y='{"Action":"start","Package":"example.test/shop/stage/y"}
{"Action":"run","Package":"example.test/shop/stage/y","Test":"TestExtra"}
{"Action":"fail","Package":"example.test/shop/stage/y"}'
case "${1:-}" in
cut)
  printf '%s\n' "$cut" > "$MACHINERY_GO_TEST_JSON/2.json"
  status=1
  ;;
both)
  printf '%s\n%s\n' "$y" "$cut" > "$MACHINERY_GO_TEST_JSON/2.json"
  status=1
  ;;
cutpass|twice)
  cp e2e/testdata/staged/extra_test.go stage/x/extra_test.go
  go test -c -o stage/x.test ./stage/x > /dev/null 2>&1 || status=1
  if [ "$1" = cutpass ]; then
    printf '%s\n' "$cut" > "$MACHINERY_GO_TEST_JSON/2.json"
    status=1
  else
    (cd stage/x && go tool test2json -t ../x.test -test.v=test2json) > "$MACHINERY_GO_TEST_JSON/2.json" || status=1
  fi
  (cd stage/x && go tool test2json -t ../x.test -test.v=test2json) >> "$MACHINERY_GO_TEST_JSON/2.json" || status=1
  ;;
*)
  cp e2e/testdata/staged/extra_test.go stage/x/extra_test.go
  go test -c -o stage/x.test ./stage/x > /dev/null 2>&1 || status=1
  (cd stage/x && go tool test2json -t ../x.test -test.v=test2json) > "$MACHINERY_GO_TEST_JSON/2.json" || status=1
  ;;
esac
rm -rf stage
exit $status
-- more.sh --
#!/bin/sh
# runs e2e/more, then a copy of its test in stage/x, a package no entry matches
set -u
status=0
go test -json -count=1 ./e2e/more > "$MACHINERY_GO_TEST_JSON/more.json" || status=1
mkdir -p stage/x
cp e2e/more/more_test.go stage/x/more_test.go
go test -json -count=1 ./stage/x > "$MACHINERY_GO_TEST_JSON/x.json" || status=1
rm -rf stage
exit $status
-- loose.sh --
#!/bin/sh
# the same sets, each tested by go test on its loose files
set -u
status=0
for dir in e2e/testdata/sets/*/; do
  set=$(basename "$dir")
  rm -rf "stage/$set"
  mkdir -p "stage/$set"
  for f in "$dir"*.go; do cp "$f" "stage/$set/$(basename "$f" .go)_test.go"; done
  go test -json -count=1 stage/$set/*_test.go > "$MACHINERY_GO_TEST_JSON/$set.json" || status=1
done
rm -rf stage
exit $status
-- relabeled.sh --
set -eu
raw="$MACHINERY_GO_TEST_JSON/raw"
mkdir "$raw"
MACHINERY_GO_TEST_JSON="$raw" sh loose.sh
for stream in "$raw"/*.json; do
  file=$(basename "$stream")
  name="example.test/shop/e2e/testdata/sets/${file%.json}"
  sed "s|\"Package\":\"command-line-arguments\"|\"Package\":\"$name\"|" "$stream" > "$MACHINERY_GO_TEST_JSON/$file"
done
-- latest-receipts.sh --
set -eu
for file in .machinery/receipts/*.jsonl; do last=$file; done
grep '"type":"receipt"' "$last"
