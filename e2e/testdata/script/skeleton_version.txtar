# version prints the version and needs no project
exec machinery version
stdout '^machinery dev \([0-9a-f]{40}(-dirty)?, unknown\)$'

# no arguments prints help and exits 0
exec machinery
stdout 'Usage: machinery'
stdout 'docs/formats.md'

# an unknown command is a usage error
exec mrun 2 nosuch
stderr 'unknown command'
exec mrun 2 lint --nosuchflag
