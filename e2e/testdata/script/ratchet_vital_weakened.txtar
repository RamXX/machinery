        statement: "The payment provider charges a payment at most once, however often it is asked."
        evidence: ["fm:payment-provider-down", "fm:pay-for-another-customer"]
      - name: final-stays-final
        statement: "The store never rewrites the status of a shipped or cancelled order."
        evidence: ["inv:terminal-is-final"]
  - name: order-ownership
    tier: critical
