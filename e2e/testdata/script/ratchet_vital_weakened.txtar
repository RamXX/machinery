-- risk-bad-lowered.yaml --
version: 1
areas:
  - name: order-payment
    tier: vital
    why: "money moves; a customer charged twice cannot be made whole by a retry"
    ids: ["act:Order.pay", "tc:ORDE-2e883d", "tc:ORDE-8bd6e7", "tc:ORDE-267d12", "tc:ORDE-ad945c", "tc:ORDE-e6d28f", "inv:paid-before-shipped", "fm:payment-provider-down", "fm:pay-for-another-customer"]
    questions: [concurrency]
    property:
      - name: charged-once
        statement: "An order is charged at most once, whatever its callers do at the same time."
        kind: exactly-once
        over: ["act:Order.pay", "tc:ORDE-8bd6e7"]
      - name: shipped-only-paid
        statement: "No order ships before its payment is captured."
        kind: never
        over: ["inv:paid-before-shipped", "tc:ORDE-e6d28f"]
    core:
      paths: ["internal/domain/*.go", "internal/domain/**"]
      entry: ["internal/domain/order.go#Apply", "internal/domain/order.go#Transition"]
    assumes:
