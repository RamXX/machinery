    ids: ["act:Order.place"]
    questions: [structure]
  - name: shipping-permission
    tier: consequential
    why: "authorization: only a Clerk ships"
    ids: ["act:Order.ship"]
lowered:
  - {area: order-payment, what: "area removed", ids: ["act:Order.pay"], from: vital, reason: "both forms"}
  - {area: Order, what: "area removed", reason: "not a name"}
  - {area: order-payment, reason: "no what"}
  - {area: order-payment, what: "area removed"}
