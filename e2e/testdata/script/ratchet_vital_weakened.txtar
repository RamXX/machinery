  - {area: order-payment, what: "property charged-once: statement changed", reason: "shorter wording"}
  - {area: order-payment, what: "property charged-once: kind exactly-once -> invariant", reason: "restated as an invariant"}
  - {area: order-payment, what: "property charged-once: over tc:ORDE-8bd6e7 removed", reason: "the retry path moved to the provider"}
  - {area: order-payment, what: "assumption final-stays-final removed", reason: "the store is append-only now"}
  - {area: order-payment, what: "assumption provider-charges-once: evidence fm:pay-for-another-customer removed", reason: "not evidence of this"}
  - {area: order-payment, what: "core entry internal/domain/order.go#Transition removed", reason: "merged into Apply"}
-- risk-strong.yaml --
version: 1
areas:
  - name: order-payment
    tier: vital
    why: "money moves; a customer charged twice cannot be made whole by a retry"
    ids: ["act:Order.pay", "tc:ORDE-2e883d", "tc:ORDE-8bd6e7", "tc:ORDE-267d12", "tc:ORDE-ad945c", "tc:ORDE-e6d28f", "inv:paid-before-shipped", "fm:payment-provider-down", "fm:pay-for-another-customer"]
    questions: [concurrency]
    property:
      - name: charged-once
        statement: "An order is charged at most once, whatever its callers do at the same time."
        kind: exactly-once
        over: ["act:Order.pay", "tc:ORDE-8bd6e7", "tc:ORDE-267d12"]
      - name: shipped-only-paid
        statement: "No order ships before its payment is captured."
        kind: never
        over: ["inv:paid-before-shipped", "tc:ORDE-e6d28f"]
      - name: refunded-once
        statement: "A paid order is refunded at most once."
        kind: exactly-once
        over: ["tc:ORDE-ad945c"]
    core:
      paths: ["internal/domain/*.go", "internal/domain/**", "internal/api/**"]
      entry: ["internal/domain/order.go#Apply", "internal/domain/order.go#Transition", "internal/domain/order.go#New"]
    assumes:
      - name: provider-charges-once
        statement: "The payment provider charges a payment at most once, however often it is asked."
        evidence: ["fm:payment-provider-down", "fm:pay-for-another-customer", "inv:terminal-is-final"]
      - name: final-stays-final
        statement: "The store never rewrites the status of a shipped or cancelled order."
        evidence: ["inv:terminal-is-final"]
  - name: order-ownership
    tier: critical
    why: "an order belongs to exactly one customer, whatever the data looks like"
    ids: ["act:Order.place"]
    questions: [structure]
  - name: shipping-permission
    tier: consequential
    why: "authorization: only a Clerk ships"
    ids: ["act:Order.ship"]
