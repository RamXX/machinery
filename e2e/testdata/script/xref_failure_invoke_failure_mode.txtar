# rule invoke-failure-mode: every invoke src of every machine is the subject of a failure mode
exec machinery lint --stage xref-failure
stdout 'checked: 2 failure modes, 1 invokes, 1 dependencies, 0 tiered actions'
stdout '^passed$'

cp db-only.yaml design/failure-modes.yaml
exec mrun 1 lint --stage xref-failure
stdout 'ERROR  invoke-failure-mode: invoke:order.chargePayment: no failure mode names this invoke; declare what happens when it fails in design/failure-modes.yaml'
stdout 'failed: 1 finding\(s\)'

# a failure mode on another machine's invoke does not count, and operational machines are included
cp ops.json design/machines/Ops.machine.json
cp both.yaml design/failure-modes.yaml
exec mrun 1 lint --stage xref-failure
stdout 'ERROR  invoke-failure-mode: invoke:ops.syncStock: no failure mode names this invoke'
stdout 'checked: 3 failure modes, 2 invokes, 1 dependencies, 0 tiered actions'
! stdout 'invoke:order.chargePayment'

-- machinery.yaml --
version: 2
design:
  models:
    - design/model/mini.modelith.yaml
  machines: design/machines
  failure_modes: design/failure-modes.yaml
dependencies:
  - {name: postgres, posture: real}
-- design/model/mini.modelith.yaml --
kind: DomainModel
version: v1
title: Mini
enums:
  Status:
    values:
      - {name: Pending, definition: "Placed."}
      - {name: Paid, definition: "Paid."}
      - {name: Cancelled, definition: "Dropped."}
entities:
  Order:
    definition: "An order."
    attributes:
      - {name: status, type: Status}
    actions:
      - {name: pay, actor: Customer}
      - {name: cancel, actor: Customer}
-- design/machines/Order.machine.json --
{
  "id": "order",
  "initial": "Pending",
  "states": {
    "Pending": { "on": { "pay": { "target": "paying" }, "cancel": { "target": "Cancelled" } } },
    "paying": {
      "invoke": {
        "src": "chargePayment",
        "onDone": { "target": "Paid" },
        "onError": { "target": "Pending" }
      }
    },
    "Paid": { "type": "final" },
    "Cancelled": { "type": "final" }
  }
}
-- design/failure-modes.yaml --
version: 1
failure_modes:
  - id: payment-down
    subject: invoke:order.chargePayment
    failure: "It fails."
    required: surface
    behavior: "The caller is told."
  - id: database-down
    subject: dependency:postgres
    failure: "It fails."
    required: fail-closed
    behavior: "The caller is told."
-- db-only.yaml --
version: 1
failure_modes:
  - id: database-down
    subject: dependency:postgres
    failure: "It fails."
    required: fail-closed
    behavior: "The caller is told."
-- ops.json --
{
  "id": "ops",
  "_role": "operational",
  "initial": "idle",
  "states": {
    "idle": { "on": { "sync": { "target": "syncing" } } },
    "syncing": { "invoke": { "src": "syncStock", "onDone": { "target": "idle" }, "onError": { "target": "idle" } } }
  }
}
-- both.yaml --
version: 1
failure_modes:
  - id: payment-down
    subject: invoke:order.chargePayment
    failure: "It fails."
    required: surface
    behavior: "The caller is told."
  - id: database-down
    subject: dependency:postgres
    failure: "It fails."
    required: fail-closed
    behavior: "The caller is told."
  - id: stock-sync-down
    subject: invoke:order.syncStock
    failure: "It fails."
    required: surface
    behavior: "The caller is told."
