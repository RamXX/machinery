# intake refusals: usage, an uncommitted design, missing steps named, a frozen wave, the story gate (section 15.7)
fixture shop

# the backlog bridge is required
exec mrun 2 intake new 'Refund a paid order' --intent 'x'
stderr '^config: no backlog configured: set backlog.tool: bd in machinery.yaml$'

exec sh -c 'printf "backlog:\n  tool: bd\nreview:\n  backlog: off\n  design: off\n" >> machinery.yaml'
exec machinery gen
gitinit
exec bd init --stealth --non-interactive -p shop

# usage errors
exec mrun 2 intake
stderr '^usage: machinery intake needs a subcommand: intake new, intake plan, intake status$'
exec mrun 2 intake new --intent 'x'
stderr '^usage: machinery intake new takes one title$'
exec mrun 2 intake new '  ' --intent 'x'
stderr '^usage: machinery intake new takes one title$'
exec mrun 2 intake new 'Refund a paid order'
stderr '^usage: machinery intake new needs --intent$'
exec mrun 2 intake status
stderr '^usage: machinery intake status takes one intake id$'
exec mrun 2 intake plan
stderr '^usage: machinery intake plan takes one intake id$'
exec mrun 2 intake status shop-nope
stderr '^usage: no story shop-nope in the backlog: bd show: '
exec bd create --id shop-s1 --title 'A plain story' --body-file s1.txt --silent
exec mrun 2 intake status shop-s1
stderr '^usage: shop-s1 is not an intake item: it has no machinery:intake line$'
exec mrun 2 intake plan shop-s1 --apply
stderr '^usage: shop-s1 is not an intake item: it has no machinery:intake line$'

# a requirement starts from a committed design; without a commit there is no base
exec sh -c 'printf "# edited\n" >> design/failure-modes.yaml'
exec mrun 1 intake new 'Refund a paid order' --intent 'x'
stderr '^machinery: uncommitted design change: design/failure-modes.yaml; a requirement starts from a committed design$'
exec git checkout -q -- design/failure-modes.yaml
exec git checkout -q --orphan unborn
exec mrun 1 intake new 'Refund a paid order' --intent 'x'
stderr '^machinery: cannot read the current commit: '
exec git checkout -q main
exec sh -c 'bd list --all --json --limit 0 | grep -c "^    \"title\":"'
stdout '^1$'

# a parent the backlog does not know is refused by bd
exec mrun 1 intake new 'Refund a paid order' --intent 'x' --parent shop-nope
stderr '^machinery: bd create: '

exec machinery intake new 'Refund a paid order' --intent 'A Clerk refunds a paid order' --refuses 'a refund of an unpaid order' --refuses 'a second refund'
exec sh -c '. ./lib.sh; bd show $(iid) --json'
stdout 'Refuses:\\n- a refund of an unpaid order\\n- a second refund\\n'

# the story gate refuses an intake item: it is planned, not built
exec sh -c '. ./lib.sh; mrun 1 story $(iid)'
stdout '^  ERROR  shop-[a-z0-9]+ is an intake item: an intake item is planned, not built; run machinery intake status shop-[a-z0-9]+$'
stdout '^failed: 1 finding\(s\)$'

# a risk file that fails: design sound and tiers are missing, each named
cp refund/shop.modelith.yaml design/model/shop.modelith.yaml
cp refund/Order.machine.json design/machines/Order.machine.json
cp refund/openapi.yaml contracts/openapi.yaml
cp risk-bad.yaml design/risk.yaml
cp machinery-risk.yaml machinery.yaml
exec machinery gen
gitcommit 'design: refund, with a risk file that names nothing'
exec sh -c '. ./lib.sh; mrun 1 intake plan $(iid)'
stderr '^machinery: cannot plan intake shop-[a-z0-9]+: design sound is missing: machinery lint: risk: failed: 1 finding\(s\)$'
stderr '^machinery: cannot plan intake shop-[a-z0-9]+: tiers is missing: stage risk: failed: 1 finding\(s\); run machinery lint --stage risk$'
! stderr 'design changed is missing'
! stderr 'formal is missing'
! stdout .

# a critical area over a new id needs its formal model before the stories
cp risk-critical.yaml design/risk.yaml
exec machinery gen
gitcommit 'risk: refunds are critical'
exec sh -c '. ./lib.sh; mrun 1 intake status $(iid)'
stdout '^  tiers           done     stage risk passed$'
stdout '^    fv:refunds  critical \(refunds\)$'
stdout '^    tc:ORDE-10c92a  critical \(refunds\)$'
stdout '^    routine by default: act:Order.refund$'
stdout '^  formal          missing  fv:refunds: no tla spec answers recovery; scaffold it with machinery formal new$'
exec sh -c '. ./lib.sh; mrun 1 intake plan $(iid)'
stderr '^machinery: cannot plan intake shop-[a-z0-9]+: formal is missing: fv:refunds: no tla spec answers recovery; scaffold it with machinery formal new$'
exec machinery formal new refunds --tool tla --machine Order --area refunds
gitcommit 'formal: scaffold the refunds model'
exec sh -c '. ./lib.sh; mrun 1 intake status $(iid)'
stdout '^  formal          done     modeled: refunds$'
exec sh -c '. ./lib.sh; machinery intake plan $(iid)'
stdout '^## Model refunds \(tla\)$'
stdout '^## Prove order refund$'
stdout '^- Model refunds \(tla\): the formal model the tier requires$'
stdout '^## Demonstrate: Refund a paid order$'
stdout '^machinery, tier:critical$'

# while a wave is frozen no intake is planned: a contract change lands alone
exec bd create --id shop-w1 --title 'Prove the terminal invariant' --body-file w1.txt --silent
exec bd close shop-s1 --reason done
exec machinery waves --freeze
stdout '^wave: frozen [0-9a-f]{12} at [0-9a-f]{7}, 1 stories$'
exec sh -c '. ./lib.sh; mrun 1 intake plan $(iid)'
stderr '^machinery: a wave is frozen: land or thaw it; a contract change lands alone$'
! stdout .
exec sh -c '. ./lib.sh; mrun 1 intake plan $(iid) --apply'
stderr '^machinery: a wave is frozen: land or thaw it; a contract change lands alone$'
exec sh -c 'bd list --all --json --limit 0 | grep -c "^    \"title\":"'
stdout '^3$'
exec machinery waves --thaw
exec sh -c '. ./lib.sh; machinery intake plan $(iid) --apply'
stdout '^plan: 4 created, 0 existing, 4 edge\(s\)$'

-- machinery-risk.yaml --
version: 2
design:
  models:
    - design/model/shop.modelith.yaml
  machines: design/machines
  failure_modes: design/failure-modes.yaml
  risk: design/risk.yaml
contracts:
  - kind: openapi
    path: contracts/openapi.yaml
trace:
  code: ["internal/**/*.go"]
  tests: ["e2e/**"]
constraints:
  layers:
    - {name: domain, paths: ["internal/domain/**"]}
    - {name: api, paths: ["internal/api/**"]}
  size:
    max_file_lines: 200
    max_func_lines: 40
waivers:
  - {rule: action-event, id: "act:Order.place", reason: "creation enters the initial state Pending"}
backlog:
  tool: bd
review:
  backlog: off
  design: off
-- s1.txt --
machinery:ids inv:terminal-is-final
-- w1.txt --
machinery:ids inv:terminal-is-final
machinery:scope e2e/terminal.sh
-- risk-bad.yaml --
version: 1
areas:
  - name: refunds
    tier: consequential
    why: "money goes back"
    ids: ["tc:ORDE-ffffff"]
-- risk-critical.yaml --
version: 1
areas:
  - name: refunds
    tier: critical
    why: "money goes back; a double refund cannot be undone"
    ids: ["tc:ORDE-10c92a"]
    questions: [recovery]
-- lib.sh --
# sid <title>: the id of the item with that title
sid() {
  bd list --all --json --limit 0 | grep -B1 "^    \"title\": \"$1\"" | sed -n 's/^    "id": "\([^"]*\)".*/\1/p'
}
# iid: the id of the intake item of this script
iid() {
  sid 'Refund a paid order'
}
-- refund/shop.modelith.yaml --
kind: DomainModel
version: v1
title: Shop
description: >
  A minimal order desk used as the shared test fixture. A Customer places an
  Order, pays for it, and a Clerk ships it. An Order can be cancelled until it
  ships.

glossary:
  Clerk: "A staff member who ships a paid `Order`."

enums:
  OrderStatus:
    values:
      - {name: Pending, definition: "Placed, not yet paid."}
      - {name: Paid, definition: "Payment captured."}
      - {name: Shipped, definition: "Handed to the carrier; terminal."}
      - {name: Cancelled, definition: "Abandoned before shipping; terminal."}

entities:
  Customer:
    definition: >
      A person who places and pays for an `Order`.
    attributes:
      - {name: email, type: string}
    relationships:
      - {entity: Order, cardinality: "1:n", ownership: owned}
    invariants:
      - {id: customer-email-unique, statement: "No two `Customer` records share an email."}
  Order:
    definition: >
      A request by one `Customer` to buy goods. Its status follows the order
      lifecycle from pending to shipped or cancelled.
    attributes:
      - {name: status, type: OrderStatus}
      - {name: totalCents, type: integer}
    relationships:
      - {entity: Customer, cardinality: "n:1", ownership: referenced}
    actions:
      - {name: place, actor: Customer, description: "Create the `Order` in the pending status."}
      - {name: pay, actor: Customer, preserves: [paid-before-shipped]}
      - {name: ship, actor: Clerk, preserves: [paid-before-shipped]}
      - {name: cancel, actor: Customer, preserves: [terminal-is-final]}
      - {name: refund, actor: Clerk, description: "Return the payment of a paid `Order` and cancel it."}
    invariants:
      - {id: paid-before-shipped, statement: "An `Order` reaches the shipped status only from the paid status."}

invariants:
  - {id: terminal-is-final, statement: "A shipped or cancelled `Order` never changes status again."}

scenarios:
  - name: Customer pays and the order ships
    actors: [Customer, Clerk]
    steps:
      - "Customer places an `Order`; it is pending."
      - "Customer pays; the `Order` becomes paid."
      - "Clerk ships; the `Order` becomes shipped."
    invariants_touched: [paid-before-shipped]
  - name: Cancelled order refuses payment
    actors: [Customer]
    steps:
      - "Customer places an `Order` and cancels it."
      - "Customer tries to pay; the request is refused and the `Order` stays cancelled."
    invariants_touched: [terminal-is-final]
-- refund/Order.machine.json --
{
  "_comment": "Order lifecycle. Domain states mirror the OrderStatus enum; `paying` is the transient overlay around the payment call.",
  "_delays": {
    "payTimeout": "5000 ms - upper bound on the payment provider call"
  },
  "id": "order",
  "initial": "Pending",
  "context": { "orderId": null, "lastError": null },
  "states": {
    "Pending": {
      "on": {
        "pay": [
          { "target": "paying", "guard": "hasPaymentMethod", "actions": "stampAttempt" },
          { "actions": "recordPayRefused" }
        ],
        "cancel": { "target": "Cancelled", "actions": "recordCancellation" }
      },
      "_ignores": {
        "ship": "an unpaid order cannot ship; the API refuses with ORDER_NOT_PAID",
        "refund": "an unpaid order has nothing to refund; the API refuses with ORDER_NOT_PAID"
      }
    },
    "paying": {
      "invoke": {
        "src": "chargePayment",
        "onDone": { "target": "Paid", "actions": "recordCharge" },
        "onError": { "target": "Pending", "actions": "recordPaymentFailure" }
      },
      "after": {
        "payTimeout": { "target": "Pending", "actions": "recordPaymentTimeout" }
      }
    },
    "Paid": {
      "on": {
        "ship": { "target": "Shipped", "actions": "recordShipment" },
        "cancel": { "target": "Cancelled", "actions": ["refundPayment", "recordCancellation"] },
        "refund": { "target": "Cancelled", "actions": ["refundPayment", "recordRefund"] }
      },
      "_ignores": { "pay": "already paid; a repeated pay is refused with ORDER_ALREADY_PAID" }
    },
    "Shipped": { "type": "final", "entry": "notifyCustomer" },
    "Cancelled": { "type": "final" }
  }
}
-- refund/openapi.yaml --
openapi: 3.1.0
info:
  title: Shop API
  version: 0.1.0
paths:
  /orders:
    post:
      operationId: placeOrder
      x-machinery-action: Order.place
      responses:
        "201": {description: Created}
  /orders/{id}:
    get:
      operationId: getOrder
      responses:
        "200": {description: The order}
  /orders/{id}/pay:
    post:
      operationId: payOrder
      x-machinery-action: Order.pay
      responses:
        "200": {description: Paid or refused with a code}
  /orders/{id}/ship:
    post:
      operationId: shipOrder
      x-machinery-action: Order.ship
      responses:
        "200": {description: Shipped or refused with a code}
  /orders/{id}/cancel:
    post:
      operationId: cancelOrder
      x-machinery-action: Order.cancel
      responses:
        "200": {description: Cancelled or refused with a code}
  /orders/{id}/refund:
    post:
      operationId: refundOrder
      x-machinery-action: Order.refund
      responses:
        "200": {description: Refunded or refused with a code}
