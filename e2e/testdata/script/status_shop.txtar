# status prints a summary; it is a report, never a gate (section 14)
fixture shop
exec machinery gen
gitinit

# without evidence
exec machinery status
stdout '^obligations: 16 \(tc 10, sc 2, inv 3, fm 1\)$'
! stdout '^tiers:'
stdout '^proven: 0  partial: 0  failed: 0  owed: 2  unproven and not owed: 14$'
stdout '^owed without a story: 2$'
stdout '^evidence: none at [0-9a-f]{7}$'
exec sh -c 'test "$(machinery status | head -n 1)" = "project: $(basename "$(pwd -P)")" && echo name-ok'
stdout name-ok
exec sh -c 'machinery status | head -n 5 | tail -n 4'
cmp stdout want-none-shape.txt

# with evidence
exec machinery run -- sh e2e/orders.sh
exec machinery status
stdout '^proven: 14  partial: 1  failed: 0  owed: 2  unproven and not owed: 0$'
stdout '^evidence: [0-9a-f]{7} clean, 1 run\(s\), 15 receipt\(s\)$'
exec sh -c 'machinery status | grep "^evidence: $(git rev-parse --short=7 HEAD) clean"'

# a dirty tree is reported, and status still exits 0
exec sh -c 'echo "// wip" >> internal/api/handlers.go'
exec machinery status
stdout '^evidence: [0-9a-f]{7} dirty, 1 run\(s\), 15 receipt\(s\)$'
exec git checkout -- internal/api/handlers.go

# with a risk file: the tiers line, and the fv kind
cp machinery-risk.yaml machinery.yaml
cp risk.yaml design/risk.yaml
cp owed-story.yaml design/owed.yaml
exec machinery gen
gitcommit 'add risk tiers'
exec machinery status
stdout '^obligations: 17 \(tc 10, sc 2, inv 3, fm 1, fv 1\)$'
stdout '^tiers: routine 13, consequential 2, critical 2$'
stdout '^owed without a story: 1$'
stdout '^evidence: none at [0-9a-f]{7}$'

# only a config error changes the exit code
cp bad.yaml machinery.yaml
exec mrun 2 status
stderr '^config: '

-- want-none-shape.txt --
obligations: 16 (tc 10, sc 2, inv 3, fm 1)
ids: 0 proposed, 2 owed, 18 proven, 0 retired
proven: 0  partial: 0  failed: 0  owed: 2  unproven and not owed: 14
owed without a story: 2
-- owed-story.yaml --
version: 1
owed:
  - id: fm:payment-provider-down
    reason: "no test induces a provider outage yet"
    story: bd-7
  - id: tc:ORDE-8bd6e7
    reason: "effect recordCharge is a noop in the skeleton"
-- bad.yaml --
version: 3
-- machinery-risk.yaml --
version: 2
design:
  models:
    - design/model/shop.modelith.yaml
  machines: design/machines
  failure_modes: design/failure-modes.yaml
  risk: design/risk.yaml
contracts:
  - kind: openapi
    path: contracts/openapi.yaml
trace:
  code: ["internal/**/*.go"]
  tests: ["e2e/**"]
constraints:
  layers:
    - {name: domain, paths: ["internal/domain/**"]}
    - {name: api, paths: ["internal/api/**"]}
  size:
    max_file_lines: 200
    max_func_lines: 40
waivers:
  - {rule: action-event, id: "act:Order.place", reason: "creation enters the initial state Pending"}
-- risk.yaml --
version: 1
areas:
  - name: order-payment
    tier: critical
    why: "money moves; a double charge cannot be undone"
    ids: ["tc:ORDE-2e883d"]
    questions: [concurrency]
  - name: shipping-permission
    tier: consequential
    why: "authorization: only a Clerk ships"
    ids: ["act:Order.ship", "tc:ORDE-e6d28f"]
  - name: audit
    tier: consequential
    why: "shipments are audited"
    ids: ["tc:ORDE-e6d28f", "inv:paid-before-shipped"]
