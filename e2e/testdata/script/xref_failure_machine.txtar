# a failure mode about a machine as a whole names it: machine:<id>, for any machine of the design,
# bound or not. It resolves, and covers no failure state, failure event or invoke of the machine
# (docs/formats.md sections 5.4 and 6.6)
fixture shop
cp queue.json design/machines/Queue.machine.json

# the subject is well formed and resolves; the failure state, the failure event and the invoke of
# the machines it names still ask for a failure mode of their own
cp whole.yaml design/failure-modes.yaml
exec mrun 1 lint --stage failure-modes --stage xref-failure
stdout '(?s)== failure-modes ==\nchecked: 2 failure modes, 0 abuse cases\npassed\n'
stdout '^checked: 2 failure modes, 1 invokes, 0 dependencies, 0 tiered actions, 1 failure states, 1 failure events$'
stdout '^  ERROR  failure-event-mode: event:queue\.lease_lost: no failure mode names this failure event; '
stdout '^  ERROR  failure-state-mode: state:queue\.Stuck: no failure mode names this failure state; '
stdout '^  ERROR  invoke-failure-mode: invoke:order\.chargePayment: no failure mode names this invoke; '
! stdout 'subject-resolves'
stdout '^failed: 3 finding\(s\)$'

# with those written the stage passes: the machine subjects are linked like any other
cp all.yaml design/failure-modes.yaml
exec machinery lint --stage failure-modes --stage xref-failure
stdout '^checked: 5 failure modes, 1 invokes, 0 dependencies, 0 tiered actions, 1 failure states, 1 failure events$'
stdout '^machinery lint: 2 passed, 0 failed, 0 not demonstrated, 0 not applicable$'

# the id must be a machine of the design
cp ghost.yaml design/failure-modes.yaml
exec mrun 1 lint --stage failure-modes --stage xref-failure
stdout '^  ERROR  subject-resolves: machine:ghost: failure mode ghost-stalls: no machine has the id ghost$'
stdout '^checked: 5 failure modes, 4 linked, 1 unlinked, 1 invokes, '

# an abuse case is about an action or an entity, and the id is required
cp abuse.yaml design/failure-modes.yaml
exec mrun 1 lint --stage failure-modes
stdout '^  ERROR  design/failure-modes.yaml: abuse-queue: kind: abuse needs an act or entity subject$'
stdout '^  ERROR  design/failure-modes.yaml: no-id: subject "machine:" is not invoke:<machine id>\.<src>, dependency:<name>, act:<Entity>\.<action>, entity:<Name>, state:<machine id>\.<State>, event:<machine id>\.<event>, machine:<id> or system:<name>$'
stdout '^failed: 2 finding\(s\)$'

-- queue.json --
{
  "id": "queue",
  "initial": "Idle",
  "_failure_events": ["lease_lost"],
  "states": {
    "Idle": {"on": {"lease_lost": {"target": "Stuck"}}},
    "Stuck": {"tags": "failure", "_terminal": "a stuck queue is restarted by hand"}
  }
}
-- whole.yaml --
version: 1
failure_modes:
  - id: queue-stalls
    subject: machine:queue
    failure: "The queue stops taking work."
    required: surface
    behavior: "The operator sees QUEUE_STALLED."
  - id: order-flow-stalls
    subject: machine:order
    failure: "An order stops moving."
    required: surface
    behavior: "The operator sees ORDER_STALLED."
-- all.yaml --
version: 1
failure_modes:
  - id: queue-stalls
    subject: machine:queue
    failure: "The queue stops taking work."
    required: surface
    behavior: "The operator sees QUEUE_STALLED."
  - id: order-flow-stalls
    subject: machine:order
    failure: "An order stops moving."
    required: surface
    behavior: "The operator sees ORDER_STALLED."
  - id: lease-lost
    subject: event:queue.lease_lost
    failure: "The queue loses its lease."
    required: fail-closed
    behavior: "The queue stops."
  - id: queue-stuck
    subject: state:queue.Stuck
    failure: "The queue is stuck."
    required: surface
    behavior: "The operator sees QUEUE_STUCK."
  - id: payment-provider-down
    subject: invoke:order.chargePayment
    failure: "The payment provider does not answer."
    required: surface
    behavior: "The order returns to Pending."
-- ghost.yaml --
version: 1
failure_modes:
  - id: ghost-stalls
    subject: machine:ghost
    failure: "A queue nobody has stops."
    required: surface
    behavior: "Nothing."
  - id: order-flow-stalls
    subject: machine:order
    failure: "An order stops moving."
    required: surface
    behavior: "The operator sees ORDER_STALLED."
  - id: lease-lost
    subject: event:queue.lease_lost
    failure: "The queue loses its lease."
    required: fail-closed
    behavior: "The queue stops."
  - id: queue-stuck
    subject: state:queue.Stuck
    failure: "The queue is stuck."
    required: surface
    behavior: "The operator sees QUEUE_STUCK."
  - id: payment-provider-down
    subject: invoke:order.chargePayment
    failure: "The payment provider does not answer."
    required: surface
    behavior: "The order returns to Pending."
-- abuse.yaml --
version: 1
failure_modes:
  - id: abuse-queue
    kind: abuse
    subject: machine:queue
    failure: "A caller floods the queue."
    required: refuse
    behavior: "The flood is refused."
  - id: no-id
    subject: "machine:"
    failure: "x"
    required: surface
    behavior: "y"
