# subset conformance: keys, types, names
fixture shop

# root keys that are not in the subset (the v1 annotations are gone)
cp root_keys.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: unsupported root key ''_counters'' \(supported: _comment, _delays, _entries, _external_events, _failure_events, _guards, _lifecycle_of, _oracle_tag, _role, _serves, context, description, id, initial, meta, states, version\)$'
stdout '^  ERROR  design/machines/Order\.machine\.json: unsupported root key ''_io'' \(supported: _comment, _delays, _entries, _external_events, _failure_events, _guards, _lifecycle_of, _oracle_tag, _role, _serves, context, description, id, initial, meta, states, version\)$'
stdout '^  ERROR  design/machines/Order\.machine\.json: unsupported root key ''_invariants'' \(supported: _comment, _delays, _entries, _external_events, _failure_events, _guards, _lifecycle_of, _oracle_tag, _role, _serves, context, description, id, initial, meta, states, version\)$'
stdout '^  ERROR  design/machines/Order\.machine\.json: unsupported root key ''_component'' \(supported: _comment, _delays, _entries, _external_events, _failure_events, _guards, _lifecycle_of, _oracle_tag, _role, _serves, context, description, id, initial, meta, states, version\)$'
stdout '^  ERROR  design/machines/Order\.machine\.json: unsupported root key ''_max_retries'' \(supported: _comment, _delays, _entries, _external_events, _failure_events, _guards, _lifecycle_of, _oracle_tag, _role, _serves, context, description, id, initial, meta, states, version\)$'
stdout '^failed: 5 finding\(s\)$'

# an unknown state key
cp state_key.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: unsupported key ''foo'' in state Paid$'
stdout '^failed: 1 finding\(s\)$'

# parallel states are outside the subset
cp state_type.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: unsupported state type ''parallel'' in Paid \(parallel and history are not in the supported subset\)$'
stdout '^failed: 1 finding\(s\)$'

# a typo in a transition key is an error, not an internal transition
cp typo.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: unsupported key ''tagret'' in transition in Pending on:cancel \(a typo here silently becomes an internal self-transition\)$'
stdout '^failed: 1 finding\(s\)$'

# event names are hashed into case ids
cp event_name.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: state Pending: event name ''cancel-it'' must match \[A-Za-z\]\[A-Za-z0-9_\]\* \(names are hashed into case ids: use letters, digits and underscores\)$'
stdout '^  ERROR  design/machines/Order\.machine\.json: state Paid: event name ''cancel-it'' must match \[A-Za-z\]\[A-Za-z0-9_\]\* \(names are hashed into case ids: use letters, digits and underscores\)$'
stdout '^failed: 2 finding\(s\)$'

# wildcard events are outside the subset
cp wildcard.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: state Pending: event name ''\*'' is outside the supported subset \(wildcard and platform events are not modeled; use explicit events and invoke onDone/onError\)$'
stdout '^  ERROR  design/machines/Order\.machine\.json: state Paid neither handles nor explicitly ignores event ''\*'' \(add it to on: or to _ignores: with a reason\)$'
stdout '^failed: 2 finding\(s\)$'

# state names are hashed into case ids
cp state_name.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: state name ''x-y'' must match \[A-Za-z\]\[A-Za-z0-9_\]\* \(names are hashed into case ids: use letters, digits and underscores\)$'
stdout '^failed: 1 finding\(s\)$'
stdout '^checked: 1 machines, 6 states, 9 transitions$'

# an unknown invoke key
cp invoke_key.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: unsupported invoke key ''foo'' in state paying$'
stdout '^failed: 1 finding\(s\)$'

# array targets (parallel targets) are rejected
cp array_target.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: array transition target \[''Paid''\] in paying invoke\.onDone \(parallel targets are unsupported\)$'
stdout '^failed: 1 finding\(s\)$'

# an action object carries a name only
cp action_object.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: unsupported key ''params'' in action object \{''type'': ''recordCharge'', ''params'': \{\}\} in paying invoke\.onDone \(only ''type'' is supported\)$'
stdout '^failed: 1 finding\(s\)$'

# a null trigger container is malformed, not empty
cp on_container.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: state Paid: ''after'' must be an object, not null or another type$'
stdout '^  ERROR  design/machines/Order\.machine\.json: transition container ''after'' must be an object in Paid$'
stdout '^failed: 2 finding\(s\)$'

# named units are implemented in code, so they are identifiers
cp unit_name.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: action ''record-cancel'' is not a valid identifier \(must match \[A-Za-z_\]\[A-Za-z0-9_\]\*\); rename to camelCase, because named units are implemented in code$'
stdout '^failed: 1 finding\(s\)$'

-- root_keys.json --
{
  "_comment": "Order lifecycle. Domain states mirror the OrderStatus enum; `paying` is the transient overlay around the payment call.",
  "_delays": {
    "payTimeout": "5000 ms - upper bound on the payment provider call"
  },
  "id": "order",
  "initial": "Pending",
  "context": {
    "orderId": null,
    "lastError": null
  },
  "states": {
    "Pending": {
      "on": {
        "pay": [
          {
            "target": "paying",
            "guard": "hasPaymentMethod",
            "actions": "stampAttempt"
          },
          {
            "actions": "recordPayRefused"
          }
        ],
        "cancel": {
          "target": "Cancelled",
          "actions": "recordCancellation"
        }
      },
      "_ignores": {
        "ship": "an unpaid order cannot ship; the API refuses with ORDER_NOT_PAID"
      }
    },
    "paying": {
      "invoke": {
        "src": "chargePayment",
        "onDone": {
          "target": "Paid",
          "actions": "recordCharge"
        },
        "onError": {
          "target": "Pending",
          "actions": "recordPaymentFailure"
        }
      },
      "after": {
        "payTimeout": {
          "target": "Pending",
          "actions": "recordPaymentTimeout"
        }
      }
    },
    "Paid": {
      "on": {
        "ship": {
          "target": "Shipped",
          "actions": "recordShipment"
        },
        "cancel": {
          "target": "Cancelled",
          "actions": [
            "refundPayment",
            "recordCancellation"
          ]
        }
      },
      "_ignores": {
        "pay": "already paid; a repeated pay is refused with ORDER_ALREADY_PAID"
      }
    },
    "Shipped": {
      "type": "final",
      "entry": "notifyCustomer"
    },
    "Cancelled": {
      "type": "final"
    }
  },
  "_counters": {},
  "_io": {},
  "_invariants": [],
  "_component": "x",
  "_max_retries": 3
}
