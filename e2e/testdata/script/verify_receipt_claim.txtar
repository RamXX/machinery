# a receipt counts only when its test lies in a test file that claims its id (section 10.2)
fixture shop
cp markers.yaml machinery.yaml
exec machinery gen
gitinit

# receipts whose test lies in no test file that claims the id do not count, whatever their outcome:
# the owed id stays unproven, the failure is not taken, and owed sync prunes nothing
exec machinery run -- sh -c 'sh e2e/orders.sh && cat refused.jsonl >> "$MACHINERY_RECEIPTS"'
exec mrun 1 verify
# no test file holds the test
stdout '^  ERROR  receipt: tc:ORDE-8bd6e7: TestNowhere does not claim it$'
stdout '^  ERROR  receipt: fm:payment-provider-down: TestNowhere does not claim it$'
# the test file exists and claims other ids
stdout '^  ERROR  receipt: tc:ORDE-8bd6e7: other\.sh does not claim it$'
stdout '^  ERROR  receipt: tc:ORDE-2e883d: other\.sh does not claim it$'
# the file that claims the id is not matched by trace.tests
stdout '^  ERROR  receipt: tc:ORDE-8bd6e7: claims\.sh does not claim it$'
# part of a test name is not the test
stdout '^  ERROR  receipt: tc:ORDE-8bd6e7: TestCharg does not claim it$'
! stdout 'stale owed entry'
! stdout 'ERROR  failed:'
stdout '^checked: 16 obligations, 14 proven, 1 partial, 2 owed, 21 receipts$'
stdout '^failed: 6 finding\(s\)$'
exec machinery owed sync --prune-only
stdout '^owed: 2 kept, 0 added, 0 removed$'

# receipts that count: a test function named in a file that claims the id, a test file named by
# its base name or by its path, and claims made by a project's own markers
rm .machinery/receipts
exec machinery run -- sh -c 'sh e2e/orders.sh && cat counted.jsonl >> "$MACHINERY_RECEIPTS"'
exec mrun 1 verify
! stdout 'does not claim it'
stdout '^  ERROR  stale owed entry: tc:ORDE-8bd6e7 is proven$'
stdout '^  ERROR  failed: inv:terminal-is-final \(other\.sh\)$'
stdout '^  ERROR  failed: inv:paid-before-shipped \(e2e/marked\.sh::late\)$'
stdout '^  ERROR  failed: sc:cancelled-order-refuses-payment \(marked\.sh\)$'
stdout '^failed: 4 finding\(s\)$'
exec machinery owed sync --prune-only
stdout '^owed: 1 kept, 0 added, 1 removed$'

# without trace.tests no file claims anything, so no receipt counts
cp notrace.yaml machinery.yaml
exec git checkout -q design/owed.yaml
gitcommit 'no trace'
exec machinery run -- sh e2e/orders.sh
exec mrun 1 verify
stdout '^  ERROR  receipt: tc:ORDE-2e883d: orders\.sh does not claim it$'
stdout '^checked: 16 obligations, 0 proven, 0 partial, 2 owed, 15 receipts$'

-- refused.jsonl --
{"v":1,"type":"receipt","id":"tc:ORDE-8bd6e7","outcome":"pass","test":"TestNowhere","effects":["recordCharge"],"observed":"paying -> Paid; charge row written"}
{"v":1,"type":"receipt","id":"fm:payment-provider-down","outcome":"skip","test":"TestNowhere","observed":"no outage induced"}
{"v":1,"type":"receipt","id":"tc:ORDE-8bd6e7","outcome":"pass","test":"other.sh","effects":["recordCharge"],"observed":"paying -> Paid; charge row written"}
{"v":1,"type":"receipt","id":"tc:ORDE-2e883d","outcome":"fail","test":"other.sh","observed":"stayed Pending"}
{"v":1,"type":"receipt","id":"tc:ORDE-8bd6e7","outcome":"pass","test":"claims.sh","effects":["recordCharge"],"observed":"paying -> Paid; charge row written"}
{"v":1,"type":"receipt","id":"tc:ORDE-8bd6e7","outcome":"pass","test":"TestCharg","effects":["recordCharge"],"observed":"paying -> Paid; charge row written"}
-- counted.jsonl --
{"v":1,"type":"receipt","id":"tc:ORDE-8bd6e7","outcome":"pass","test":"TestCharge/paid","effects":["recordCharge"],"observed":"paying -> Paid; charge row written"}
{"v":1,"type":"receipt","id":"inv:terminal-is-final","outcome":"fail","test":"other.sh","observed":"a Shipped order was cancelled"}
{"v":1,"type":"receipt","id":"inv:paid-before-shipped","outcome":"fail","test":"e2e/marked.sh::late","observed":"shipped while Pending"}
{"v":1,"type":"receipt","id":"sc:cancelled-order-refuses-payment","outcome":"fail","test":"marked.sh","observed":"the payment was taken"}
-- e2e/other.sh --
#!/bin/sh
# machinery:verifies inv:terminal-is-final
-- e2e/marked.sh --
#!/bin/sh
# Checks: paid-before-shipped
# Scenario: Cancelled order refuses payment
-- e2e/charge_test.go --
package e2e

import "testing"

// machinery:verifies tc:ORDE-8bd6e7
func TestCharge(t *testing.T) {
	t.Run("paid", func(t *testing.T) {})
}
-- tools/claims.sh --
#!/bin/sh
# machinery:verifies tc:ORDE-8bd6e7
-- markers.yaml --
version: 2
design:
  models:
    - design/model/shop.modelith.yaml
  machines: design/machines
  failure_modes: design/failure-modes.yaml
contracts:
  - kind: openapi
    path: contracts/openapi.yaml
trace:
  code: ["internal/**/*.go"]
  tests: ["e2e/**"]
  markers:
    verifies: ["Checks:"]
    scenarios: ["Scenario:"]
constraints:
  layers:
    - {name: domain, paths: ["internal/domain/**"]}
    - {name: api, paths: ["internal/api/**"]}
  size:
    max_file_lines: 200
    max_func_lines: 40
waivers:
  - {rule: action-event, id: "act:Order.place", reason: "creation enters the initial state Pending"}
-- notrace.yaml --
version: 2
design:
  models:
    - design/model/shop.modelith.yaml
  machines: design/machines
  failure_modes: design/failure-modes.yaml
contracts:
  - kind: openapi
    path: contracts/openapi.yaml
constraints:
  layers:
    - {name: domain, paths: ["internal/domain/**"]}
    - {name: api, paths: ["internal/api/**"]}
  size:
    max_file_lines: 200
    max_func_lines: 40
waivers:
  - {rule: action-event, id: "act:Order.place", reason: "creation enters the initial state Pending"}
