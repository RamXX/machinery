# rule failure-event-mode: every _failure_events entry is the subject of a failure mode
exec machinery lint --stage xref-failure
stdout '^checked: 2 failure modes, 0 invokes, 1 dependencies, 0 tiered actions, 0 failure states, 1 failure events$'
stdout '^passed$'

# a failure event no failure mode names
cp no-event-mode.yaml design/failure-modes.yaml
exec mrun 1 lint --stage xref-failure
stdout '^  ERROR  failure-event-mode: event:order\.providerDown: no failure mode names this failure event; declare what the system must do when it arrives in design/failure-modes\.yaml$'
stdout 'failed: 1 finding\(s\)'

# subject-resolves: the machine exists and declares the event in _failure_events
cp unresolved.yaml design/failure-modes.yaml
exec mrun 1 lint --stage xref-failure
stdout 'ERROR  subject-resolves: event:ghost\.providerDown: failure mode a-ghost-machine: no machine has the id ghost'
stdout 'ERROR  subject-resolves: event:order\.pay: failure mode b-not-failure: pay is not in the _failure_events of machine order'
stdout 'failed: 2 finding\(s\)'

# once the failure mode is written, the waiver that covered its absence is stale: the list only shrinks
cp design/failure-modes.yaml.orig design/failure-modes.yaml
cp waived.yaml machinery.yaml
exec mrun 1 lint --stage xref-failure
stdout '^  ERROR  stale waiver: failure-event-mode event:order\.providerDown$'
stdout 'failed: 1 finding\(s\)'

-- machinery.yaml --
version: 2
design:
  models:
    - design/model/mini.modelith.yaml
  machines: design/machines
  failure_modes: design/failure-modes.yaml
dependencies:
  - {name: postgres, posture: real}
-- design/model/mini.modelith.yaml --
kind: DomainModel
version: v1
title: Mini
enums:
  Status:
    values:
      - {name: Pending, definition: "Placed."}
      - {name: Paid, definition: "Paid."}
      - {name: Cancelled, definition: "Dropped."}
entities:
  Order:
    definition: "An order."
    attributes:
      - {name: status, type: Status}
    actions:
      - {name: pay, actor: Customer}
      - {name: cancel, actor: Customer}
-- design/machines/Order.machine.json --
{
  "id": "order",
  "initial": "Pending",
  "_failure_events": [
    "providerDown"
  ],
  "states": {
    "Pending": {
      "on": {
        "pay": {
          "target": "Paid"
        },
        "cancel": {
          "target": "Cancelled"
        },
        "providerDown": {
          "target": "Pending"
        }
      }
    },
    "Paid": {
      "type": "final"
    },
    "Cancelled": {
      "type": "final"
    }
  }
}
-- design/failure-modes.yaml --
version: 1
failure_modes:
  - id: database-down
    subject: dependency:postgres
    failure: "It fails."
    required: fail-closed
    behavior: "The caller is told."
  - id: provider-down
    subject: event:order.providerDown
    failure: "It fails."
    required: fail-closed
    behavior: "The caller is told."
-- design/failure-modes.yaml.orig --
version: 1
failure_modes:
  - id: database-down
    subject: dependency:postgres
    failure: "It fails."
    required: fail-closed
    behavior: "The caller is told."
  - id: provider-down
    subject: event:order.providerDown
    failure: "It fails."
    required: fail-closed
    behavior: "The caller is told."
-- no-event-mode.yaml --
version: 1
failure_modes:
  - id: database-down
    subject: dependency:postgres
    failure: "It fails."
    required: fail-closed
    behavior: "The caller is told."
-- unresolved.yaml --
version: 1
failure_modes:
  - id: database-down
    subject: dependency:postgres
    failure: "It fails."
    required: fail-closed
    behavior: "The caller is told."
  - id: provider-down
    subject: event:order.providerDown
    failure: "It fails."
    required: fail-closed
    behavior: "The caller is told."
  - id: a-ghost-machine
    subject: event:ghost.providerDown
    failure: "It fails."
    required: surface
    behavior: "The caller is told."
  - id: b-not-failure
    subject: event:order.pay
    failure: "It fails."
    required: surface
    behavior: "The caller is told."
-- waived.yaml --
version: 2
design:
  models:
    - design/model/mini.modelith.yaml
  machines: design/machines
  failure_modes: design/failure-modes.yaml
dependencies:
  - {name: postgres, posture: real}
waivers:
  - {rule: failure-event-mode, id: "event:order.providerDown", reason: "unmodeled at adoption (0000000)"}
