-- always.json --
{
  "id": "order",
  "_refusal_events": {
    "cancel_failed": {
      "action": "cancel",
      "reason": "the command was refused, nothing failed"
    }
  },
  "initial": "Pending",
  "states": {
    "Pending": {
      "on": {
        "pay": {
          "target": "Paid"
        },
        "cancel": {
          "target": "Cancelled"
        }
      }
    },
    "Paid": {
      "on": {
        "cancel_failed": {
          "target": "settling"
        }
      }
    },
    "settling": {
      "always": [
        {
          "target": "checking",
          "guard": "isLate"
        },
        {
          "target": "Paid"
        }
      ]
    },
    "checking": {
      "always": {
        "target": "broken"
      }
    },
    "broken": {
      "tags": "failure",
      "on": {
        "cancel": {
          "target": "Cancelled"
        }
      }
    },
    "Cancelled": {
      "type": "final"
    }
  }
}
-- done.json --
{
  "id": "order",
  "_refusal_events": {
    "cancel_failed": {
      "action": "cancel",
      "reason": "the command was refused, nothing failed"
    }
  },
  "initial": "Pending",
  "states": {
    "Pending": {
      "on": {
        "pay": {
          "target": "Paid"
        },
        "cancel": {
          "target": "Cancelled"
        }
      }
    },
    "Paid": {
      "on": {
        "cancel_failed": {
          "target": "closing"
        }
      }
    },
    "closing": {
      "initial": "ended",
      "states": {
        "ended": {
          "type": "final"
        }
      },
      "onDone": {
        "target": "broken"
      }
    },
    "broken": {
      "tags": "failure",
      "on": {
        "cancel": {
          "target": "Cancelled"
        }
      }
    },
    "Cancelled": {
      "type": "final"
    }
  }
}
