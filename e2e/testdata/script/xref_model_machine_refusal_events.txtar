-- envelope.json --
{
  "id": "envelope",
  "_role": "operational",
  "_serves": [
    "act:Order.pay"
  ],
  "_refusal_events": {
    "pay_refused": {"action": "pay", "reason": "the command was refused, nothing failed"}
  },
  "initial": "idle",
  "states": {
    "idle": {
      "on": {
        "pay": {
          "target": "busy"
        }
      }
    },
    "busy": {
      "on": {
        "pay_refused": {
          "target": "idle"
        }
      }
    }
  }
}
