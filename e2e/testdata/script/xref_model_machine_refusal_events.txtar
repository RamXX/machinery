-- self-then-always.json --
{
  "id": "order",
  "_refusal_events": {
    "cancel_refused": {"action": "cancel", "reason": "the command was refused, nothing failed"}
  },
  "_failure_events": ["provider_down"],
  "initial": "Pending",
  "states": {
    "Pending": {
      "on": {
        "pay": {"target": "Paid"},
        "cancel": {"target": "Cancelled"}
      }
    },
    "Paid": {
      "on": {
        "cancel_refused": {"actions": "recordRefusal"},
        "provider_down": {"target": "broken"}
      }
    },
    "broken": {
      "tags": "failure",
      "always": {"target": "stuck", "guard": "isStale"},
      "on": {
        "cancel_refused": {"target": "broken"},
        "cancel": {"target": "Cancelled"}
      }
    },
    "stuck": {
      "tags": "failure",
      "on": {
        "cancel": {"target": "Cancelled"}
      }
    },
    "Cancelled": {
      "type": "final"
    }
  }
}
-- nested-failure.json --
{
  "id": "order",
  "_refusal_events": {
    "cancel_refused": {"action": "cancel", "reason": "the command was refused, nothing failed"}
  },
  "_failure_events": ["provider_down"],
  "initial": "Pending",
  "states": {
    "Pending": {
      "on": {
        "pay": {"target": "Paid"},
        "cancel": {"target": "Cancelled"}
      }
    },
    "Paid": {
      "on": {
        "cancel_refused": {"actions": "recordRefusal"},
        "provider_down": {"target": "held"}
      }
    },
    "held": {
      "tags": "failure",
      "initial": "waiting",
      "on": {
        "cancel": {"target": "Cancelled"}
      },
      "states": {
        "waiting": {
          "on": {
            "cancel_refused": {"target": "#order.held.stuck"}
          }
        },
        "stuck": {
          "tags": "failure"
        }
      }
    },
    "Cancelled": {
      "type": "final"
    }
  }
}
