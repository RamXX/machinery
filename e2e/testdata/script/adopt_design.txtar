# a team models its riskiest stateful resource: adopt picks the design up, runs gen and owes every id
fixture brownfield
gitinit
exec sh backlog.sh
exec machinery adopt --paths 'internal/shipping/**' --write
gitcommit adopted

# the design arrives later, with a waiver for the action that creates the shipment
fixture brownfield-design
exec sh -c 'cat waiver.yaml >> machinery.yaml'
# one action is already served by code
exec sh -c 'echo "// machinery:serves act:Shipment.pack" >> internal/shipping/shipment.go'

# the dry run reports the design and writes nothing
exec machinery adopt --paths 'internal/shipping/**'
stdout '^design: 1 model\(s\), 1 machine\(s\), 0 contract\(s\)$'
stdout '^  design/owed.yaml  new owed entries: 20$'
stdout '^  design/gen/tables/shipment.table.json  generated by machinery gen$'
stdout '^  design/model/depot.modelith.md  generated by machinery gen$'
stdout '^  machinery.yaml  edit: design.models \+design/model/depot.modelith.yaml; design.machines \+design/machines; trace.code \+internal/shipping/\*\*; trace.tests \+e2e/\*\*$'
! stdout '^== '
! exists design/owed.yaml
! exists design/model/depot.modelith.md

# --write adds the model and machines to the config, runs gen, and owes what is not proven
exec machinery adopt --paths 'internal/shipping/**' --write
cmp stdout want-wrote.txt
grep 'design/model/depot.modelith.yaml' machinery.yaml
grep 'machines: design/machines' machinery.yaml
grep 'code: \["internal/shipping/\*\*"\]' machinery.yaml
grep 'tests: \["e2e/\*\*"\]' machinery.yaml
grep 'tool: bd' machinery.yaml
exists design/gen/tables/shipment.table.json
exists design/model/depot.modelith.md

# 16 obligations (12 cases, 2 invariants, 2 scenarios) and 4 unserved act ids, none for act:Shipment.pack
grep -count=20 '^  - id: ' design/owed.yaml
grep -count=20 'reason: "unproven at adoption \([0-9a-f]{7}\)"' design/owed.yaml
grep -count=12 '^  - id: tc:SHIP-' design/owed.yaml
grep -count=2 '^  - id: inv:' design/owed.yaml
grep -count=2 '^  - id: sc:' design/owed.yaml
grep 'id: act:Shipment.create' design/owed.yaml
grep 'id: act:Shipment.cancel' design/owed.yaml
grep 'id: act:Shipment.deliver' design/owed.yaml
grep 'id: act:Shipment.dispatch' design/owed.yaml
! grep 'id: act:Shipment.pack' design/owed.yaml

# the existing code, tests and backlog are untouched; only the tag line was added by this script
exec git status --short
stdout '^ M machinery.yaml$'
stdout '^ M internal/shipping/shipment.go$'
! stdout 'internal/billing'
! stdout 'cmd/'

# machinery check passes: what exists is baselined or owed
exec mrun 0 check --stage model --stage machines --stage failure-modes --stage risk --stage xref-model-machine --stage xref-contract --stage xref-failure --stage xstate --stage gen-drift --stage formal --stage checkers --stage arch --stage tests --stage trace
stdout 'checked: 3 code files, 1 test files, 5 act ids, 16 obligations'
stdout '^passed$'

# a second run writes nothing
exec machinery adopt --paths 'internal/shipping/**' --write
cmp stdout want-wrote-nothing.txt

# a reason edited by hand is kept, and what the design adds later is owed under the new commit
exec sh -c 'sed "s/unproven at adoption/kept by hand/" design/owed.yaml > owed.tmp && mv owed.tmp design/owed.yaml'
exec sh -c 'cat scenario.yaml >> design/model/depot.modelith.yaml'
gitcommit design
exec machinery adopt --paths 'internal/shipping/**' --write
stdout '^  design/owed.yaml$'
grep -count=20 'reason: "kept by hand \([0-9a-f]{7}\)"' design/owed.yaml
grep -count=1 'reason: "unproven at adoption \([0-9a-f]{7}\)"' design/owed.yaml
grep -count=1 'id: sc:shipment-is-lost' design/owed.yaml
exec mrun 0 check --stage model --stage machines --stage failure-modes --stage risk --stage xref-model-machine --stage xref-contract --stage xref-failure --stage xstate --stage gen-drift --stage formal --stage checkers --stage arch --stage tests --stage trace

# a run with nothing new writes nothing
exec machinery adopt --paths 'internal/shipping/**' --write
cmp stdout want-wrote-nothing.txt

-- waiver.yaml --
waivers:
  - {rule: action-event, id: "act:Shipment.create", reason: "creation enters the initial state Created"}
-- scenario.yaml --
  - name: Shipment is lost
    actors: [Warehouse]
    steps:
      - "Warehouse creates a `Shipment`; it is created."
      - "Warehouse cancels it; the `Shipment` is cancelled."
    invariants_touched: [terminal-is-final]
-- want-wrote.txt --
adopt: wrote 6 file(s)
  design/gen/obligations.json
  design/gen/tables/shipment.table.json
  design/gen/tables/shipment.table.md
  design/model/depot.modelith.md
  design/owed.yaml
  machinery.yaml
-- want-wrote-nothing.txt --
adopt: wrote 0 file(s)
