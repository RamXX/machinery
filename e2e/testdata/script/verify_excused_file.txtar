# entries of evidence.adapter.excused may live in design/excused.yaml, a file the tool reads:
# they are merged with those of machinery.yaml and named by their file. A change of that file
# keeps the runs valid, a change of machinery.yaml voids them as before (sections 2.2, 10.1,
# 10.3 and 11.3)
fixture shop
fixture shop-gotests
cp one-entry.yaml machinery.yaml
exec machinery gen
gitinit
exec git tag defaults
cp excused-file.yaml design/excused.yaml
gitcommit 'excuse a second shop and the provider sandbox in the excused file'

exec machinery run --adapter go-test-json -- go test -tags faults -count=1 ./e2e/suite
exec mrun 1 verify
stdout '^  warn   adapter excused: entry 1: 2 claimant\(s\) of 2 id\(s\), 1 glob\(s\): the cluster tests need three nodes; they run in the nightly job$'
stdout '^  warn   adapter excused: design/excused\.yaml: entry 1: 1 claimant\(s\) of 1 id\(s\), 1 glob\(s\), 1 function pattern\(s\): needs a second shop instance$'
stdout '^  warn   adapter excused: design/excused\.yaml: entry 2: 1 claimant\(s\) of 1 id\(s\), 1 glob\(s\): the provider sandbox is unreachable from CI$'
stdout '^  warn   excused: inv:paid-before-shipped: proven \(2 claimant\(s\) excused\)$'
stdout '^  warn   no claimant can run here: fm:payment-provider-down: 1 claimant\(s\) excused: run a claimant of it here and narrow design/excused\.yaml, or prove it with a receipt a test emits$'
exec mrun 1 verify --partly
stdout '^  warn   adapter excused: design/excused\.yaml: entry 1 \(tests e2e/extra/\*_test\.go; functions TestShip\*\): 1 claimant\(s\) of 1 id\(s\), 1 glob\(s\), 1 function pattern\(s\): needs a second shop instance$'

# a change of the excused file keeps the run valid: the entries are judged as they are now
cp excused-reworded.yaml design/excused.yaml
gitcommit 'reword a reason in the excused file'
exec mrun 1 verify
stdout 'valid at HEAD through 1 exempt commit\(s\)$'
stdout '^  warn   adapter excused: design/excused\.yaml: entry 2: 1 claimant\(s\) of 1 id\(s\), 1 glob\(s\): the provider sandbox answers only inside the office network$'
! stdout 'unreachable from CI'

# a glob of the file that covers no claimant is an ERROR that names the file
cp excused-nothing.yaml design/excused.yaml
exec mrun 1 verify --allow-dirty
stdout '^  ERROR  adapter excused: design/excused\.yaml: entry 3: tests "e2e/nowhere/\*_test\.go" covers no claimant: correct the glob or remove it$'
exec git checkout -q design/excused.yaml

# the same entries moved into machinery.yaml: a change of machinery.yaml voids the run
exec git tag in-file
cp all-entries.yaml machinery.yaml
rm design/excused.yaml
gitcommit 'the entries move into machinery.yaml'
exec mrun 1 verify
stdout '^not demonstrated: no evidence at [0-9a-f]{7}$'
exec git checkout -q in-file -- machinery.yaml design/excused.yaml
gitcommit 'the entries move back'

# the file: version 1, the key excused, entries as in machinery.yaml, one document
cp bad-key.yaml design/excused.yaml
exec mrun 2 config
stderr '^config: design/excused\.yaml: line 3: field because not found in type project\.ExcusedFile$'
cp bad-entry-key.yaml design/excused.yaml
exec mrun 2 config
stderr '^config: design/excused\.yaml: line 5: field because not found in type project\.AdapterExcused$'
cp bad-version.yaml design/excused.yaml
exec mrun 2 config
stderr '^config: design/excused\.yaml: version must be 1$'
cp two-docs.yaml design/excused.yaml
exec mrun 2 config
stderr '^config: design/excused\.yaml: the file holds more than one YAML document$'
cp no-reason.yaml design/excused.yaml
exec mrun 2 config
stderr '^config: design/excused\.yaml: entry 1: reason is required: say why these tests cannot run here$'
cp no-tests.yaml design/excused.yaml
exec mrun 2 config
stderr '^config: design/excused\.yaml: entry 1: tests is required: globs of files under trace\.tests$'
cp bad-functions.yaml design/excused.yaml
exec mrun 2 config
stderr '^config: design/excused\.yaml: entry 1: functions "Test\[" is not a valid pattern$'
cp outside.yaml design/excused.yaml
exec mrun 2 config
stderr '^config: design/excused\.yaml: entry 1: tests: "\.\./cluster/\*_test\.go" must stay inside the project root$'
exec git checkout -q design/excused.yaml

# the ratchet names an entry of the file added since the base by its file
exec machinery check --stage ratchet --base defaults
stdout '^  warn   ratchet: adapter widened: design/excused\.yaml: entry 1 added: tests e2e/extra/\*_test\.go, functions TestShip\*: needs a second shop instance$'
stdout '^  warn   ratchet: adapter widened: design/excused\.yaml: entry 2 added: tests e2e/suite/outage_test\.go: the provider sandbox answers only inside the office network$'
! stdout 'evidence\.adapter\.excused: entry 1'
stdout '^passed$'

# the advice of a partly run id names where excused entries go: the excused file, as the project has one
exec machinery run --adapter go-test-json -- go test -tags faults -count=1 ./e2e/suite
cp excused-outage-only.yaml design/excused.yaml
gitcommit 'the second shop is no longer excused'
exec mrun 1 verify
stdout '^  ERROR  partly run: inv:paid-before-shipped: 1 of 2 claimants passed \(1 claimant\(s\) excused\): run the claimants without a pass at this commit, or excuse those that cannot run here in design/excused\.yaml$'

-- e2e/cluster/cluster_test.go --
package cluster

import "testing"

// TestClusterShip needs three nodes.
//
// machinery:verifies inv:paid-before-shipped
func TestClusterShip(t *testing.T) {}

// TestClusterFailover needs three nodes.
//
// machinery:verifies inv:terminal-is-final
func TestClusterFailover(t *testing.T) {}
-- e2e/extra/extra_test.go --
package extra

import "testing"

// TestShipAgain needs a second shop instance.
//
// machinery:verifies inv:paid-before-shipped
func TestShipAgain(t *testing.T) {}
-- excused-file.yaml --
version: 1
excused:
  - tests: ["e2e/extra/*_test.go"]
    functions: ["TestShip*"]
    reason: "needs a second shop instance"
  - tests: ["e2e/suite/outage_test.go"]
    reason: "the provider sandbox is unreachable from CI"
-- excused-outage-only.yaml --
version: 1
excused:
  - tests: ["e2e/suite/outage_test.go"]
    reason: "the provider sandbox answers only inside the office network"
-- excused-reworded.yaml --
version: 1
excused:
  - tests: ["e2e/extra/*_test.go"]
    functions: ["TestShip*"]
    reason: "needs a second shop instance"
  - tests: ["e2e/suite/outage_test.go"]
    reason: "the provider sandbox answers only inside the office network"
-- excused-nothing.yaml --
version: 1
excused:
  - tests: ["e2e/extra/*_test.go"]
    functions: ["TestShip*"]
    reason: "needs a second shop instance"
  - tests: ["e2e/suite/outage_test.go"]
    reason: "the provider sandbox answers only inside the office network"
  - tests: ["e2e/nowhere/*_test.go"]
    reason: "nothing is there"
-- bad-key.yaml --
version: 1
excused: []
because: "a key the file does not have"
-- bad-entry-key.yaml --
version: 1
excused:
  - tests: ["e2e/extra/*_test.go"]
    reason: "needs a second shop instance"
    because: "a key an entry does not have"
-- bad-version.yaml --
version: 2
excused: []
-- two-docs.yaml --
version: 1
excused: []
---
version: 1
-- no-reason.yaml --
version: 1
excused:
  - tests: ["e2e/extra/*_test.go"]
-- no-tests.yaml --
version: 1
excused:
  - reason: "nightly only"
-- bad-functions.yaml --
version: 1
excused:
  - tests: ["e2e/extra/*_test.go"]
    functions: ["Test["]
    reason: "nightly only"
-- outside.yaml --
version: 1
excused:
  - tests: ["../cluster/*_test.go"]
    reason: "nightly only"
-- one-entry.yaml --
version: 2
design:
  models:
    - design/model/shop.modelith.yaml
  machines: design/machines
  failure_modes: design/failure-modes.yaml
backlog:
  tool: bd
contracts:
  - kind: openapi
    path: contracts/openapi.yaml
trace:
  code: ["internal/**/*.go"]
  tests: ["e2e/**"]
evidence:
  adapter:
    excused:
      - tests: ["e2e/cluster/*_test.go"]
        reason: "the cluster tests need three nodes; they run in the nightly job"
constraints:
  layers:
    - {name: domain, paths: ["internal/domain/**"]}
    - {name: api, paths: ["internal/api/**"]}
  size:
    max_file_lines: 200
    max_func_lines: 40
waivers:
  - {rule: action-event, id: "act:Order.place", reason: "creation enters the initial state Pending"}
-- all-entries.yaml --
version: 2
design:
  models:
    - design/model/shop.modelith.yaml
  machines: design/machines
  failure_modes: design/failure-modes.yaml
backlog:
  tool: bd
contracts:
  - kind: openapi
    path: contracts/openapi.yaml
trace:
  code: ["internal/**/*.go"]
  tests: ["e2e/**"]
evidence:
  adapter:
    excused:
      - tests: ["e2e/cluster/*_test.go"]
        reason: "the cluster tests need three nodes; they run in the nightly job"
      - tests: ["e2e/extra/*_test.go"]
        functions: ["TestShip*"]
        reason: "needs a second shop instance"
      - tests: ["e2e/suite/outage_test.go"]
        reason: "the provider sandbox is unreachable from CI"
constraints:
  layers:
    - {name: domain, paths: ["internal/domain/**"]}
    - {name: api, paths: ["internal/api/**"]}
  size:
    max_file_lines: 200
    max_func_lines: 40
waivers:
  - {rule: action-event, id: "act:Order.place", reason: "creation enters the initial state Pending"}
