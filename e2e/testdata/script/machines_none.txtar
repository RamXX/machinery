# nothing configured is not applicable; configured but empty is not demonstrated
mkdir design
cp no_machines.yaml machinery.yaml
exec machinery lint --stage machines
stdout '^== machines ==$'
stdout '^not applicable: no design.machines configured$'
! stdout 'checked:'
stdout 'machinery lint: 0 passed, 0 failed, 0 not demonstrated, 1 not applicable'

# a directory with no machine file proves nothing
cp machines.yaml machinery.yaml
mkdir design/machines
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^checked: 0 machines, 0 states, 0 transitions$'
stdout '^not demonstrated: nothing to check$'
stdout 'machinery lint: 0 passed, 0 failed, 1 not demonstrated, 0 not applicable'

# a file that is not a machine is an error, and does not hide the others
cp broken.txt design/machines/Broken.machine.json
exec mrun 1 lint --stage machines
stdout '^  ERROR  design/machines/Broken.machine.json: '
stdout '^failed: 1 finding\(s\)$'

# a machine file that is not an object
cp array.txt design/machines/Broken.machine.json
exec mrun 1 lint --stage machines
stdout '^  ERROR  design/machines/Broken.machine.json: '

-- no_machines.yaml --
version: 2
-- machines.yaml --
version: 2
design:
  machines: design/machines
-- broken.txt --
{"id": "broken", "states": 
-- array.txt --
[]
