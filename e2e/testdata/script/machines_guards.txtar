# _guards: declared clauses of a guard
fixture shop

# a guard with two clauses
cp ok.json design/machines/Order.machine.json
exec machinery lint --stage machines
stdout '^checked: 1 machines, 5 states, 8 transitions$'
stdout '^passed$'

# a key that is not a guard the machine uses
cp unused.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: _guards declares ''nosuchGuard'' but no transition uses that guard; drop the entry or fix the name$'
stdout '^failed: 1 finding\(s\)$'

# at least two clauses
cp one.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: _guards\[''hasPaymentMethod''\] lists 1 clause\(s\); a guard needs at least two \(a guard with one check has nothing to separate\)$'
stdout '^failed: 1 finding\(s\)$'

# clause names match ^[a-z][A-Za-z0-9]*$
cp pattern.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: _guards\[''hasPaymentMethod''\] clause ''card_on_file'' must be a string matching \^\[a-z\]\[A-Za-z0-9\]\*\$$'
stdout '^  ERROR  design/machines/Order\.machine\.json: _guards\[''hasPaymentMethod''\] clause ''CardNotExpired'' must be a string matching \^\[a-z\]\[A-Za-z0-9\]\*\$$'
stdout '^failed: 2 finding\(s\)$'

# no duplicate clauses
cp dup.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: _guards\[''hasPaymentMethod''\] lists clause ''cardOnFile'' twice$'
stdout '^failed: 1 finding\(s\)$'

# the value is a list
cp not_list.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: _guards\[''hasPaymentMethod''\] must be a list of clause names$'
stdout '^failed: 1 finding\(s\)$'

# _guards is an object
cp not_object.json design/machines/Order.machine.json
exec mrun 1 lint --stage machines
stdout '^== machines ==$'
stdout '^  ERROR  design/machines/Order\.machine\.json: _guards must be an object mapping a guard name to the list of its clause names$'
stdout '^failed: 1 finding\(s\)$'

-- ok.json --
{
  "_comment": "Order lifecycle. Domain states mirror the OrderStatus enum; `paying` is the transient overlay around the payment call.",
  "_delays": {
    "payTimeout": "5000 ms - upper bound on the payment provider call"
  },
  "id": "order",
  "initial": "Pending",
  "context": {
    "orderId": null,
    "lastError": null
  },
  "states": {
    "Pending": {
      "on": {
        "pay": [
          {
            "target": "paying",
            "guard": "hasPaymentMethod",
            "actions": "stampAttempt"
          },
          {
            "actions": "recordPayRefused"
          }
        ],
        "cancel": {
          "target": "Cancelled",
          "actions": "recordCancellation"
        }
      },
      "_ignores": {
        "ship": "an unpaid order cannot ship; the API refuses with ORDER_NOT_PAID"
      }
    },
    "paying": {
      "invoke": {
        "src": "chargePayment",
        "onDone": {
          "target": "Paid",
          "actions": "recordCharge"
        },
        "onError": {
          "target": "Pending",
          "actions": "recordPaymentFailure"
        }
      },
      "after": {
        "payTimeout": {
          "target": "Pending",
          "actions": "recordPaymentTimeout"
        }
      }
    },
    "Paid": {
      "on": {
        "ship": {
          "target": "Shipped",
          "actions": "recordShipment"
        },
        "cancel": {
          "target": "Cancelled",
          "actions": [
            "refundPayment",
            "recordCancellation"
          ]
        }
      },
      "_ignores": {
        "pay": "already paid; a repeated pay is refused with ORDER_ALREADY_PAID"
      }
    },
    "Shipped": {
      "type": "final",
      "entry": "notifyCustomer"
    },
    "Cancelled": {
      "type": "final"
    }
  },
  "_guards": {
    "hasPaymentMethod": [
      "cardOnFile",
      "cardNotExpired"
    ]
  }
}
